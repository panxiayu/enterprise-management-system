.page {
  min-height: 100vh;
  padding: 20rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.state {
  padding: 120rpx 0;
  text-align: center;
  color: #75879a;
}

.card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #213b58;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7f90a2;
}

.status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status.active {
  background: #e9f7ef;
  color: #0e9f6e;
}

.status.expired {
  background: #f9ecec;
  color: #d25858;
}

.section {
  margin-top: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.row:first-child {
  border-top: 0;
}

.row-main {
  flex: 1;
  padding-right: 24rpx;
}

.row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #233e5b;
}

.row-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8192a3;
}

.submit {
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #2f8fff 0%, #1667d9 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
