.page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  background:
    radial-gradient(circle at top right, #d9ecff 0, transparent 32%),
    linear-gradient(180deg, #f6fbff 0%, #eef5fb 100%);
  box-sizing: border-box;
}

.hero {
  padding: 34rpx 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #1f6fd0 0%, #4097f0 100%);
  color: #fff;
  box-shadow: 0 18rpx 48rpx rgba(36, 103, 178, 0.2);
}

.hello {
  font-size: 42rpx;
  font-weight: 800;
}

.meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.sync-pill {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
}

.sync-pill-loading {
  background: rgba(255, 255, 255, 0.2);
}

.sync-pill-success {
  background: rgba(34, 197, 141, 0.22);
}

.sync-pill-error {
  background: rgba(255, 59, 48, 0.22);
}

.section {
  margin-top: 26rpx;
}

.title {
  margin: 0 8rpx 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #365575;
}

.grid {
  display: grid;
  gap: 16rpx;
}

.card {
  padding: 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(58, 99, 145, 0.08);
}

.card.primary {
  background: linear-gradient(160deg, #ffffff 0%, #f0f7ff 100%);
  border: 2rpx solid #d7e9ff;
}

.card.danger {
  background: #fff7f7;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #203956;
}

.card-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6f8399;
}

.sub-grid {
  display: grid;
  gap: 16rpx;
}

.sub-card {
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(58, 99, 145, 0.08);
  text-align: left;
  line-height: 1.4;
}

.sub-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #203956;
}

.sub-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6f8399;
}
