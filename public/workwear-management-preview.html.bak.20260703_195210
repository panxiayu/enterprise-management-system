    async function verifyStaffIdentity(target) {
      const prefix = target === 'quick' ? 'form' : 'drawer';
      const employeeId = document.getElementById(`${prefix}EmployeeId`).value.trim();
      const name = document.getElementById(`${prefix}StaffNameInput`).value.trim();

