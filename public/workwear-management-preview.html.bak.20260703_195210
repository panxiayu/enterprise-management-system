    function getMonthRange(offset = 0) {
      const now = new Date();
      const date = new Date(now.getFullYear(), now.getMonth() + offset, 1);
      const start = formatDateValue(date.getFullYear(), date.getMonth(), 1);
      const endDate = new Date(date.getFullYear(), date.getMonth() + 1, 0);
      const end = formatDateValue(endDate.getFullYear(), endDate.getMonth(), endDate.getDate());
      return { start, end };
    }

