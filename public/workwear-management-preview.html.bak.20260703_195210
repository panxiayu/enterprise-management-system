    async function handleListSearchLookup() {
      const searchInput = document.getElementById('searchInput');
      const keyword = searchInput.value.trim();
      const isPinyinInitials = /^[a-z]{1,3}$/i.test(keyword);
      const isAsciiKeyword = /^[a-z0-9]+$/i.test(keyword);
      const hasChinese = /[\u4e00-\u9fa5]/.test(keyword);
      const isPureDigits = /^\d+$/.test(keyword);
      const isPureLetters = /^[a-z]+$/i.test(keyword);
      const isExactModelKeyword = /^(?:\d{1,3}(?:码)?|xs|s|m|l|xl|2xl|3xl|4xl|5xl)$/i.test(keyword);
      const shouldSuggestStaff = hasChinese || !isAsciiKeyword || isExactModelKeyword || (isPureDigits && keyword.length >= 3) || (isPureLetters && keyword.length >= 2);
      if (!keyword) {
        hideStaffSuggestions('list-search');
        return;
      }
      if (!shouldSuggestStaff) {
        hideStaffSuggestions('list-search');
        applyFilters();
        return;
      }
      try {
        const res = await fetch(`/api/auth/search-staff?keyword=${encodeURIComponent(keyword)}`, {
          headers: getAuthHeaders()
        });
        const data = await res.json();
        const matches = Array.isArray(data.data)
          ? data.data.filter((item) => {
              if (item.type !== '员工') return false;
              const staffName = String(item.name || '').trim();
              const employeeId = String(item.employee_id || '').trim();
              const namePinyin = String(item.name_pinyin || '').trim().toLowerCase();
              return (
                staffName.includes(keyword) ||
                employeeId.includes(keyword) ||
                (isPinyinInitials && namePinyin.startsWith(keyword.toLowerCase()))
              );
            })
          : [];
        const normalizedKeyword = keyword.toLowerCase();
        const categorySeen = new Set();
        const modelSeen = new Set();
        const baseItems = getNormalizedBaseItems();
        const categoryMatches = [];
        const modelMatches = [];
        const specialMatches = [];

        if ('zg'.includes(normalizedKeyword) || '自购'.includes(keyword)) {
          specialMatches.push({
            suggest_type: 'self_purchase',
            keyword: '自购',
            display_name: 'ZG',
            meta: ''
          });
        }

        if ('lz'.includes(normalizedKeyword) || '离职'.includes(keyword)) {
          specialMatches.push({
            suggest_type: 'leave',
            keyword: '离职',
            display_name: '离职',
            meta: ''
          });
        }

        baseItems.forEach((item) => {
          const category = String(item.category || '').trim();
          const model = String(item.model || '').trim();
          if (category && category.toLowerCase().includes(normalizedKeyword) && !categorySeen.has(category)) {
            categorySeen.add(category);
            categoryMatches.push({
              suggest_type: 'category',
              keyword: category,
              display_name: category,
              meta: '按类别搜索'
            });
          }
          if (model && model !== '-' && model.toLowerCase().includes(normalizedKeyword) && !modelSeen.has(model)) {
            modelSeen.add(model);
            modelMatches.push({
              suggest_type: 'model',
              keyword: model,
              display_name: model,
              meta: '按型号搜索'
            });
          }
        });

        const staffMatches = matches.map((item) => ({
          ...item,
          suggest_type: 'staff',
          display_name: [item.name || '', item.employee_id || ''].filter(Boolean).join(' ')
        }));

        const listSuggestions = isExactModelKeyword
          ? [...modelMatches, ...categoryMatches, ...specialMatches, ...staffMatches]
          : ((isPureLetters && keyword.length <= 2)
            ? [...specialMatches, ...modelMatches, ...categoryMatches, ...staffMatches]
            : [...staffMatches, ...specialMatches, ...categoryMatches, ...modelMatches]);

        if (listSuggestions.length) {
          showStaffSuggestions('list-search', listSuggestions);
        } else {
          hideStaffSuggestions('list-search');
        }
      } catch (err) {
        hideStaffSuggestions('list-search');
      }
    }

    async function handleStaffNameLookup(target) {
      const prefix = target === 'quick' ? 'form' : 'drawer';
      const employeeInput = document.getElementById(`${prefix}EmployeeId`);
      const nameInput = document.getElementById(`${prefix}StaffNameInput`);
      const name = nameInput.value.trim();
      const employeeId = employeeInput.value.trim();
      const isPinyinInitials = /^[a-z]{1,3}$/i.test(name);

      if (!name) {
        hideStaffSuggestions(target);
        return;
      }
      if (employeeId) {
        hideStaffSuggestions(target);
        verifyStaffIdentity(target);
        return;
      }

      const lookupSeq = ++staffMatchState[target].lookupSeq;

      try {
        const res = await fetch(`/api/auth/search-staff?keyword=${encodeURIComponent(name)}`, {
          headers: getAuthHeaders()
        });
        const data = await res.json();
        if (lookupSeq !== staffMatchState[target].lookupSeq) return;

        const exactMatches = Array.isArray(data.data)
          ? data.data.filter((item) => {
              if (item.type !== '员工') return false;
              const staffName = String(item.name || '').trim();
              const namePinyin = String(item.name_pinyin || '').trim().toLowerCase();
              if (staffName === name) return true;
              if (isPinyinInitials && namePinyin.startsWith(name.toLowerCase())) return true;
              return false;
            })
          : [];

        if (exactMatches.length >= 1) {
          showStaffSuggestions(target, exactMatches);
        } else {
          hideStaffSuggestions(target);
        }
      } catch (err) {
        hideStaffSuggestions(target);
      }
    }

