    function handleRecordsBlankContextMenu(event) {
      const wrap = event.currentTarget;
      if (!wrap) return;
      if (event.target.closest('tr[data-id]')) return;
      if (!isStaffHistoryView()) return;
      event.preventDefault();
      openRecordContextMenu({ x: event.clientX, y: event.clientY }, null);
    }

