        .concat(models.map((model) => `<option value="${escapeHtml(model)}">${escapeHtml(model)}</option>`))
        .join('');
      modelSelect.value = '';
      syncDrawerSelectLabel('drawerItemName');
      syncDrawerSelectLabel('drawerModel');
      syncDrawerModelTriggerState();
      syncDrawerSelfPurchaseState();
    }

    function syncDrawerModelTriggerState() {
      const modelSelect = document.getElementById('drawerModel');
      const modelTrigger = document.getElementById('drawerModelTrigger');
      if (!modelSelect || !modelTrigger) return;
      const enabledOptions = [...modelSelect.options].filter((option) => String(option.value || '').trim());
      const disabled = enabledOptions.length === 0;
      modelTrigger.disabled = disabled;
      modelTrigger.classList.toggle('is-empty', disabled || !String(modelSelect.value || '').trim());
    }

    function syncDrawerQtyState() {
      const qtyInput = document.getElementById('drawerQty');
      const stepper = qtyInput?.closest('.stepper');
      if (!qtyInput || !stepper) return;
      const value = Number(qtyInput.value || 0);
      stepper.classList.toggle('is-negative', Number.isFinite(value) && value < 0);
    }

    function normalizeDrawerQtyValue() {
      const qtyInput = document.getElementById('drawerQty');
      if (!qtyInput) return;
      const isSpecial = !!document.getElementById('drawerSpecialIssue')?.checked;
      let value = Number.isFinite(Number(qtyInput.value)) ? parseInt(qtyInput.value, 10) : 0;

      if (isSpecial) {
        if (value < -999) value = -999;
      } else {
        if (value < 0) value = 0;
      }

      qtyInput.value = String(value);
      syncDrawerQtyState();
    }

    function syncDrawerSelectLabel(id) {
      const select = document.getElementById(id);
      const label = document.getElementById(`${id}Label`);
      const trigger = document.getElementById(`${id}Trigger`);
      if (!select || !label || !trigger) return;
      const value = String(select.value || '').trim();
      const selectedOption = select.options?.[select.selectedIndex];
      const selectedText = String(selectedOption?.textContent || '').trim();
      label.textContent = value ? (selectedText || value) : '请选择';
      trigger.classList.toggle('is-empty', !value);
    }

    function getDrawerSelfPurchaseUnitPrice() {
      const baseItem = getDrawerSelectedBaseItem();
      return Number(baseItem?.price || 0);
    }

    function syncDrawerSelfPurchaseState() {
      const enabledInput = document.getElementById('drawerSelfPurchaseEnabled');
      const amountInput = document.getElementById('drawerSelfPurchase');
      if (!enabledInput || !amountInput) return;

      syncDrawerSelectLabel('drawerSelfPurchaseEnabled');
      const enabled = String(enabledInput.value || '0') === '1';
      amountInput.readOnly = true;

      if (!enabled) {
        amountInput.value = '0';
        return;
      }

      const quantity = Math.trunc(Number(document.getElementById('drawerQty')?.value || 0));
      const unitPrice = getDrawerSelfPurchaseUnitPrice();
      const amount = quantity > 0 ? (quantity * unitPrice) : 0;
      amountInput.value = amount ? String(Number(amount.toFixed(2))) : '0';
    }

    function resetQuickIssuePanel() {
      quickIssueSummaryData = null;
      quickIssueState.matched = false;
      quickIssueState.available = { summer: 0, winter: 0, shoes: 0 };
      document.getElementById('formHireDate').textContent = '-';
      document.getElementById('formGender').textContent = '-';
      QUICK_ISSUE_DEFS.forEach((item) => {
        quickIssueState.selected[item.key] = {
          checked: false,
          quantity: 0,
          selfBuy: false,
          variant: '',
          model: ''
        };
        document.getElementById(`quickAllow-${item.key}`).textContent = '0';
        syncQuickFieldLabel(item.key, 'category');
        syncQuickFieldLabel(item.key, 'model');
        renderQuickIssueRow(item.key);
      });
    }

    function populateQuickIssueSummary(summary) {
      quickIssueSummaryData = summary || null;
      quickIssueState.matched = true;
      quickIssueState.available = quickStaffLeaveLocked
        ? { summer: 0, winter: 0, shoes: 0 }
        : (summary.available || { summer: 0, winter: 0, shoes: 0 });
      QUICK_ISSUE_DEFS.forEach((item) => {
        applyRecentQuickSelection(item.key, summary.recent_by_category?.[item.key] || null);
        document.getElementById(`quickAllow-${item.key}`).textContent = String(quickIssueState.available[item.key] || 0);
        quickIssueState.selected[item.key].checked = false;
        quickIssueState.selected[item.key].quantity = 0;
        quickIssueState.selected[item.key].selfBuy = false;
        renderQuickIssueRow(item.key);
      });
    }

    function toggleQuickIssue(key, checked) {
      if (quickStaffLeaveLocked) return;
      if (!quickIssueState.matched) return;
      const itemState = quickIssueState.selected[key];
      const availableCount = Number(quickIssueState.available[key] || 0);
      if (availableCount <= 0) {
        itemState.checked = false;
        itemState.quantity = itemState.selfBuy ? Math.max(1, itemState.quantity || 1) : 0;
        renderQuickIssueRow(key);
        return;
      }
      itemState.checked = checked;
      if (!checked) {
        itemState.quantity = 0;
        itemState.selfBuy = false;
      } else if (availableCount > 0) {
        itemState.quantity = 0;
        itemState.selfBuy = false;
      }
      renderQuickIssueRow(key);
    }

    function setQuickSelfBuy(key, checked) {
      if (quickStaffLeaveLocked) return;
      const itemState = quickIssueState.selected[key];
      if (!itemState) return;
      const availableCount = Number(quickIssueState.available[key] || 0);
      if (availableCount > 0) {
        itemState.selfBuy = false;
        renderQuickIssueRow(key);
        return;
      }
      itemState.selfBuy = checked;
      if (!checked) {
        if (!itemState.checked) itemState.quantity = 0;
      } else if (!itemState.quantity) {
        itemState.quantity = 1;
      }
      renderQuickIssueRow(key);
    }

    function adjustQuickQuantity(key, delta) {
      if (quickStaffLeaveLocked) return;
      const itemState = quickIssueState.selected[key];
      if (!itemState) return;
      const availableCount = Number(quickIssueState.available[key] || 0);
      if (availableCount > 0 && !itemState.checked) {
        renderQuickIssueRow(key);
        return;
      }
      const current = Number(itemState.quantity) || 0;
      setQuickQuantity(key, current + delta);
      normalizeQuickQuantity(key);
    }

    function setQuickQuantity(key, rawValue) {
      if (quickStaffLeaveLocked) return;
      const itemState = quickIssueState.selected[key];
      if (!itemState) return;
      const availableCount = Number(quickIssueState.available[key] || 0);
      const text = String(rawValue ?? '').replace(/[^\d]/g, '');

      if (!text) {
        itemState.quantity = 0;
        renderQuickIssueRow(key);
        return;
      }

      let next = Number(text) || 0;
      if (availableCount > 0) {
        if (!itemState.checked) {
          itemState.quantity = 0;
          renderQuickIssueRow(key);
          return;
        }
        itemState.selfBuy = false;
        next = Math.max(0, Math.min(next, availableCount));
      } else {
        if (!itemState.selfBuy) {
          itemState.quantity = 0;
          renderQuickIssueRow(key);
          return;
        }
        next = Math.max(1, next);
      }

      itemState.quantity = next;
      renderQuickIssueRow(key);
    }

    function normalizeQuickQuantity(key) {
      if (quickStaffLeaveLocked) return;
      const itemState = quickIssueState.selected[key];
      if (!itemState) return;
      const availableCount = Number(quickIssueState.available[key] || 0);

      if (availableCount > 0) {
        itemState.quantity = itemState.checked ? Math.max(0, Math.min(Number(itemState.quantity) || 0, availableCount)) : 0;
      } else {
        itemState.quantity = itemState.selfBuy ? Math.max(1, Number(itemState.quantity) || 0) : 0;
      }
      renderQuickIssueRow(key);
    }

    function renderQuickIssueRow(key) {
      const itemState = quickIssueState.selected[key];
      const availableCount = Number(quickIssueState.available[key] || 0);
      const row = document.querySelector(`[data-select-row="${key}"]`);
      const toggleBtn = document.getElementById(`quickToggle-${key}`);
      const qtyStepper = document.getElementById(`quickQtyStepper-${key}`);
      const qtyInput = document.getElementById(`quickQtyInput-${key}`);
      const qtyDown = document.getElementById(`quickQtyDown-${key}`);
      const qtyUp = document.getElementById(`quickQtyUp-${key}`);
      const selfBuySwitch = document.getElementById(`quickSelfBuy-${key}`);
      const selfBuyWrap = selfBuySwitch?.closest('.quick-switch');
      const categoryTrigger = document.getElementById(`quickCategoryTrigger-${key}`);
      const modelTrigger = document.getElementById(`quickModelTrigger-${key}`);

      toggleBtn.disabled = quickStaffLeaveLocked || !quickIssueState.matched || availableCount <= 0;
      toggleBtn.classList.toggle('active', !!itemState.checked);
      toggleBtn.textContent = availableCount > 0 ? '领用' : '自购';
      qtyInput.value = String(itemState.quantity || 0);
      categoryTrigger.disabled = quickStaffLeaveLocked || !quickIssueState.matched;
      modelTrigger.disabled = quickStaffLeaveLocked || !quickIssueState.matched;
      if (availableCount > 0) {
        itemState.selfBuy = false;
      }
      selfBuySwitch.disabled = quickStaffLeaveLocked || !quickIssueState.matched || availableCount > 0;
      selfBuySwitch.checked = !!itemState.selfBuy;
      const qtyEnabled = !quickStaffLeaveLocked && quickIssueState.matched && ((availableCount > 0 && itemState.checked) || (availableCount <= 0 && itemState.selfBuy));
      qtyInput.disabled = !qtyEnabled;
      qtyDown.disabled = !qtyEnabled || (Number(itemState.quantity) || 0) <= 0;
      qtyUp.disabled = !qtyEnabled || (availableCount > 0 && (Number(itemState.quantity) || 0) >= availableCount);
      qtyStepper.style.opacity = qtyEnabled ? '1' : '.7';
      if (selfBuyWrap) {
        selfBuyWrap.classList.toggle('is-on', !!itemState.selfBuy);
        selfBuyWrap.classList.toggle('is-disabled', !!selfBuySwitch.disabled);
      }
      if (row) {
        row.dataset.checked = itemState.checked ? 'true' : 'false';
        row.dataset.selfBuy = itemState.selfBuy ? 'true' : 'false';
        row.classList.toggle('is-inactive', !quickIssueState.matched);
      }
    }

    function getQuickIssueDef(key) {
      return QUICK_ISSUE_DEFS.find(item => item.key === key);
    }

    function getQuickDefaultVariant(item) {
      return item.variants[0] || { label: '', unit_price: 0, models: [''] };
    }

    function getQuickSelectedVariant(key) {
      const item = getQuickIssueDef(key);
      const state = quickIssueState.selected[key] || {};
      return (item?.variants || []).find(variant => variant.label === state.variant) || null;
    }

    function resolveQuickVariantFromRecord(key, record) {
      const item = getQuickIssueDef(key);
      if (!item || !record) return null;
      const category = findBaseCategoryByRecord(record) || getRecordItemCategoryLabel(record);
      return item.variants.find((variant) => variant.label === category) || null;
    }

    function applyRecentQuickSelection(key, record) {
      const item = getQuickIssueDef(key);
      const state = quickIssueState.selected[key];
      if (!item || !state) return;

      if (!record) {
        state.variant = '';
        state.model = '';
        syncQuickFieldLabel(key, 'category');
        syncQuickFieldLabel(key, 'model');
        return;
      }

      const fallbackVariant = getQuickDefaultVariant(item);
      const matchedVariant = resolveQuickVariantFromRecord(key, record) || fallbackVariant;
      const rawRecordModel = String(record?.model || '').trim();
      let recordModel = rawRecordModel;

      if (rawRecordModel && !matchedVariant.models.includes(rawRecordModel)) {
        const normalizedCandidates = [
          rawRecordModel,
          `${rawRecordModel}码`,
          rawRecordModel.replace(/码$/, '')
        ];
        const matchedModel = normalizedCandidates.find(candidate => matchedVariant.models.includes(candidate));
        if (matchedModel) {
          recordModel = matchedModel;
        }
      }

      state.variant = matchedVariant.label;
      state.model = matchedVariant.models.includes(recordModel) ? recordModel : matchedVariant.models[0];
      syncQuickFieldLabel(key, 'category');
      syncQuickFieldLabel(key, 'model');
    }

    function syncQuickModelOptions(key) {
      const variant = getQuickSelectedVariant(key);
      const state = quickIssueState.selected[key];
      if (!state) return;
      if (!variant) {
        state.model = '';
        syncQuickFieldLabel(key, 'category');
        syncQuickFieldLabel(key, 'model');
        renderQuickIssueRow(key);
        return;
      }
      state.model = variant.models.includes(state.model) ? state.model : variant.models[0];
      syncQuickFieldLabel(key, 'category');
      syncQuickFieldLabel(key, 'model');
      renderQuickIssueRow(key);
    }

    async function loadRecords(page = 1) {
      const tbody = document.getElementById('recordsBody');
      const recordsPanel = document.getElementById('recordsPanel');
      const wasNearBottom = !!recordsPanel && (recordsPanel.scrollTop + recordsPanel.clientHeight >= recordsPanel.scrollHeight - 140);
      if (recordsLoading) return;
      recordsLoading = true;
      if (!hasRenderedRecords) {
        tbody.innerHTML = '<tr><td colspan="14" class="loading">加载中...</td></tr>';
      } else {
        recordsPanel.classList.add('is-loading');
      }
      
      try {
        const params = new URLSearchParams({
          page,
          limit: recordsPageSize,
          ...currentFilters
        });
        
        const res = await fetch(`${API_BASE}?${params}`);
        const data = await res.json();
        
        if (data.code === 0) {
          allData = data.data;
          departmentTree = data.data.department_tree || [];
          syncDepartmentPositionOptions();
          if (page === 1) {
            recordItems = Array.isArray(data.data.list) ? data.data.list.slice() : [];
            recordsVisiblePage = 1;
          } else {
            recordItems = recordItems.concat(Array.isArray(data.data.list) ? data.data.list : []);
          }
          recordsPage = page;
          recordsHasMore = recordItems.length < Number(data.data.total || 0);
          currentPage = recordsVisiblePage;
          renderRecords(recordItems);
          renderPagination(data.data.total, recordsVisiblePage);
          hasRenderedRecords = true;
          const totalCount = Number(data.data.total || 0);
          const remaining = Math.max(0, totalCount - recordItems.length);
          if (wasNearBottom && !recordsLoading && recordsHasMore && remaining > 0 && remaining < recordsPageSize) {
            loadRecords(recordsPage + 1);
          }
        }
      } catch (err) {
        console.error('加载记录失败:', err);
        if (!hasRenderedRecords) {
          tbody.innerHTML = '<tr><td colspan="14" class="empty-state">加载失败，请刷新重试</td></tr>';
        }
      } finally {
        recordsLoading = false;
        recordsPanel.classList.remove('is-loading');
      }
    }

    function renderRecords(records) {
      const tbody = document.getElementById('recordsBody');
      
      if (records.length === 0) {
        selectedRecordId = null;
        tbody.innerHTML = '<tr><td colspan="14" class="empty-state">暂无数据</td></tr>';
        return;
      }

      const hasSelectedRow = selectedRecordId && records.some((item) => Number(item.id) === Number(selectedRecordId));
      const fallbackSelectedId = hasSelectedRow ? Number(selectedRecordId) : Number(records[0]?.id || 0);
      selectedRecordId = fallbackSelectedId || null;
      
      tbody.innerHTML = records.map((r, i) => {
        const displayRecord = getDisplayRecord(r);
        const isLeaveRow = !!displayRecord.leave_date;
        return `
        <tr class="${Number(displayRecord.id) === fallbackSelectedId ? 'active' : ''}${isLeaveRow ? ' is-leave-row' : ''}" data-id="${displayRecord.id}" data-page="${Math.floor(i / recordsPageSize) + 1}">
          <td><div class="person-main">${displayRecord.staff_name || '-'}</div></td>
          <td><div class="dept-main">${displayRecord.department || '-'}</div></td>
          <td><div class="dept-main">${displayRecord.position || '-'}</div></td>
          <td class="cell-center">${displayRecord.hire_date || '-'}</td>
          <td class="cell-center">${displayRecord.issue_date || '-'}</td>
          <td><div class="item-main">${escapeHtml(getRecordItemCategoryLabel(displayRecord))}</div></td>
          <td class="cell-center"><span class="badge ${getModelBadgeClass(displayRecord)}">${displayRecord.model || '-'}</span></td>
          <td class="cell-center">${displayRecord.quantity || 0}</td>
          <td class="cell-right">${formatNumber(displayRecord.unit_price)}</td>
          <td class="cell-right">${formatSelfPurchase(displayRecord.self_purchase)}</td>
          <td class="cell-center">${getLeaveDateDisplay(displayRecord)}</td>
          <td class="cell-center">${formatPercentOrDash(displayRecord.deduction_ratio, displayRecord)}</td>
          <td class="cell-right">${formatAmountOrDash(displayRecord.deduction, displayRecord)}</td>
          <td class="cell-center remark-cell">${displayRecord.remark || '-'}</td>
        </tr>
      `;
      }).join('');
    }

    function handleRecordRowClick(event) {
      closeRecordContextMenu();
      const tbody = event.currentTarget;
      const row = event.target.closest('tr[data-id]');
      if (!tbody || !row || !tbody.contains(row)) return;
      const activeRow = tbody.querySelector('tr.active');
      if (activeRow && activeRow !== row) {
        activeRow.classList.remove('active');
      }
      row.classList.add('active');
      const recordId = Number(row.dataset.id || 0);
      selectedRecordId = recordId || null;
      const record = recordItems.find((item) => Number(item.id) === recordId);
      if (record) {
        fillQuickEntryFromRecord(record);
      }
    }

    function openRecordContextMenu(position, record) {
      if (!recordContextMenu) return;
      recordContextTarget = record || null;
      const historyBtn = document.getElementById('recordContextHistoryBtn');
      if (historyBtn) {
        historyBtn.textContent = isStaffHistoryView() ? '返回列表' : '历史查询';
      }
      const menuWidth = 132;
      const menuHeight = 48;
      const maxLeft = window.innerWidth - menuWidth - 12;
      const maxTop = window.innerHeight - menuHeight - 12;
      recordContextMenu.style.left = `${Math.max(8, Math.min(position.x, maxLeft))}px`;
      recordContextMenu.style.top = `${Math.max(8, Math.min(position.y, maxTop))}px`;
      recordContextMenu.classList.add('show');
    }

    function closeRecordContextMenu() {
      recordContextTarget = null;
      recordContextMenu?.classList.remove('show');
    }

    function handleRecordRowContextMenu(event) {
      const tbody = event.currentTarget;
      const row = event.target.closest('tr[data-id]');
      if (!tbody || !row || !tbody.contains(row)) return;
      event.preventDefault();
      const recordId = Number(row.dataset.id || 0);
      const record = recordItems.find((item) => Number(item.id) === recordId);
      if (!record) return;
      const activeRow = tbody.querySelector('tr.active');
      if (activeRow && activeRow !== row) activeRow.classList.remove('active');
      row.classList.add('active');
      selectedRecordId = recordId || null;
      openRecordContextMenu({ x: event.clientX, y: event.clientY }, record);
