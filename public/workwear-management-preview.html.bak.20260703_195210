    // 月领用明细动态模
    function formatMonthlyAmount(value) {
      const num = Number(value) || 0;
      if (num <= 0) return '¥0.00';
      return `¥${num.toFixed(2)}`;
    }

    // 月领用明细表的列规格：和 库存盘存 的 inventory-sheet-total-grid 对齐
    const MONTHLY_ISSUE_COLUMNS = [
      { key: 'col-date',      width: 100 },
      { key: 'col-name',      width: 86  },
      { key: 'col-dept',      width: 90  },
      { key: 'col-dept',      width: 90  },
      { key: 'col-product',   width: 120 },
      { key: 'col-model',     width: 70  },
      { key: 'col-qty',       width: 64  },
      { key: 'col-deduction', width: 90  },
      { key: 'col-remark',    width: 100 }
    ];
    const MONTHLY_ISSUE_TABLE_WIDTH = MONTHLY_ISSUE_COLUMNS.reduce((s, c) => s + c.width, 0);
    const MONTHLY_ISSUE_COLGROUP = MONTHLY_ISSUE_COLUMNS
      .map((c) => `<col class="${c.key}" style="width:${c.width}px">`)
      .join('');
    const MONTHLY_ISSUE_GRID_TEMPLATE = MONTHLY_ISSUE_COLUMNS
      .map((c) => `${c.width}px`).join(' ');

    function buildMonthlyIssueTotalRow(data) {
      const staffCount = Number(data?.staff_count) || 0;
      const totalQty = Number(data?.total_quantity) || 0;
      const totalSelfPurchase = Number(data?.total_self_purchase) || 0;
      const rowCount = Array.isArray(data?.rows) ? data.rows.length : 0;
      return [
        '合计',                              // 1: 日期列显示合计
        `${staffCount}人`,                   // 2: 领用人数
        '',                                 // 3: -
        '',                                 // 4: -
        '',                                 // 5: -
        '',                                 // 6: -
        totalQty,                           // 7: 领用件数
        formatMonthlyAmount(totalSelfPurchase), // 8: 本月自购
        rowCount                            // 9: 明细记录
      ];
    }

    function renderMonthlyIssueTotalGrid(totalRow) {
      return `
        <table class="monthly-issue-total-table" style="width:${MONTHLY_ISSUE_TABLE_WIDTH}px;min-width:${MONTHLY_ISSUE_TABLE_WIDTH}px">
          <colgroup>${MONTHLY_ISSUE_COLGROUP}</colgroup>
          <tbody>
            <tr>
              ${totalRow.map((cell, idx) => `
                <td class="${MONTHLY_ISSUE_COLUMNS[idx].key}">${escapeHtml(cell)}</td>
              `).join('')}
            </tr>
          </tbody>
        </table>
      `;
    }

    function renderMonthlyIssueDetails(data) {
      const wrap = document.getElementById('monthlyIssueWrap');
      const totalWrap = document.getElementById('monthlyIssueTotalWrap');
      if (!wrap) return;
      const rows = Array.isArray(data?.rows) ? data.rows : [];
      if (rows.length === 0) {
        wrap.innerHTML = '<div class="col-empty">本月暂无需领用明细</div>';
        if (totalWrap) {
          totalWrap.classList.add('is-empty');
          totalWrap.innerHTML = '';
        }
        return;
      }
      const escapeAttr = (value) => String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const html = [
        `<table class="inventory-sheet-table" style="width:${MONTHLY_ISSUE_TABLE_WIDTH}px;min-width:${MONTHLY_ISSUE_TABLE_WIDTH}px">`,
        `<colgroup>${MONTHLY_ISSUE_COLGROUP}</colgroup>`,
        '<thead><tr>',
        '<th class="col-date">日期</th>',
        '<th class="col-name">姓名</th>',
        '<th class="col-dept">部门</th>',
        '<th class="col-dept">职位</th>',
        '<th class="col-product">商品</th>',
        '<th class="col-model">规格</th>',
        '<th class="col-qty">数量</th>',
        '<th class="col-deduction">自购</th>',
        '<th class="col-remark">备注</th>',
        '</tr></thead>',
        '<tbody>'
      ];
      rows.forEach((row) => {
        const issueDate = escapeAttr(row.issue_date || '');
        const name = escapeAttr(row.staff_name || '');
        const dept = escapeAttr(row.department || '-');
        const position = escapeAttr(row.position || '-');
        const itemName = escapeAttr(row.item_name || '');
        const model = escapeAttr(row.model || '');
        const qty = Number(row.quantity) || 0;
        const selfPurchase = Number(row.self_purchase) || 0;
        const remark = escapeAttr(row.remark || '');
        const isSpecial = selfPurchase > 0;
        const remarkCell = remark
          ? `<span class="${isSpecial ? 'monthly-issue-pill' : 'monthly-issue-pill is-quiet'}">${remark}</span>`
          : '<span style="color:#b6c4dc">-</span>';
        html.push(
          '<tr>',
          `<td class="col-date">${issueDate}</td>`,
          `<td class="col-name">${name}</td>`,
          `<td class="col-dept">${dept}</td>`,
          `<td class="col-dept" style="font-size:11px">${position}</td>`,
          `<td class="col-product">${itemName}</td>`,
          `<td class="col-model">${model || '-'}</td>`,
          `<td class="col-qty">${qty}</td>`,
          `<td class="col-deduction">${formatMonthlyAmount(selfPurchase)}</td>`,
          `<td class="col-remark">${remarkCell}</td>`,
          '</tr>'
        );
      });
      html.push('</tbody></table>');
      const totalRow = buildMonthlyIssueTotalRow(data);
      wrap.innerHTML = html.join('');
      if (totalWrap) {
        totalWrap.classList.remove('is-empty');
        totalWrap.innerHTML = renderMonthlyIssueTotalGrid(totalRow);
      }
      syncMonthlyIssueTotalScroll();
    }

