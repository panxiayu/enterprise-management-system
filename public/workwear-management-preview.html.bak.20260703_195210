    async function submitQuickForm(e) {
      e.preventDefault();
      if (quickStaffLeaveLocked) return;
      const staff = getSelectedStaffPayload('quick');
      if (!staff.staff_id || !staff.staff_name) {
        alert('请先确认工号和姓名，确保人员信息匹配');
        return;
      }
      const selectedItems = QUICK_ISSUE_DEFS
        .flatMap((item) => {
          const rowState = quickIssueState.selected[item.key] || {};
          const isSelected = rowState.checked || rowState.selfBuy;
          if (!isSelected || !rowState.quantity) return [];
          if (!rowState.variant || !rowState.model) {
            throw new Error(`请先选择${item.label}的类别和型号`);
          }
          const variant = item.variants.find(entry => entry.label === rowState.variant) || item.variants[0];
          const baseItem = findBaseItemForQuickSelection(item.key, rowState.variant, rowState.model);
          const itemName = baseItem?.name || `${rowState.variant}${rowState.model}`;
          const unitPrice = Number(baseItem?.price ?? variant.unit_price ?? 0);
          const totalQuantity = Number(rowState.quantity) || 0;
          const availableCount = Number(quickIssueState.available[item.key] || 0);
          const issueDate = getLocalDateValue();
          const records = [];

          if (rowState.checked) {
            const issueQuantity = rowState.selfBuy
              ? Math.min(totalQuantity, availableCount)
              : totalQuantity;
            if (issueQuantity > 0) {
              records.push({
                ...staff,
                item_name: itemName,
                item_type: item.item_type,
                model: rowState.model,
                quantity: issueQuantity,
                self_purchase: 0,
                issue_date: issueDate,
                unit_price: unitPrice,
                remark: '快速录入'
              });
            }
          }

          if (rowState.selfBuy) {
            const selfQuantity = rowState.checked
              ? Math.max(totalQuantity - Math.min(totalQuantity, availableCount), 0)
              : totalQuantity;
            if (selfQuantity > 0) {
              records.push({
                ...staff,
                item_name: itemName,
                item_type: item.item_type,
                model: rowState.model,
                quantity: selfQuantity,
                self_purchase: selfQuantity * unitPrice,
                issue_date: issueDate,
                unit_price: unitPrice,
                remark: '快速录入-自购'
              });
            }
          }

          return records;
        })
        .filter(Boolean);

      if (!selectedItems.length) {
        alert('请至少选择一项领用工服');
        return;
      }

      try {
        const results = await Promise.all(selectedItems.map(async (data) => {
          const res = await fetch(API_BASE, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          return { ok: res.ok, data: await res.json() };
        }));
        const failed = results.find(item => !item.ok || item.data.code !== 0);
        if (!failed) {
          alert('领用记录已创建');
          clearStaffSelection('quick');
          loadRecords();
          loadStats();
          invalidateInventorySheet();
        } else {
          alert('创建失败: ' + (failed.data.msg || '提交失败'));
        }
      } catch (err) {
        alert('请求失败: ' + err.message);
      }
    }

