    function syncDrawerModelOptions() {
      const category = document.getElementById('drawerItemName').value;
      const modelSelect = document.getElementById('drawerModel');
      const models = getActiveNormalizedBaseItems()
        .filter((item) => item.category === category)
        .map((item) => item.model || '-');
