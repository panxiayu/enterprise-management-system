    function updateVisibleRecordsPage(wrap = document.querySelector('.records-table-wrap')) {
      if (!wrap) return;
      const rows = Array.from(document.querySelectorAll('#recordsBody tr[data-page]'));
      if (!rows.length) return;
      const totalPages = Math.max(1, Math.ceil(Number(allData.total || 0) / recordsPageSize));
      const loadedPages = Math.max(1, Math.ceil(recordItems.length / recordsPageSize));
      const hasScrollableOverflow = wrap.scrollHeight - wrap.clientHeight > 6;
      const isAtBottom = wrap.scrollTop + wrap.clientHeight >= wrap.scrollHeight - 6;
      if (hasScrollableOverflow && isAtBottom) {
        const lastVisiblePage = recordsHasMore ? loadedPages : totalPages;
        if (lastVisiblePage !== recordsVisiblePage) {
          recordsVisiblePage = lastVisiblePage;
          currentPage = lastVisiblePage;
          renderPagination(Number(allData.total || 0), recordsVisiblePage);
        }
        return;
      }
      const wrapRect = wrap.getBoundingClientRect();
      let visiblePage = Number(rows[0].dataset.page || 1);
      for (const row of rows) {
        const rect = row.getBoundingClientRect();
        if (rect.bottom >= wrapRect.top + 44) {
          visiblePage = Number(row.dataset.page || visiblePage);
          break;
        }
      }
      if (visiblePage !== recordsVisiblePage) {
        recordsVisiblePage = visiblePage;
        currentPage = visiblePage;
        renderPagination(Number(allData.total || 0), recordsVisiblePage);
      }
    }

    async function jumpToRecordsPage(targetPage, totalPages) {
      const safeTarget = Math.max(1, Math.min(Number(targetPage || 1), Number(totalPages || 1)));
      const wrap = document.querySelector('.records-table-wrap');
      while (recordsPage < safeTarget && recordsHasMore) {
        await loadRecords(recordsPage + 1);
      }
      const targetRow = document.querySelector(`#recordsBody tr[data-page="${safeTarget}"]`);
      if (wrap && targetRow) {
        wrap.scrollTop = Math.max(0, targetRow.offsetTop - 38);
      }
      recordsVisiblePage = safeTarget;
      currentPage = safeTarget;
      renderPagination(Number(allData.total || 0), recordsVisiblePage);
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[char]));
    }

    function syncDepartmentPositionOptions() {
      departmentFilter.innerHTML = ['<option value="">全部部门</option>']
        .concat(departmentTree.map(group => `<option value="${escapeHtml(group.name)}">${escapeHtml(group.name)}</option>`))
        .join('');
      [...departmentFilter.options].forEach((option) => {
        option.selected = option.value ? selectedDepartments.includes(option.value) : selectedDepartments.length === 0;
      });
      renderPositionOptions();
      syncSelectLabel('departmentFilter');
    }

    function renderPositionOptions() {
      let positions = [];
      if (selectedDepartments.length) {
        const selectedGroups = departmentTree.filter(group => selectedDepartments.includes(group.name));
        const uniquePositions = new Set();
        let hasEmptyPosition = false;
        selectedGroups.forEach((group) => {
          if (group.positions && group.positions.length) {
            group.positions.forEach((position) => uniquePositions.add(position));
          } else {
            hasEmptyPosition = true;
          }
        });
        positions = Array.from(uniquePositions).sort((a, b) => a.localeCompare(b, 'zh-CN'));
        if (hasEmptyPosition) positions.push('__empty__');
      } else {
        positions = Array.from(new Set(departmentTree.flatMap(group => group.positions || []))).sort((a, b) => a.localeCompare(b, 'zh-CN'));
      }
      positionFilter.innerHTML = ['<option value="">全部岗位</option>']
        .concat(positions.map(position => `<option value="${escapeHtml(position)}">${position === '__empty__' ? '无' : escapeHtml(position)}</option>`))
        .join('');
      selectedPositions = selectedPositions.filter(position => positions.includes(position));
      [...positionFilter.options].forEach((option) => {
        option.selected = option.value ? selectedPositions.includes(option.value) : selectedPositions.length === 0;
      });
      syncSelectLabel('positionFilter');
    }

    function syncSelectLabel(id) {
      const label = document.getElementById(`${id}Label`);
      if (!label) return;
      const values = getSelectedValues(id);
      if (id === 'departmentFilter') {
        label.textContent = values.length ? `已选 ${values.length} 个部门` : '全部部门';
      } else if (id === 'positionFilter') {
        label.textContent = values.length ? `已选 ${values.length} 个岗位` : '全部岗位';
      } else if (id === 'typeFilter') {
        label.textContent = values.length ? `已选 ${values.length} 个类型` : '全部类型';
      }
    }

    function toggleSelect(id) {
      const trigger = document.getElementById(`${id}Trigger`);
      if (!trigger || trigger.disabled) return;
      if (selectField === id && selectPop.classList.contains('show')) {
        closeSelect();
        return;
      }
      closeCalendar();
      selectField = id;
      const rect = trigger.getBoundingClientRect();
      selectPop.style.minWidth = '0px';
      selectPop.style.width = `${rect.width}px`;
      selectPop.style.left = `${Math.min(rect.left, window.innerWidth - rect.width - 12)}px`;
      selectPop.style.top = `${rect.bottom + 8}px`;
      renderSelectOptions(id);
      selectPop.classList.add('show');
      trigger.classList.add('open');
    }

    function renderSelectOptions(id) {
      if (id && id.startsWith('inventory:')) {
        renderInventoryFilterOptions(id);
        return;
      }
      if (id === 'drawerItemName' || id === 'drawerModel' || id === 'drawerSelfPurchaseEnabled') {
        const select = document.getElementById(id);
        selectOptions.innerHTML = [...select.options]
          .filter(option => option.value)
          .map(option => `
          <button type="button" class="select-option no-check${option.value === select.value ? ' active' : ''}" data-value="${escapeHtml(option.value)}">
            <span class="select-option-label">${escapeHtml(option.textContent)}</span>
          </button>
        `).join('');
        selectOptions.querySelectorAll('.select-option').forEach((button) => {
          button.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            setDrawerSelectValue(id, button.dataset.value || '');
            closeSelect();
          });
        });
        return;
      }
      const select = document.getElementById(id);
      selectOptions.innerHTML = [...select.options]
        .filter(option => option.value)
        .map(option => `
        <label class="select-option${getSelectedValues(id).includes(option.value) ? ' active' : ''}${option.value === '__empty__' ? ' no-check' : ''}" data-value="${escapeHtml(option.value)}">
          ${option.value === '__empty__' ? '' : `<input class="select-option-check" type="checkbox" ${getSelectedValues(id).includes(option.value) ? 'checked' : ''}>`}
          <span class="select-option-label">${escapeHtml(option.textContent)}</span>
        </label>
      `).join('');
      selectOptions.querySelectorAll('.select-option').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          toggleSelectionValue(id, button.dataset.value || '');
        });
      });
    }

    function renderInventoryFilterOptions(id) {
      const fieldId = String(id || '');
      const columnKey = fieldId.replace(/^inventory:/, '');
      const columnIndex = inventoryFilterSource.columns.findIndex((column) => String(column?.key || '') === columnKey);
      if (columnIndex < 0) {
        selectOptions.innerHTML = '<div class="inventory-filter-empty">暂无可筛选项</div>';
        return;
      }
      const values = buildInventoryFilterValues(columnIndex);
      if (!values.length) {
        selectOptions.innerHTML = '<div class="inventory-filter-empty">暂无可筛选项</div>';
        return;
      }
      const selectedValues = getInventoryEffectiveSelectedValues(fieldId, values);
      const isAsc = inventoryHeaderSort.key === columnKey && inventoryHeaderSort.dir === 'asc';
      const isDesc = inventoryHeaderSort.key === columnKey && inventoryHeaderSort.dir === 'desc';
      selectOptions.innerHTML = `
        <div class="inventory-filter-toolbar">
          <div class="inventory-filter-toolbar-row">
            <label class="inventory-filter-select-all">
              <input type="checkbox" id="inventoryFilterAll">
              <span>全选</span>
            </label>
            <div class="inventory-filter-sort">
              <button type="button" class="inventory-filter-sort-btn${isAsc ? ' is-active' : ''}" data-sort-dir="asc">升序 ↑</button>
              <button type="button" class="inventory-filter-sort-btn${isDesc ? ' is-active' : ''}" data-sort-dir="desc">降序 ↓</button>
            </div>
          </div>
        </div>
        <div id="inventoryFilterList">
          ${buildInventoryFilterOptionHtml(fieldId, values, selectedValues)}
        </div>
      `;
      bindInventoryFilterOptionEvents(fieldId, values);
    }

    function buildInventoryFilterOptionHtml(fieldId, values, selectedValues) {
      return values.map((option) => `
        <label class="select-option inventory-filter-item${selectedValues.includes(option.value) ? ' active' : ''}" data-value="${escapeHtml(option.value)}" data-label="${escapeHtml(option.label.toLowerCase())}">
          <input class="select-option-check" type="checkbox" ${selectedValues.includes(option.value) ? 'checked' : ''}>
          <span class="select-option-label">${escapeHtml(option.label)}</span>
          <button type="button" class="single-select-btn" data-single-value="${escapeHtml(option.value)}">仅筛选此项</button>
        </label>
      `).join('');
    }

    function bindInventoryFilterOptionEvents(fieldId, values) {
      selectOptions.querySelectorAll('.select-option').forEach((button) => {
        button.addEventListener('click', (event) => {
          if (event.target.closest('.single-select-btn')) return;
          event.preventDefault();
          event.stopPropagation();
          toggleSelectionValue(fieldId, button.dataset.value || '');
        });
      });
      selectOptions.querySelectorAll('.single-select-btn').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          singleSelectInventoryFilter(fieldId, button.dataset.singleValue || '');
        });
      });
      const allCheckbox = document.getElementById('inventoryFilterAll');
      if (allCheckbox) {
        allCheckbox.addEventListener('change', () => {
          toggleInventoryFilterAll(fieldId, values, allCheckbox.checked);
        });
      }
      selectOptions.querySelectorAll('[data-sort-dir]').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          setInventoryHeaderSort(fieldId, button.dataset.sortDir || '');
        });
      });
      updateInventoryFilterAllState(fieldId);
    }

    function buildInventoryFilterValues(columnIndex) {
      const values = new Map();
      inventoryFilterSource.rows.forEach((row) => {
        const rawValue = String(row?.[columnIndex] ?? '').trim();
        const valueKey = rawValue || '__blank__';
        if (!values.has(valueKey)) {
          values.set(valueKey, {
            value: valueKey,
            label: rawValue || '空白'
          });
        }
      });
      return [...values.values()].sort((a, b) => String(a.label).localeCompare(String(b.label), 'zh-CN-u-kn-true'));
    }

    function hasInventoryFilterState(fieldId) {
      return Object.prototype.hasOwnProperty.call(inventoryHeaderFilters, fieldId);
    }

    function getInventoryEffectiveSelectedValues(fieldId, values) {
      if (hasInventoryFilterState(fieldId)) {
        return inventoryHeaderFilters[fieldId] || [];
      }
      return values.map((item) => item.value);
    }

    function updateInventoryFilterAllState(fieldId) {
      const allCheckbox = document.getElementById('inventoryFilterAll');
      if (!allCheckbox) return;
      const visibleItems = [...selectOptions.querySelectorAll('.inventory-filter-item')];
      const selectedValues = visibleItems.length
        ? getInventoryEffectiveSelectedValues(fieldId, visibleItems.map((item) => ({ value: item.dataset.value || '' })))
        : [];
      if (!visibleItems.length) {
        allCheckbox.checked = false;
        allCheckbox.indeterminate = false;
        return;
      }
      const visibleValues = visibleItems.map((item) => item.dataset.value || '');
      const checkedCount = visibleValues.filter((value) => selectedValues.includes(value)).length;
      allCheckbox.checked = checkedCount === visibleValues.length;
      allCheckbox.indeterminate = checkedCount > 0 && checkedCount < visibleValues.length;
    }

    function toggleInventoryFilterAll(fieldId, values, checked) {
      const visibleValueSet = new Set(values.map((item) => item.value));
      let nextValues = getInventoryEffectiveSelectedValues(fieldId, values);
      if (checked) {
        nextValues = [...new Set(nextValues.concat([...visibleValueSet]))];
      } else {
        nextValues = nextValues.filter((value) => !visibleValueSet.has(value));
      }
      if (nextValues.length === values.length) {
        delete inventoryHeaderFilters[fieldId];
      } else {
        inventoryHeaderFilters[fieldId] = nextValues;
      }
      rerenderInventorySheetFromState();
      requestAnimationFrame(() => reopenInventoryHeaderFilter(fieldId));
    }

    function singleSelectInventoryFilter(fieldId, value) {
      if (!fieldId || !value) return;
      inventoryHeaderFilters[fieldId] = [value];
      closeSelect();
      rerenderInventorySheetFromState();
    }

    function setInventoryHeaderSort(fieldId, dir) {
      const columnKey = String(fieldId || '').replace(/^inventory:/, '');
      if (!columnKey || !dir) return;
      if (inventoryHeaderSort.key === columnKey && inventoryHeaderSort.dir === dir) {
        inventoryHeaderSort = { key: '', dir: '' };
      } else {
        inventoryHeaderSort = { key: columnKey, dir };
      }
      rerenderInventorySheetFromState();
      requestAnimationFrame(() => reopenInventoryHeaderFilter(fieldId));
    }

    function toggleQuickFieldSelect(key, type) {
      const fieldId = `quick:${key}:${type}`;
      if (selectField === fieldId && selectPop.classList.contains('show')) {
        closeSelect();
        return;
      }
      closeCalendar();
      selectField = fieldId;
      const trigger = document.getElementById(type === 'category' ? `quickCategoryTrigger-${key}` : `quickModelTrigger-${key}`);
      const rect = trigger.getBoundingClientRect();
      selectPop.style.minWidth = '0px';
      selectPop.style.width = `${rect.width}px`;
      selectPop.style.left = `${Math.min(rect.left, window.innerWidth - rect.width - 12)}px`;
      selectPop.style.top = `${rect.bottom + 8}px`;
      selectOptions.classList.toggle('hide-scrollbar', type === 'model');
      renderQuickFieldOptions(key, type);
      selectPop.classList.add('show');
      trigger.classList.add('open');
    }

    function renderQuickFieldOptions(key, type) {
      const options = type === 'category'
        ? (getQuickIssueDef(key)?.variants || []).map(variant => variant.label)
        : (getQuickSelectedVariant(key)?.models || []);
      const currentValue = type === 'category'
        ? (quickIssueState.selected[key]?.variant || '')
        : (quickIssueState.selected[key]?.model || '');

      selectOptions.innerHTML = options.map(option => `
        <button type="button" class="select-option no-check${option === currentValue ? ' active' : ''}" data-value="${escapeHtml(option)}">
          <span class="select-option-label">${escapeHtml(option)}</span>
        </button>
      `).join('');

      selectOptions.querySelectorAll('.select-option').forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          setQuickFieldValue(key, type, button.dataset.value || '');
          closeSelect();
        });
      });
    }

    function setQuickFieldValue(key, type, value) {
      if (!value || !quickIssueState.selected[key]) return;
      if (type === 'category') {
        quickIssueState.selected[key].variant = value;
        syncQuickModelOptions(key);
      } else {
        quickIssueState.selected[key].model = value;
        syncQuickFieldLabel(key, 'model');
      }
    }

    function syncQuickFieldLabel(key, type) {
      const state = quickIssueState.selected[key];
      if (!state) return;
      const trigger = document.getElementById(type === 'category' ? `quickCategoryTrigger-${key}` : `quickModelTrigger-${key}`);
      if (!trigger) return;
      const isMatched = quickIssueState.matched;
      const value = type === 'category' ? (state.variant || '') : (state.model || '');
      if (type === 'category') {
        trigger.textContent = isMatched ? value : '';
      } else {
        trigger.textContent = isMatched ? value : '';
      }
      trigger.classList.toggle('is-empty', isMatched && !value);
    }

    function toggleSelectionValue(id, value) {
      if (!value) return;
      let values = id.startsWith('inventory:')
        ? getInventoryEffectiveSelectedValues(
          id,
          buildInventoryFilterValues(
            inventoryFilterSource.columns.findIndex((column) => `inventory:${column?.key || ''}` === id)
          )
        )
        : [...getSelectedValues(id)];
      if (values.includes(value)) {
        values = values.filter(item => item !== value);
      } else {
        values = values.concat(value);
      }
      if (id === 'departmentFilter') {
        selectedDepartments = values;
        syncDepartmentPositionOptions();
        applyFilters();
      } else if (id === 'positionFilter') {
        selectedPositions = values;
        [...positionFilter.options].forEach((option) => {
          option.selected = option.value ? selectedPositions.includes(option.value) : selectedPositions.length === 0;
        });
        syncSelectLabel('positionFilter');
        applyFilters();
      } else if (id === 'typeFilter') {
        selectedTypes = values;
        [...typeFilter.options].forEach((option) => {
          option.selected = option.value ? selectedTypes.includes(option.value) : selectedTypes.length === 0;
        });
        syncSelectLabel('typeFilter');
        applyFilters();
      } else if (id.startsWith('inventory:')) {
        const allValues = buildInventoryFilterValues(
          inventoryFilterSource.columns.findIndex((column) => `inventory:${column?.key || ''}` === id)
        ).map((item) => item.value);
        if (values.length === allValues.length) {
          delete inventoryHeaderFilters[id];
        } else {
          inventoryHeaderFilters[id] = values;
        }
        rerenderInventorySheetFromState();
        requestAnimationFrame(() => reopenInventoryHeaderFilter(id));
      }
      if (!id.startsWith('inventory:')) {
        renderSelectOptions(id);
      }
    }

    function reopenInventoryHeaderFilter(id) {
      if (!id || !id.startsWith('inventory:') || selectField !== id) return;
      const trigger = getSelectTriggerElement(id);
      if (!trigger) {
        closeSelect();
        return;
      }
      positionInventoryHeaderFilterPop(trigger);
      renderSelectOptions(id);
      selectPop.classList.add('show');
      trigger.classList.add('open');
    }

    function closeSelect() {
      if (selectField) {
        const trigger = getSelectTriggerElement(selectField);
        if (trigger) trigger.classList.remove('open');
      }
      selectPop.classList.remove('show');
      selectOptions.classList.remove('hide-scrollbar');
      selectField = null;
    }

    function getSelectTriggerElement(fieldId) {
      if (!fieldId) return null;
      if (fieldId.startsWith('quick:')) {
        const [, key, type] = fieldId.split(':');
        return document.getElementById(type === 'category' ? `quickCategoryTrigger-${key}` : `quickModelTrigger-${key}`);
      }
      if (fieldId === 'inventoryCompactMonth') {
        return document.getElementById('inventoryCompactMonthTrigger');
      }
      if (fieldId === 'monthlyIssueMonth') {
        return document.getElementById('monthlyIssueMonthTrigger');
      }
      if (fieldId.startsWith('inventory:')) {
        return document.querySelector(`[data-inventory-filter="${fieldId}"]`);
      }
      return document.getElementById(`${fieldId}Trigger`);
    }

    function getStaffNameInputElement(target) {
      if (!target) return null;
      if (target === 'list-search') {
        return document.getElementById('searchInput');
      }
      const prefix = target === 'quick' ? 'form' : 'drawer';
      return document.getElementById(`${prefix}StaffNameInput`);
    }

    function bindListSearchInput() {
      const searchInput = document.getElementById('searchInput');
      let isComposing = false;

      searchInput.addEventListener('input', () => {
        if (isComposing) return;
        const value = searchInput.value.trim();
        selectedSearchStaff = null;
        if (!value) {
          hideStaffSuggestions('list-search');
          applyFilters();
          return;
        }
        handleListSearchLookup();
      });

      searchInput.addEventListener('compositionstart', () => {
        isComposing = true;
      });

      searchInput.addEventListener('compositionend', () => {
        isComposing = false;
        selectedSearchStaff = null;
        if (!searchInput.value.trim()) {
          hideStaffSuggestions('list-search');
          applyFilters();
          return;
        }
        handleListSearchLookup();
      });

      searchInput.addEventListener('keyup', (event) => {
        if (isComposing || event.key !== 'Shift') return;
        if (!searchInput.value.trim()) return;
        selectedSearchStaff = null;
        handleListSearchLookup();
      });

      searchInput.addEventListener('keydown', (event) => {
        if (staffSuggestTarget === 'list-search' && staffSuggestPop.classList.contains('show')) {
          if (event.key === 'Enter') {
            event.preventDefault();
            const match = staffSuggestMatches[staffSuggestActiveIndex] || staffSuggestMatches[0];
            if (match) applyStaffSuggestion('list-search', match);
            return;
          }
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            moveStaffSuggestionActive(1);
            return;
          }
          if (event.key === 'ArrowUp') {
            event.preventDefault();
            moveStaffSuggestionActive(-1);
            return;
          }
        }
        if (event.key === 'Enter') {
          event.preventDefault();
          hideStaffSuggestions('list-search');
          applyFilters();
        }
      });

      searchInput.addEventListener('focus', () => {
        if (searchInput.value.trim() && !selectedSearchStaff) {
          handleListSearchLookup();
        }
      });

      searchInput.addEventListener('blur', () => {
        window.setTimeout(() => {
          if (staffSuggestTarget === 'list-search') return;
          const currentValue = searchInput.value.trim();
          if (!currentValue) {
            applyFilters();
            return;
          }
          if (!selectedSearchStaff) {
            hideStaffSuggestions('list-search');
            applyFilters();
          }
        }, 120);
      });
    }

    function fillStaffSelection(target, staff) {
      if (!target || !staff) return;
      hideStaffSuggestions();
      const prefix = target === 'quick' ? 'form' : 'drawer';
      document.getElementById(`${prefix}StaffId`).value = staff.id || '';
      document.getElementById(`${prefix}EmployeeIdHidden`).value = staff.employee_id || '';
      document.getElementById(`${prefix}StaffName`).value = staff.name || '';
      document.getElementById(`${prefix}EmployeeId`).value = staff.employee_id || '';
      document.getElementById(`${prefix}StaffNameInput`).value = staff.name || '';
      document.getElementById(`${prefix}Department`).textContent = staff.department || '-';
      document.getElementById(`${prefix}Position`).textContent = staff.position || '无';
      const hireDateEl = document.getElementById(`${prefix}HireDate`);
      const genderEl = document.getElementById(`${prefix}Gender`);
      if (hireDateEl) hireDateEl.textContent = staff.hire_date || '-';
      if (genderEl) genderEl.textContent = staff.gender || '-';
      if (target === 'quick') {
        document.getElementById('formHireDate').textContent = staff.hire_date || '-';
        document.getElementById('formGender').textContent = staff.gender || '-';
        const isLeaveLocked = !!String(staff.leave_date || '').trim();
        setQuickStaffLeaveLocked(isLeaveLocked);
        if (isLeaveLocked && !settlementColumnsExpanded) {
          toggleSettlementColumns();
        } else if (settlementColumnsExpanded) {
          updateSettlementPanel();
        }
        // 再次确保离职状态生效（兜底）
        if (isLeaveLocked) {
          const previewBtn = document.getElementById('settlementPreviewBtn');
          const confirmBtn = document.getElementById('settlementConfirmBtn');
          if (previewBtn) previewBtn.setAttribute('disabled', 'disabled');
          if (confirmBtn) confirmBtn.setAttribute('disabled', 'disabled');
          document.getElementById('settlementPanel')?.classList.add('is-disabled');
        }
      }
    }

    function clearStaffSelection(target) {
      hideStaffSuggestions(target);
      const prefix = target === 'quick' ? 'form' : 'drawer';
      document.getElementById(`${prefix}EmployeeId`).value = '';
      document.getElementById(`${prefix}StaffNameInput`).value = '';
      document.getElementById(`${prefix}StaffId`).value = '';
      document.getElementById(`${prefix}EmployeeIdHidden`).value = '';
      document.getElementById(`${prefix}StaffName`).value = '';
      document.getElementById(`${prefix}Department`).textContent = '-';
      document.getElementById(`${prefix}Position`).textContent = '-';
      const hireDateEl = document.getElementById(`${prefix}HireDate`);
      const genderEl = document.getElementById(`${prefix}Gender`);
      if (hireDateEl) hireDateEl.textContent = '-';
      if (genderEl) genderEl.textContent = '-';
      if (target === 'quick') {
        setQuickStaffLeaveLocked(false);
        resetQuickIssuePanel();
        if (settlementColumnsExpanded) {
          const shouldRefreshRecords = hasSettlementPreview();
          settlementPreviewMap = new Map();
          settlementPreviewSummary = null;
          document.getElementById('settlementLeaveDate').value = '';
          updateSettlementPanel();
          if (shouldRefreshRecords) {
            renderRecords(recordItems);
          }
        }
      }
    }

    function bindStaffIdentityInputs(target) {
      const prefix = target === 'quick' ? 'form' : 'drawer';
      const employeeInput = document.getElementById(`${prefix}EmployeeId`);
      const nameInput = document.getElementById(`${prefix}StaffNameInput`);
      const hasMatchedSnapshot = () => (
        !!document.getElementById(`${prefix}EmployeeIdHidden`).value.trim() ||
        !!document.getElementById(`${prefix}StaffId`).value.trim() ||
        !!document.getElementById(`${prefix}StaffName`).value.trim()
      );
      let previousEmployeeValue = employeeInput.value;
      let previousNameValue = nameInput.value;
      let isComposingName = false;

      employeeInput.addEventListener('input', () => {
        const currentValue = employeeInput.value.trim();
        const previousValue = String(previousEmployeeValue || '').trim();
        const isDeleting = currentValue.length < previousValue.length;
        const changedFromPrevious = currentValue !== previousValue;
        if (changedFromPrevious && hasMatchedSnapshot() && nameInput.value.trim()) {
          nameInput.value = '';
          previousNameValue = '';
        }
        previousEmployeeValue = currentValue;
        if (isDeleting) {
          nameInput.value = '';
          previousNameValue = '';
          clearStaffSelection(target);
          if (currentValue) employeeInput.value = currentValue;
          return;
        }
        if (!employeeInput.value.trim()) {
          clearStaffSelection(target);
          previousNameValue = '';
          return;
        }
        hideStaffSuggestions(target);
        clearMatchedStaff(target, { preserveInputs: true });
        handleEmployeeIdLookup(target);
      });

      nameInput.addEventListener('input', () => {
        if (isComposingName) return;
        const currentValue = nameInput.value.trim();
        const previousValue = String(previousNameValue || '').trim();
        const isDeleting = currentValue.length < previousValue.length;
        const changedFromPrevious = currentValue !== previousValue;
        if (changedFromPrevious && hasMatchedSnapshot() && employeeInput.value.trim()) {
          employeeInput.value = '';
          previousEmployeeValue = '';
        }
        previousNameValue = currentValue;
        if (isDeleting) {
          employeeInput.value = '';
          previousEmployeeValue = '';
          clearStaffSelection(target);
          if (currentValue) nameInput.value = currentValue;
          return;
        }
        if (!nameInput.value.trim()) {
          clearStaffSelection(target);
          previousEmployeeValue = '';
          return;
        }
        clearMatchedStaff(target, { preserveInputs: true });
        handleStaffNameLookup(target);
      });

      nameInput.addEventListener('compositionstart', () => {
        isComposingName = true;
      });

      nameInput.addEventListener('compositionend', () => {
        isComposingName = false;
        const currentValue = nameInput.value.trim();
        previousNameValue = currentValue;
        if (!currentValue) {
          clearStaffSelection(target);
          previousEmployeeValue = '';
          return;
        }
        clearMatchedStaff(target, { preserveInputs: true });
        handleStaffNameLookup(target);
      });

      nameInput.addEventListener('keyup', (event) => {
        if (isComposingName) return;
        if (event.key !== 'Shift') return;
        const currentValue = nameInput.value.trim();
        if (!currentValue) return;
        previousNameValue = currentValue;
        clearMatchedStaff(target, { preserveInputs: true });
        handleStaffNameLookup(target);
      });

      nameInput.addEventListener('keydown', (event) => {
        if (staffSuggestTarget !== target || !staffSuggestPop.classList.contains('show')) return;
        if (event.key === 'Enter') {
          event.preventDefault();
          const match = staffSuggestMatches[staffSuggestActiveIndex] || staffSuggestMatches[0];
          if (match) applyStaffSuggestion(target, match);
          return;
        }
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          moveStaffSuggestionActive(1);
          return;
        }
        if (event.key === 'ArrowUp') {
          event.preventDefault();
          moveStaffSuggestionActive(-1);
        }
      });

