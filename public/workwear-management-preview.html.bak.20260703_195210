    async function fillQuickEntryFromRecord(record) {
      if (!record) return;

      const employeeInput = document.getElementById('formEmployeeId');
      const nameInput = document.getElementById('formStaffNameInput');
      const hiddenName = document.getElementById('formStaffName');

      clearMatchedStaff('quick', { preserveInputs: true });
      employeeInput.value = record.employee_id || employeeInput.value || '';
      nameInput.value = record.staff_name || '';
      hiddenName.value = record.staff_name || '';

      try {
        const params = new URLSearchParams();
        if (record.staff_id) params.set('staff_id', String(record.staff_id));
        if (record.staff_name) params.set('name', record.staff_name);
        const res = await fetch(`/api/auth/staff-profile?${params.toString()}`, {
          headers: getAuthHeaders()
        });
        const data = await res.json();

        if (res.ok && data.code === 0 && data.data) {
          fillStaffSelection('quick', {
            ...data.data,
            leave_date: record.leave_date || data.data.leave_date || ''
          });
