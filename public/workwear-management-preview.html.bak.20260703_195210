            <div class="meta-chip">盘点 <strong class="meta-value">${Number(row.manual_total_qty || 0)}</strong>${escapeHtml(row.unit || '')}</div>
            <div class="meta-chip">差异 <strong class="meta-value ${(Number(row.difference_qty)||0) === 0 ? '' : 'is-warn'}">${(Number(row.difference_qty)||0) > 0 ? '+' : ''}${Number(row.difference_qty || 0)}</strong>${escapeHtml(row.unit || '')}</div>
