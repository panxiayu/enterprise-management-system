    async function loadInventorySheet() {
      const wrap = document.getElementById('inventorySheetWrap');
      wrap.innerHTML = '<div class="inventory-sheet-empty">加载中...</div>';
      try {
        const res = await fetch(`${API_BASE}/inventory-monthly?year_month=${encodeURIComponent(getCurrentInventoryYearMonth())}`);
        const data = await res.json();
        if (data.code !== 0) {
          throw new Error(data.msg || '加载失败');
        }
        inventorySheetLoaded = true;
        inventorySheetPayload = data.data.sheet || data.data;
        renderInventorySheet(inventorySheetPayload);
      } catch (err) {
        console.error('加载盘存表失败:', err);
        wrap.innerHTML = `<div class="inventory-sheet-empty">${escapeHtml(err.message || '加载失败')}</div>`;
      }
    }

    function getCurrentInventoryYearMonth() {
      const now = new Date();
      const year = now.getFullYear();
      const month = Math.max(1, Math.min(12, Number(inventoryCompactMonth || (now.getMonth() + 1))));
      return `${year}-${String(month).padStart(2, '0')}`;
    }

    function getCurrentMonthlyIssueYearMonth() {
      const now = new Date();
      const year = now.getFullYear();
      const month = Math.max(1, Math.min(12, Number(monthlyIssueMonth || (now.getMonth() + 1))));
      return `${year}-${String(month).padStart(2, '0')}`;
    }

    function invalidateInventorySheet() {
      inventorySheetLoaded = false;
      if (document.getElementById('inventorySheetDrawer').classList.contains('show')) {
        loadInventorySheet();
      }
    }

    function renderInventorySheet(payload) {
      const wrap = document.getElementById('inventorySheetWrap');
      const totalWrap = document.getElementById('inventorySheetTotalWrap');
      const rawColumns = Array.isArray(payload?.columns) ? payload.columns : [];
      const rawRows = Array.isArray(payload?.rows) ? payload.rows : [];
      const baseSheet = inventorySheetExpanded
        ? getInventorySheetByDateRange(payload, rawColumns, rawRows)
        : getVisibleInventorySheet(rawColumns, rawRows);
      inventoryFilterSource = {
        columns: baseSheet.columns,
        rows: baseSheet.rows
      };
      const columns = baseSheet.columns;
      const rows = sortInventoryRows(
        applyInventoryHeaderFilters(baseSheet.columns, baseSheet.rows),
        baseSheet.columns
      );
      const totalRow = rows.length ? buildInventoryTotalRow(columns, rows) : null;

      if (!columns.length) {
        wrap.innerHTML = '<div class="inventory-sheet-empty">暂无盘存数据</div>';
        if (totalWrap) {
          totalWrap.classList.add('is-empty');
          totalWrap.innerHTML = '';
        }
        return;
      }

      const topHeaderCells = [];
      const bottomHeaderCells = [];
      let index = 0;

      while (index < columns.length) {
        const column = columns[index] || {};
        const top = String(column.top || '').trim();
        const bottom = String(column.bottom || '').trim();
        const columnClass = getInventoryColumnClass(column);

        if (top && bottom) {
          let end = index + 1;
          while (end < columns.length) {
            const next = columns[end] || {};
            const nextTop = String(next.top || '').trim();
            const nextBottom = String(next.bottom || '').trim();
            if (nextTop || !nextBottom) break;
            end += 1;
          }
          topHeaderCells.push(`<th class="${columnClass}" colspan="${end - index}">${escapeHtml(top)}</th>`);
          for (let subIndex = index; subIndex < end; subIndex += 1) {
            bottomHeaderCells.push(`<th class="${getInventoryColumnClass(columns[subIndex])}">${escapeHtml(columns[subIndex].bottom || '')}</th>`);
          }
          index = end;
          continue;
        }

        topHeaderCells.push(`<th class="${columnClass}" rowspan="2">${escapeHtml(top || bottom || '-')}</th>`);
        index += 1;
      }

      wrap.innerHTML = `
        <table class="inventory-sheet-table" style="${getInventoryTableStyle(columns)}">
          <colgroup>
            ${columns.map((column) => `<col style="${getInventoryColumnStyle(column, columns)}">`).join('')}
          </colgroup>
          <thead>
            <tr>${topHeaderCells.join('')}</tr>
            <tr>${bottomHeaderCells.join('')}</tr>
          </thead>
          <tbody>
            ${rows.length ? rows.map((row) => `
              <tr>${row.map((cell, cellIndex) => `<td class="${getInventoryColumnClass(columns[cellIndex])}"${getInventoryColumnDataset(columns[cellIndex], cellIndex)}>${escapeHtml(cell)}</td>`).join('')}</tr>
            `).join('') : `<tr><td colspan="${columns.length}" class="inventory-filter-empty">暂无匹配数据</td></tr>`}
          </tbody>
        </table>
      `;
      renderInventorySheetHeaderDatasets(columns, wrap);
      bindInventoryHeaderFilters(columns, wrap);
      fillInventorySheetPlaceholderRows(columns, wrap, rows.length);
      renderInventoryTotalRow(columns, totalRow);
      syncInventoryFloatingScrollMetrics();
      syncInventoryFloatingScrollFromTable();
    }

    function buildInventoryTotalRow(columns, rows) {
      return columns.map((column, columnIndex) => {
        const kind = getInventoryColumnKind(column);
        if (kind === 'item') return '合计';
        if (kind !== 'carry' && kind !== 'month') return '';
        const total = rows.reduce((sum, row) => {
          const raw = String(row?.[columnIndex] ?? '').trim();
          if (!raw) return sum;
          const numeric = Number(raw);
          return Number.isFinite(numeric) ? sum + numeric : sum;
        }, 0);
        return total ? String(total) : '0';
      });
    }

    function renderInventoryTotalRow(columns, totalRow) {
      const totalWrap = document.getElementById('inventorySheetTotalWrap');
      if (!totalWrap) return;
      if (!Array.isArray(columns) || !columns.length || !Array.isArray(totalRow)) {
        totalWrap.classList.add('is-empty');
        totalWrap.innerHTML = '';
        return;
      }
      totalWrap.classList.remove('is-empty');
      totalWrap.innerHTML = `
        <div class="inventory-sheet-total-grid" style="${getInventoryTotalGridStyle(columns)}">
          ${totalRow.map((cell, index) => `
            <div class="inventory-sheet-total-cell ${getInventoryColumnClass(columns[index])}"${getInventoryColumnDataset(columns[index], index)}>${escapeHtml(cell)}</div>
          `).join('')}
        </div>
      `;
    }

    function getInventoryTotalGridStyle(columns) {
      const width = inventorySheetExpanded ? getInventoryTableWidth(columns) : null;
      const template = columns.map((column) => (
        inventorySheetExpanded ? `${getInventoryColumnWidth(column)}px` : `${getInventoryColumnFlex(column)}fr`
      )).join(' ');
      return `${width ? `width:${width}px;min-width:${width}px;` : 'width:100%;min-width:100%;'}grid-template-columns:${template}`;
    }

    function syncInventoryTotalScroll() {
      const wrap = document.getElementById('inventorySheetWrap');
      const totalWrap = document.getElementById('inventorySheetTotalWrap');
      if (!wrap || !totalWrap || totalWrap.classList.contains('is-empty')) return;
      totalWrap.scrollLeft = wrap.scrollLeft;
    }

    function syncMonthlyIssueTotalScroll() {
      const wrap = document.getElementById('monthlyIssueWrap');
      const totalWrap = document.getElementById('monthlyIssueTotalWrap');
      if (!wrap || !totalWrap || totalWrap.classList.contains('is-empty')) return;
      totalWrap.scrollLeft = wrap.scrollLeft;
    }

    function syncInventoryFloatingScrollMetrics() {
      const wrap = document.getElementById('inventorySheetWrap');
      const floatingInner = document.getElementById('inventoryFloatingHScrollInner');
      if (!wrap || !floatingInner) return;
      floatingInner.style.width = `${wrap.scrollWidth}px`;
    }

    function syncInventoryFloatingScrollFromTable() {
      const wrap = document.getElementById('inventorySheetWrap');
      const totalWrap = document.getElementById('inventorySheetTotalWrap');
      const floating = document.getElementById('inventoryFloatingHScroll');
      if (!wrap) return;
      const scrollLeftChanged = Math.abs(wrap.scrollLeft - inventoryLastScrollLeft) > 1;
      inventoryLastScrollLeft = wrap.scrollLeft;
      if (scrollLeftChanged) {
        showInventoryFloatingScroll();
        scheduleHideInventoryFloatingScroll();
      }
      if (totalWrap && !totalWrap.classList.contains('is-empty')) {
        totalWrap.scrollLeft = wrap.scrollLeft;
      }
      if (floating && Math.abs(floating.scrollLeft - wrap.scrollLeft) > 1) {
        floating.scrollLeft = wrap.scrollLeft;
      }
    }

    function syncInventoryFloatingScrollFromBar() {
      const wrap = document.getElementById('inventorySheetWrap');
      const totalWrap = document.getElementById('inventorySheetTotalWrap');
      const floating = document.getElementById('inventoryFloatingHScroll');
      if (!wrap || !floating) return;
      showInventoryFloatingScroll();
      scheduleHideInventoryFloatingScroll();
      if (Math.abs(wrap.scrollLeft - floating.scrollLeft) > 1) {
        wrap.scrollLeft = floating.scrollLeft;
      }
      inventoryLastScrollLeft = floating.scrollLeft;
      if (totalWrap && !totalWrap.classList.contains('is-empty')) {
        totalWrap.scrollLeft = floating.scrollLeft;
      }
    }

    function showInventoryFloatingScroll() {
      clearTimeout(inventoryFloatingHideTimer);
      if (!inventorySheetExpanded) return;
      document.getElementById('inventoryFloatingHScroll')?.classList.add('is-visible');
    }

    function scheduleHideInventoryFloatingScroll() {
      clearTimeout(inventoryFloatingHideTimer);
      if (!inventorySheetExpanded) return;
      inventoryFloatingHideTimer = setTimeout(() => {
        document.getElementById('inventoryFloatingHScroll')?.classList.remove('is-visible');
      }, 450);
    }

    function handleInventoryPanelPointerMove(event) {
      if (!inventorySheetExpanded) return;
      const panel = document.getElementById('inventorySheetPanel');
      if (!panel) return;
      const rect = panel.getBoundingClientRect();
      if (event.clientY >= rect.bottom - 26) {
        showInventoryFloatingScroll();
        return;
      }
      scheduleHideInventoryFloatingScroll();
    }

    function fillInventorySheetPlaceholderRows(columns, wrap, dataRowCount) {
      if (!wrap || !columns.length || dataRowCount <= 0) return;
      const table = wrap.querySelector('.inventory-sheet-table');
      const thead = table?.querySelector('thead');
      const tbody = table?.querySelector('tbody');
      if (!table || !thead || !tbody) return;

      const bodyViewportHeight = Math.max(0, wrap.clientHeight - thead.offsetHeight);
      const bodyContentHeight = tbody.offsetHeight;
      const rowHeight = 28;
      const missingHeight = bodyViewportHeight - bodyContentHeight;
      const fillerCount = Math.max(0, Math.ceil(missingHeight / rowHeight));
      if (!fillerCount) return;

      const fillerHtml = Array.from({ length: fillerCount }, () => `
        <tr class="inventory-placeholder-row">
          ${columns.map((column, columnIndex) => `<td class="${getInventoryColumnClass(column)}"${getInventoryColumnDataset(column, columnIndex)}></td>`).join('')}
        </tr>
      `).join('');
      tbody.insertAdjacentHTML('beforeend', fillerHtml);
      tbody.querySelectorAll('.inventory-placeholder-row td').forEach((cell) => {
        const columnIndex = Number(cell.getAttribute('data-col-index') || '-1');
        const column = columns[columnIndex];
        applyInventoryStickyZIndex(cell, columnIndex, column);
      });
    }

    function renderInventorySheetHeaderDatasets(columns, wrap) {
      const headRows = wrap.querySelectorAll('thead tr');
      if (!headRows.length) return;
      const firstRowCells = Array.from(headRows[0]?.children || []);
      const secondRowCells = Array.from(headRows[1]?.children || []);
      let columnIndex = 0;
      firstRowCells.forEach((cell) => {
        const span = Number(cell.getAttribute('colspan') || '1');
        const rowSpan = Number(cell.getAttribute('rowspan') || '1');
        if (rowSpan === 2) {
          const column = columns[columnIndex];
          cell.setAttribute('data-col-index', String(columnIndex));
          cell.setAttribute('data-col-kind', getInventoryColumnKind(column));
          const month = getInventoryColumnMonth(column);
          if (month) cell.setAttribute('data-col-month', String(month));
          applyInventoryStickyZIndex(cell, columnIndex, column);
          columnIndex += 1;
          return;
        }
        const column = columns[columnIndex];
        cell.setAttribute('data-col-index', String(columnIndex));
        cell.setAttribute('data-col-kind', getInventoryColumnKind(column));
        const month = getInventoryColumnMonth(column);
        if (month) cell.setAttribute('data-col-month', String(month));
        applyInventoryStickyZIndex(cell, columnIndex, column);
        columnIndex += span;
      });
      let secondRowIndex = 0;
      secondRowCells.forEach((cell) => {
        while (secondRowIndex < columns.length && String(columns[secondRowIndex]?.top || '').trim() && !String(columns[secondRowIndex]?.bottom || '').trim()) {
          secondRowIndex += 1;
        }
        const column = columns[secondRowIndex];
        const previousColumn = secondRowIndex > 0 ? columns[secondRowIndex - 1] : null;
        cell.setAttribute('data-col-index', String(secondRowIndex));
        cell.setAttribute('data-col-kind', getInventoryColumnKind(column));
        const month = getInventoryColumnMonth(column);
        if (month) cell.setAttribute('data-col-month', String(month));
        const previousMonth = previousColumn ? getInventoryColumnMonth(previousColumn) : null;
        cell.classList.toggle('is-month-group-start', !!month && month !== previousMonth);
        applyInventoryStickyZIndex(cell, secondRowIndex, column);
        secondRowIndex += 1;
      });
      wrap.querySelectorAll('tbody td').forEach((cell) => {
        const columnIndex = Number(cell.getAttribute('data-col-index') || '-1');
        const column = columns[columnIndex];
        applyInventoryStickyZIndex(cell, columnIndex, column);
      });
    }

    function bindInventoryHeaderFilters(columns, wrap) {
      const secondRowCells = Array.from(wrap.querySelectorAll('thead tr:last-child th'));
      const topRowCells = Array.from(wrap.querySelectorAll('thead tr:first-child th[rowspan="2"]'));
      const filterableCells = [...topRowCells, ...secondRowCells];
      filterableCells.forEach((cell) => {
        const columnIndex = Number(cell.getAttribute('data-col-index') || '-1');
        const column = columns[columnIndex];
        if (!column?.key) return;
        const fieldId = `inventory:${column.key}`;
        cell.classList.add('inventory-filterable');
        cell.setAttribute('data-inventory-filter', fieldId);
        cell.classList.toggle('is-filtered', hasInventoryFilterState(fieldId));
        cell.classList.toggle('is-active', !hasInventoryFilterState(fieldId) && inventoryHeaderSort.key === column.key);
        cell.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          toggleInventoryHeaderFilter(fieldId, cell);
        });
      });
    }

    function toggleInventoryHeaderFilter(fieldId, trigger) {
      if (selectField === fieldId && selectPop.classList.contains('show')) {
        closeSelect();
        return;
      }
      closeCalendar();
      selectField = fieldId;
      positionInventoryHeaderFilterPop(trigger);
      renderSelectOptions(fieldId);
      selectPop.classList.add('show');
      trigger.classList.add('open');
    }

    function positionInventoryHeaderFilterPop(trigger) {
      const rect = trigger.getBoundingClientRect();
      const textRect = getInventoryHeaderTextRect(trigger) || rect;
      const popWidth = Math.max(rect.width, 210);
      const centerLeft = textRect.left + (textRect.width / 2) - (popWidth / 2);
      const maxLeft = window.innerWidth - popWidth - 12;
      selectPop.style.minWidth = '0px';
      selectPop.style.width = `${popWidth}px`;
      selectPop.style.left = `${Math.max(12, Math.min(centerLeft, maxLeft))}px`;
      selectPop.style.top = `${textRect.bottom + 8}px`;
    }

    function getInventoryHeaderTextRect(trigger) {
      if (!trigger) return null;
      const walker = document.createTreeWalker(trigger, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          return String(node?.textContent || '').trim()
            ? NodeFilter.FILTER_ACCEPT
            : NodeFilter.FILTER_SKIP;
        }
      });
      const textNode = walker.nextNode();
      if (!textNode) return null;
      const range = document.createRange();
      range.selectNodeContents(textNode);
      const rects = range.getClientRects();
      if (rects && rects.length) {
        return rects[0];
      }
      return range.getBoundingClientRect();
    }

    function applyInventoryHeaderFilters(columns, rows) {
      const activeFilters = columns
        .map((column, index) => {
          const fieldId = `inventory:${column?.key || ''}`;
          return { column, index, fieldId, values: inventoryHeaderFilters[fieldId] || [] };
        })
        .filter((item) => item.column?.key && hasInventoryFilterState(item.fieldId));

      if (!activeFilters.length) return rows;

      return rows.filter((row) => activeFilters.every((filter) => {
        const rawValue = String(row?.[filter.index] ?? '').trim();
        const valueKey = rawValue || '__blank__';
        return filter.values.includes(valueKey);
      }));
    }

    function sortInventoryRows(rows, columns) {
      if (!inventoryHeaderSort.key || !inventoryHeaderSort.dir) return rows;
      const columnIndex = columns.findIndex((column) => String(column?.key || '') === inventoryHeaderSort.key);
      if (columnIndex < 0) return rows;
      const direction = inventoryHeaderSort.dir === 'desc' ? -1 : 1;
      return [...rows].sort((rowA, rowB) => direction * compareInventoryCellValue(rowA?.[columnIndex], rowB?.[columnIndex]));
    }

    function compareInventoryCellValue(a, b) {
      const rawA = String(a ?? '').trim();
      const rawB = String(b ?? '').trim();
      if (!rawA && !rawB) return 0;
      if (!rawA) return 1;
      if (!rawB) return -1;
      const numA = Number(rawA);
      const numB = Number(rawB);
      const bothNumeric = !Number.isNaN(numA) && !Number.isNaN(numB) && rawA !== '' && rawB !== '';
      if (bothNumeric) return numA - numB;
      return rawA.localeCompare(rawB, 'zh-CN-u-kn-true');
    }

    function applyInventoryStickyZIndex(cell, columnIndex, column) {
      if (!cell || !column) return;
      const kind = getInventoryColumnKind(column);
      const isHeaderCell = cell.tagName === 'TH';
      if (kind === 'item') {
        cell.style.zIndex = isHeaderCell ? '120' : '60';
        return;
      }
      if (kind === 'carry') {
        cell.style.zIndex = String((isHeaderCell ? 100 : 30) + columnIndex);
        return;
      }
      if (kind === 'unit' || kind === 'price' || kind === 'item') {
        cell.style.zIndex = String((isHeaderCell ? 95 : 20) + columnIndex);
      }
    }

    function getInventoryColumnDataset(column, columnIndex) {
      const attrs = [` data-col-index="${columnIndex}"`, ` data-col-kind="${getInventoryColumnKind(column)}"`];
      const month = getInventoryColumnMonth(column);
      if (month) attrs.push(` data-col-month="${month}"`);
      return attrs.join('');
    }

    function getInventoryColumnKind(column) {
      const top = String(column?.top || '').trim();
      const bottom = String(column?.bottom || '').trim();
      if (top === '物品名称') return 'item';
      if (top === '单价') return 'price';
      if (top === '单位') return 'unit';
      if (/^\d{1,2}月结转盘存$/.test(top) || top === '12月结转盘存') return 'carry';
      if (/^\d{1,2}月份$/.test(top) || bottom === '入库' || bottom === '出库' || bottom === '结存') return 'month';
      return 'other';
    }

    function getInventoryColumnMonth(column) {
      const top = String(column?.top || '').trim();
      const bottom = String(column?.bottom || '').trim();
      const carryMatch = top.match(/^(\d{1,2})月结转盘存$/);
      if (carryMatch) return Number(carryMatch[1]);
      const monthMatch = top.match(/^(\d{1,2})月份$/);
      if (monthMatch) return Number(monthMatch[1]);
      if (bottom === '入库' || bottom === '出库' || bottom === '结存') return null;
      return null;
    }

    function getInventoryColumnClass(column) {
      const top = String(column?.top || '').trim();
      const bottom = String(column?.bottom || '').trim();
      if (top === '物品名称') return 'col-item';
      if (top === '单价') return 'col-price';
      if (top === '单位') return 'col-unit';
      if (/^\d{1,2}月结转盘存$/.test(top) || top === '12月结转盘存') return 'col-carry';
      if (/^\d{1,2}月份$/.test(top) || bottom === '入库' || bottom === '出库' || bottom === '结存') return 'col-month';
      return '';
    }

    function getInventoryColumnWidth(column) {
      const top = String(column?.top || '').trim();
      if (top === '物品名称') return 100;
      if (/^\d{1,2}月结转盘存$/.test(top) || top === '12月结转盘存') return 80;
      return 50;
    }

    function getInventoryTableWidth(columns) {
      return columns.reduce((sum, column) => sum + getInventoryColumnWidth(column), 0);
    }

    function getInventoryColumnFlex(column) {
      const top = String(column?.top || '').trim();
      if (top === '物品名称') return 2;
      if (/^\d{1,2}月结转盘存$/.test(top) || top === '12月结转盘存') return 2;
      return 1;
    }

    function getInventoryTableStyle(columns) {
      if (inventorySheetExpanded) {
        const width = getInventoryTableWidth(columns);
        return `width:${width}px;min-width:${width}px;max-width:${width}px`;
      }
      return 'width:100%;min-width:100%;max-width:100%';
    }

    function getInventoryColumnStyle(column, columns) {
      if (inventorySheetExpanded) {
        return `width:${getInventoryColumnWidth(column)}px`;
      }
      const totalFlex = columns.reduce((sum, item) => sum + getInventoryColumnFlex(item), 0) || 1;
      const width = ((getInventoryColumnFlex(column) / totalFlex) * 100).toFixed(4);
      return `width:${width}%`;
    }


    function getVisibleInventorySheet(columns, rows) {
      const currentMonth = Number(inventoryCompactMonth) || (new Date().getMonth() + 1);
      const previousMonth = currentMonth === 1 ? 12 : currentMonth - 1;
      const baseIndexes = [];
      const carryIndexes = [];
      const monthIndexes = [];
      const carryMonthSeen = new Set();
      const findOwnerMonth = (columnIndex) => {
        for (let pointer = columnIndex; pointer >= 0; pointer -= 1) {
          const top = String(columns[pointer]?.top || '').trim();
          const match = top.match(/^(\d{1,2})月份$/);
          if (match) return Number(match[1]);
          if (top) break;
        }
        return null;
      };

      columns.forEach((column, index) => {
        const top = String(column?.top || '').trim();
        const bottom = String(column?.bottom || '').trim();
        const monthMatch = top.match(/^(\d{1,2})月份$/);
        const carryMatch = top.match(/^(\d{1,2})月结转盘存$/);

        if (top === '校对') {
          return;
        }

        if (monthMatch) {
          const month = Number(monthMatch[1]);
          if (month === currentMonth) {
            monthIndexes.push(index);
          }
          return;
        }

        if (carryMatch) {
          const month = Number(carryMatch[1]);
          if (month === previousMonth && !carryMonthSeen.has(month)) {
            carryMonthSeen.add(month);
            carryIndexes.push(index);
          }
          return;
        }

        if (bottom === '入库' || bottom === '出库' || bottom === '结存') {
          const ownerMonth = findOwnerMonth(index);
          if (ownerMonth && ownerMonth === currentMonth) {
            monthIndexes.push(index);
          }
          return;
        }

        baseIndexes.push(index);
      });
      const visibleIndexes = [...baseIndexes, ...carryIndexes, ...monthIndexes];

      return {
        columns: visibleIndexes.map((index) => columns[index]),
        rows: rows.map((row) => visibleIndexes.map((index) => row[index] ?? ''))
      };
    }

    function getInventorySheetByDateRange(payload, columns, rows) {
      const startValue = document.getElementById('inventoryStartDate').value;
      const endValue = document.getElementById('inventoryEndDate').value;
      const startDate = startValue ? new Date(`${startValue}T00:00:00`) : null;
      const endDate = endValue ? new Date(`${endValue}T00:00:00`) : null;
      const sheetYear = getInventorySheetYear(payload);
      const startYear = startDate ? startDate.getFullYear() : sheetYear;
      const endYear = endDate ? endDate.getFullYear() : sheetYear;
      const safeStartYear = Math.min(startYear, endYear);
      const safeEndYear = Math.max(startYear, endYear);

      if (sheetYear && (sheetYear < safeStartYear || sheetYear > safeEndYear)) {
        return { columns: [], rows: [] };
      }

      const effectiveStartMonth = startDate && startYear === sheetYear ? (startDate.getMonth() + 1) : 1;
      const effectiveEndMonth = endDate && endYear === sheetYear ? (endDate.getMonth() + 1) : 12;
      const safeStartMonth = Math.min(effectiveStartMonth, effectiveEndMonth);
      const safeEndMonth = Math.max(effectiveStartMonth, effectiveEndMonth);
      const visibleIndexes = [];

      const findOwnerMonth = (columnIndex) => {
        for (let pointer = columnIndex; pointer >= 0; pointer -= 1) {
          const top = String(columns[pointer]?.top || '').trim();
          const match = top.match(/^(\d{1,2})月份$/);
          if (match) return Number(match[1]);
          if (top) break;
        }
        return null;
      };

      columns.forEach((column, index) => {
        const top = String(column?.top || '').trim();
        const bottom = String(column?.bottom || '').trim();
        const monthMatch = top.match(/^(\d{1,2})月份$/);
        const carryMatch = top.match(/^(\d{1,2})月结转盘存$/);

        if (top === '校对') return;

        if (monthMatch) {
          const month = Number(monthMatch[1]);
          if (month >= safeStartMonth && month <= safeEndMonth) {
            visibleIndexes.push(index);
          }
          return;
        }

        if (carryMatch) {
          const month = Number(carryMatch[1]);
          if (month >= safeStartMonth && month <= safeEndMonth) {
            visibleIndexes.push(index);
          }
          return;
        }

        if (bottom === '入库' || bottom === '出库' || bottom === '结存') {
          const ownerMonth = findOwnerMonth(index);
          if (ownerMonth && ownerMonth >= safeStartMonth && ownerMonth <= safeEndMonth) {
            visibleIndexes.push(index);
          }
          return;
        }

        visibleIndexes.push(index);
      });

      return {
        columns: visibleIndexes.map((index) => columns[index]),
        rows: rows.map((row) => visibleIndexes.map((index) => row[index] ?? ''))
      };
    }

    function getInventorySheetYear(payload) {
      const candidates = [
        String(payload?.sheet_name || '').trim(),
        String(payload?.title || '').trim()
      ];
      for (const candidate of candidates) {
        const match = candidate.match(/(20\d{2})/);
        if (match) return Number(match[1]);
      }
      return new Date().getFullYear();
    }

