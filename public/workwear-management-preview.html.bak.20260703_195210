<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>工服管理工作台 - 兴利汽车模具</title>
  <link rel="stylesheet" href="css/theme.css">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{
      height:100%;
      scrollbar-width:none;
      -ms-overflow-style:none
    }
    html::-webkit-scrollbar,
    body::-webkit-scrollbar{
      width:0;
      height:0
    }
    body{
      min-height:100vh;
      background:
        radial-gradient(circle at 8% 8%,rgba(101,179,255,.18),transparent 28%),
        linear-gradient(135deg,#f4f9ff 0%,#eef7ff 52%,#f8fbff 100%);
      color:var(--text);
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",sans-serif;
      overflow:hidden
    }
    .container{
      max-width:1760px;
      height:100%;
      margin:0 auto;
      padding:18px 26px 30px;
      display:flex;
      flex-direction:column;
      min-height:0
    }
    .topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:12px}
    .title-wrap{display:flex;align-items:center;gap:14px}
    .mark{
      width:48px;height:48px;border-radius:16px;
      background:linear-gradient(135deg,#4a90e2,#22c58d);
      display:flex;align-items:center;justify-content:center;
      color:#fff;font-size:22px;font-weight:800;
      box-shadow:0 14px 30px rgba(74,144,226,.24)
    }
    .page-title{font-size:25px;font-weight:800;letter-spacing:0;color:#14245a}
    .page-subtitle{font-size:13px;color:var(--text-soft);margin-top:3px}
    .actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .btn{
      border:0;border-radius:12px;padding:10px 15px;font-size:13px;font-weight:700;
      cursor:pointer;transition:.18s;background:#fff;color:var(--text);
      box-shadow:0 8px 20px rgba(74,144,226,.10);
      border:1px solid rgba(214,233,255,.95)
    }
    .btn:hover{transform:translateY(-1px);box-shadow:0 12px 28px rgba(74,144,226,.16)}
    .btn.primary{background:linear-gradient(135deg,#4a90e2,#65b3ff);color:#fff;border-color:transparent}
    .btn.ghost{background:rgba(255,255,255,.62)}
    .content-layout{
      display:grid;
      grid-template-columns:minmax(880px,1fr) 580px;
      gap:16px;
      align-items:stretch;
      min-height:0;
      flex:1
    }
    .left-column{
      display:flex;
      flex-direction:column;
      gap:8px;
      min-width:0;
      min-height:0;
      flex:1;
      height:100%
    }
    .metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
    .metric{
      min-height:58px;display:flex;flex-direction:column;align-items:center;justify-content:center;
      text-align:center;background:rgba(255,255,255,.82);border:1px solid rgba(214,233,255,.9);
      border-radius:12px;padding:6px 8px;box-shadow:0 6px 14px rgba(74,144,226,.08)
    }
    .metric-label{font-size:11px;color:var(--text-soft);font-weight:700}
    .metric-value{font-size:20px;font-weight:850;margin-top:4px;color:#14245a;line-height:1}
    .metric.blue .metric-value{color:#4a90e2}
    .metric.orange .metric-value{color:#b77900}
    .metric.green .metric-value{color:#16a765}
    .metric.red .metric-value{color:#dc2626}
    .panel{
      background:rgba(255,255,255,.9);
      border:1px solid rgba(214,233,255,.95);
      border-radius:24px;
      box-shadow:0 18px 48px rgba(52,96,160,.14)
    }
    .list-panel,.detail-panel{display:flex;flex-direction:column}
    .list-panel{
      flex:1;
      min-height:0;
      height:100%;
      box-shadow:none;
      overflow:hidden
    }
    .detail-panel{
      box-shadow:none;
      gap:12px;
      background:transparent;
      border:0;
      border-radius:0;
      padding:0;
      min-height:0;
      display:flex;
      flex-direction:column;
      height:100%
    }
    .panel-head{
      display:flex;align-items:center;justify-content:space-between;gap:12px;
      padding:17px 20px;border-bottom:1px solid rgba(214,233,255,.9);
      background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(248,251,255,.78))
    }
    .panel-title{font-size:16px;font-weight:900;color:#14245a;letter-spacing:0}
    .muted{color:var(--text-soft);font-size:12px}
    .list-tools{
      display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,.9fr) minmax(0,1.02fr) minmax(0,.72fr) minmax(0,.72fr) minmax(0,.78fr) 154px;gap:8px;
      align-items:end;padding:12px 14px;border-bottom:1px solid rgba(214,233,255,.9);
      background:rgba(248,251,255,.86);
      border-top-left-radius:24px;
      border-top-right-radius:24px
    }
    .list-tools .actions{justify-content:flex-end;flex-wrap:nowrap}
    .field{display:flex;flex-direction:column;gap:5px}
    .field label{font-size:11px;color:var(--text-soft);font-weight:700}
    .list-tools .select-field label,
    .list-tools .date-field label{
      text-align:center
    }
    .input{
      height:38px;border:1px solid var(--border);border-radius:12px;background:#fff;
      padding:0 11px;color:var(--text);font-size:13px;outline:none
    }
    .input:focus{border-color:#4a90e2;box-shadow:0 0 0 3px rgba(74,144,226,.12)}
    .select-field{position:relative}
    .select-field .input{padding-right:40px;cursor:pointer;background:#fff}
    .select-field .input,
    .date-trigger{
      text-align:center;
      text-align-last:center
    }
    .select-field::before{
      content:"";position:absolute;right:16px;bottom:18px;width:5px;height:5px;
      border-right:1.6px solid #5b72a9;border-bottom:1.6px solid #5b72a9;transform:rotate(45deg);
      pointer-events:none;z-index:1
    }
    .native-select{display:none}
    .select-trigger{display:flex;align-items:center;justify-content:center;width:100%;text-align:center}
    .select-trigger span{display:block;width:100%;text-align:center}
    .select-trigger.open{border-color:#4a90e2;box-shadow:0 0 0 3px rgba(74,144,226,.12)}
    .select-trigger:disabled{
      cursor:not-allowed;opacity:.55;background:#f7fbff;color:#8aa0c3;box-shadow:none
    }
    .date-field{position:relative}
    .date-trigger{position:relative;padding-right:34px;cursor:pointer}
    .date-trigger::after{
      content:"";position:absolute;right:12px;top:50%;width:14px;height:14px;transform:translateY(-50%);
      border:1.8px solid #5b72a9;border-radius:3px;box-sizing:border-box
    }
    .date-trigger::before{
      content:"";position:absolute;right:15px;top:calc(50% - 4px);width:8px;height:2px;background:#5b72a9;
      box-shadow:0 4px 0 #5b72a9
    }
    .calendar-pop{
      position:fixed;z-index:1200;width:250px;background:#fff;border:1px solid rgba(214,233,255,.95);
      border-radius:18px;box-shadow:0 20px 50px rgba(29,43,90,.18);padding:12px;display:none
    }
    .calendar-pop.show{display:block}
    .calendar-pop.is-month-picker{width:210px}
    .select-pop{
      position:fixed;z-index:1200;min-width:220px;background:#fff;border:1px solid rgba(214,233,255,.95);
      border-radius:18px;box-shadow:0 20px 50px rgba(29,43,90,.18);padding:10px;display:none
    }
    .select-pop.show{display:block}
    .select-options{display:flex;flex-direction:column;gap:6px;max-height:280px;overflow:auto}
    .select-options.hide-scrollbar{
      scrollbar-width:none;
      -ms-overflow-style:none
    }
    .select-options.hide-scrollbar::-webkit-scrollbar{
      width:0;
      height:0
    }
    .select-option{
      border:0;background:#fff;border-radius:12px;padding:10px 12px;color:#14245a;
      font-size:13px;font-weight:800;cursor:pointer;transition:.15s;
      display:flex;align-items:center;justify-content:flex-start;gap:10px;text-align:left
    }
    .select-option:hover{background:#eef6ff}
    .select-option.active{background:#eef6ff;color:#14245a}
    .select-option-label{flex:1;text-align:center}
    .select-option.no-check{justify-content:center}
    .select-option-check{
      width:16px;height:16px;flex:0 0 auto;accent-color:#4a90e2;cursor:pointer
    }
    .select-option.active .select-option-check{accent-color:#4a90e2}
    .staff-suggest-pop{
      position:fixed;z-index:1250;min-width:240px;max-width:340px;background:#fff;
      border:1px solid rgba(214,233,255,.95);border-radius:18px;box-shadow:0 20px 50px rgba(29,43,90,.18);
      padding:8px;display:none
    }
    .staff-suggest-pop.show{display:block}
    .staff-suggest-list{
      display:flex;flex-direction:column;gap:6px;max-height:260px;overflow:auto;
      scrollbar-width:thin;scrollbar-color:rgba(74,144,226,.16) transparent
    }
    .staff-suggest-list::-webkit-scrollbar{width:6px}
    .staff-suggest-list::-webkit-scrollbar-track{background:transparent}
    .staff-suggest-list::-webkit-scrollbar-thumb{background:rgba(74,144,226,.16);border-radius:999px}
    .staff-suggest-item{
      width:100%;border:0;background:#fff;border-radius:14px;padding:10px 12px;cursor:pointer;
      display:flex;flex-direction:column;gap:4px;text-align:left;transition:.15s
    }
    .staff-suggest-item:hover,
    .staff-suggest-item.active{background:#eef6ff}
    .staff-suggest-name-row{
      display:flex;align-items:center;justify-content:flex-start;gap:8px
    }
    .staff-suggest-name{
      font-size:14px;font-weight:800;color:#14245a
    }
    .staff-suggest-emp{
      font-size:12px;font-weight:700;color:#5b72a9;white-space:nowrap
    }
    .staff-suggest-meta{
      font-size:12px;color:#5b72a9;font-weight:600;
      overflow:hidden;text-overflow:ellipsis;white-space:nowrap
    }
    .staff-suggest-kind{
      display:inline-flex;align-items:center;justify-content:center;
      min-width:36px;height:20px;padding:0 8px;border-radius:999px;
      font-size:11px;font-weight:800;color:#4a90e2;background:#eef6ff
    }
    .calendar-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .calendar-title{font-size:14px;font-weight:900;color:#14245a}
    .calendar-nav{
      display:flex;align-items:center;justify-content:center;width:30px;height:30px;border:1px solid rgba(214,233,255,.95);
      background:#f7fbff;border-radius:10px;color:#4a90e2;cursor:pointer;line-height:1;padding:0
    }
    .calendar-nav .chev{display:block;width:8px;height:8px;border-top:2px solid currentColor;border-right:2px solid currentColor}
    .calendar-nav.prev .chev{transform:translateX(1px) rotate(-135deg)}
    .calendar-nav.next .chev{transform:translateX(-1px) rotate(45deg)}
    .calendar-week,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
    .calendar-week{margin-bottom:6px}
    .calendar-week span{font-size:11px;color:var(--text-soft);text-align:center;padding:4px 0}
    .calendar-day{
      position:relative;height:34px;border:0;background:transparent;border-radius:10px;color:#14245a;
      font-size:12px;font-weight:700;cursor:pointer
    }
    .calendar-day:hover{background:#eef6ff}
    .calendar-day.today{
      box-shadow:inset 0 0 0 1.5px rgba(74,144,226,.42);
      background:rgba(238,246,255,.55)
    }
    .calendar-day.selected{background:linear-gradient(135deg,#4a90e2,#65b3ff);color:#fff}
    .calendar-pop.is-month-picker .calendar-week{display:none}
    .calendar-pop.is-month-picker .calendar-grid{grid-template-columns:repeat(3,1fr);gap:10px}
    .calendar-month{
      height:30px;border:1px solid rgba(214,233,255,.95);background:#fff;border-radius:12px;color:#14245a;
      font-size:11px;font-weight:800;cursor:pointer
    }
    .calendar-month:hover{background:#eef6ff}
    .calendar-month.selected{background:linear-gradient(135deg,#4a90e2,#65b3ff);border-color:transparent;color:#fff}
    .calendar-month.is-disabled{
      color:#aab6d1;background:#f7f9fd;border-color:rgba(226,234,247,.95);cursor:not-allowed
    }
    .calendar-month.is-disabled:hover{background:#f7f9fd}
    .calendar-pop.is-month-picker .calendar-footer{display:none}
    .calendar-pop.is-month-picker .calendar-nav{visibility:hidden;pointer-events:none}
    .calendar-footer{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;margin-top:10px}
    .calendar-prev-year,.calendar-today,.calendar-clear{border:0;background:transparent;font-size:12px;font-weight:800;cursor:pointer}
    .calendar-prev-year{justify-self:start;color:#5b72a9}
    .calendar-today{color:#4a90e2}
    .calendar-clear{justify-self:end;color:#5b72a9}
    .calendar-prev-year.is-hidden{visibility:hidden;pointer-events:none}
    .dept-pop{
      position:fixed;z-index:1200;width:200px;background:#fff;
      border:1px solid rgba(214,233,255,.95);border-radius:18px;box-shadow:0 20px 50px rgba(29,43,90,.18);
      padding:10px;display:none
    }
    .dept-pop.show{display:block}
    .dept-scroll{display:flex;flex-direction:column;gap:4px;overflow:auto;max-height:min(360px,calc(100vh - 210px));padding:1px}
    .dept-scroll,.position-options{
      scrollbar-width:thin;
      scrollbar-color:rgba(74,144,226,.1) transparent
    }
    .dept-scroll::-webkit-scrollbar,.position-options::-webkit-scrollbar{width:6px}
    .dept-scroll::-webkit-scrollbar-track,.position-options::-webkit-scrollbar-track{background:transparent}
    .dept-scroll::-webkit-scrollbar-thumb,.position-options::-webkit-scrollbar-thumb{
      background:rgba(74,144,226,.08);border-radius:999px
    }
    .dept-scroll:hover::-webkit-scrollbar-thumb,.position-options:hover::-webkit-scrollbar-thumb{
      background:rgba(74,144,226,.14)
    }
    .dept-option-row{
      position:relative;border-radius:12px
    }
    .dept-option,.position-option{
      border:0;background:#fff;padding:10px 12px;text-align:left;color:#14245a;
      font-size:13px;font-weight:800;cursor:pointer;transition:.15s;width:100%
    }
    .dept-option,.position-option{
      display:flex;align-items:center;justify-content:center;width:100%;border-radius:12px;min-height:40px;
      padding:10px 12px;line-height:20px;text-align:center;
      white-space:normal;word-break:break-all;overflow:visible
    }
    .dept-option-row:hover .dept-option{background:#eef6ff}
    .dept-option-row.selected .dept-option{background:linear-gradient(135deg,#4a90e2,#65b3ff);color:#fff}
    .dept-option-row.previewing{
      box-shadow:inset 0 0 0 1px rgba(74,144,226,.22)
    }
    .position-flyout{
      position:absolute;left:calc(100% - 2px);z-index:2;width:200px;display:none;padding:10px;
      background:#fff;border:1px solid rgba(214,233,255,.95);border-radius:18px;
      box-shadow:0 20px 50px rgba(29,43,90,.18);transform:translateY(8px)
    }
    .position-flyout.show{display:block}
    .position-flyout.open-left{left:auto;right:calc(100% - 2px)}
    .position-options{display:flex;flex-direction:column;gap:4px;overflow:auto;max-height:min(360px,calc(100vh - 210px));padding:1px}
    .dept-empty{
      display:flex;align-items:center;justify-content:center;min-height:72px;padding:14px;
      color:var(--text-soft);font-size:12px;font-weight:700;text-align:center;line-height:1.6
    }
    .link-btn{border:0;background:transparent;color:#4a90e2;font-size:12px;font-weight:800;cursor:pointer}
    .records-table-wrap{position:relative;overflow:auto;flex:1;min-height:0;height:0}
    .records-table-wrap::after{
      content:"加载中...";
      position:absolute;inset:0;
      display:flex;align-items:center;justify-content:center;
      background:rgba(255,255,255,.42);
      color:var(--text-soft);
      font-size:13px;font-weight:800;
      opacity:0;pointer-events:none;transition:opacity .15s
    }
    .list-panel.is-loading .records-table-wrap::after{opacity:1}
    table{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed}
    th{
      height:38px;text-align:center;padding:0 12px;color:var(--text-soft);font-size:11px;font-weight:850;
      border-bottom:1px solid rgba(214,233,255,.8);white-space:nowrap;
      background:rgba(248,251,255,.96);letter-spacing:0;
      position:sticky;top:0;z-index:2
    }
    thead th{box-shadow:0 1px 0 rgba(214,233,255,.85)}
    td{
      height:52px;padding:9px 12px;border-bottom:1px solid rgba(214,233,255,.62);
      font-size:13px;vertical-align:middle;background:rgba(255,255,255,.64)
    }
    th:nth-child(1),td:nth-child(1){width:90px;text-align:center}
    th:nth-child(2),td:nth-child(2){width:70px}
    th:nth-child(3),td:nth-child(3){width:118px}
    th:nth-child(4),td:nth-child(4){width:90px;text-align:center}
    th:nth-child(5),td:nth-child(5){width:90px;text-align:center}
    th:nth-child(6),td:nth-child(6){width:80px}
    th:nth-child(7),td:nth-child(7){width:50px;text-align:center}
    th:nth-child(8),td:nth-child(8){width:56px;text-align:center}
    th:nth-child(9),td:nth-child(9){width:72px;text-align:right}
    th:nth-child(10),td:nth-child(10){width:60px;text-align:right}
    th:nth-child(11),td:nth-child(11){width:92px;text-align:center}
    th:nth-child(12),td:nth-child(12){width:60px;text-align:center}
    th:nth-child(13),td:nth-child(13){width:60px;text-align:right}
    th:nth-child(14),td:nth-child(14){width:100px}
    td:nth-child(4),
    td:nth-child(5),
    td:nth-child(11){
      font-size:12px;
      white-space:nowrap
    }
    tbody tr{cursor:pointer;transition:.15s}
    tbody tr:hover td,tbody tr.active td{background:#f0f7ff}
    tbody tr.active td:first-child{box-shadow:inset 3px 0 0 #4a90e2}
    tbody tr.is-leave-row td{
      background:rgba(246,246,246,.92);
      border-bottom-color:rgba(218,218,218,.58);
    }
    tbody tr.is-leave-row:hover td,
    tbody tr.is-leave-row.active td{
      background:rgba(240,240,240,.96)
    }
    .cell-center{text-align:center}
    .remark-cell{font-size:12px}
    .cell-right{text-align:right}
    .amount-dash{
      display:block;
      width:100%;
      text-align:center
    }
    .records-table.is-settlement-collapsed th:nth-child(11),
    .records-table.is-settlement-collapsed td:nth-child(11),
    .records-table.is-settlement-collapsed th:nth-child(12),
    .records-table.is-settlement-collapsed td:nth-child(12),
    .records-table.is-settlement-collapsed th:nth-child(13),
    .records-table.is-settlement-collapsed td:nth-child(13){
      width:0 !important;
      min-width:0 !important;
      max-width:0 !important;
      padding-left:0 !important;
      padding-right:0 !important;
      opacity:0;
      visibility:hidden;
      overflow:hidden;
      border-left:0;
      border-right:0;
      border-bottom-color:transparent;
      white-space:nowrap
    }
    .records-table.is-settlement-collapsed th:nth-child(11),
    .records-table.is-settlement-collapsed th:nth-child(12),
    .records-table.is-settlement-collapsed th:nth-child(13){
      border-bottom-color:transparent;
      box-shadow:none
    }
    .person-main{font-size:14px;font-weight:900;color:#14245a;line-height:1.2}
    .dept-main{font-size:13px;font-weight:800;color:#14245a;line-height:1.3}
    .item-main{font-size:13px;font-weight:800;color:#14245a;line-height:1.3}
    .badge{
      display:inline-flex;align-items:center;justify-content:center;min-height:25px;padding:4px 10px;
      border-radius:999px;font-size:12px;font-weight:800;white-space:nowrap
    }
    .badge.blue{background:rgba(74,144,226,.14);color:#2563eb}
    .badge.orange{background:rgba(255,193,7,.20);color:#b77900}
    .badge.green{background:rgba(34,197,94,.14);color:#16a765}
    .pagination{display:flex;align-items:center;justify-content:space-between;padding:12px 16px}
    .pages{display:flex;gap:5px}
    .page-btn{
      min-width:30px;height:30px;border:1px solid var(--border);background:#fff;border-radius:9px;
      color:var(--text);cursor:pointer;
      display:inline-flex;align-items:center;justify-content:center;
      padding:0;line-height:1
    }
    .page-btn.active{background:#4a90e2;color:#fff;border-color:#4a90e2}
    .page-btn:disabled{opacity:0.5;cursor:not-allowed}
    .detail-body{
      padding:0;
      display:flex;
      flex-direction:column;
      gap:12px;
      overflow:hidden;
      min-height:0;
      flex:1
    }
    .detail-card:first-child{flex:1 1 auto;display:flex;flex-direction:column;overflow:hidden}
    .detail-card:last-child{flex:1 1 0;min-height:0;display:flex;flex-direction:column;margin-bottom:0}
    .detail-card:last-child .alert-list{flex:1;overflow:auto;min-height:0}
    .detail-card:last-child{overflow:hidden}
    .detail-card{
      background:linear-gradient(180deg,#fff,#f9fcff);
      border:1px solid rgba(214,233,255,.95);
      border-radius:18px;padding:14px;box-shadow:0 10px 28px rgba(74,144,226,.08)
    }
    .detail-title{font-size:14px;font-weight:900;color:#14245a;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between}
    .detail-title .more-btn{
      font-size:11px;font-weight:700;color:#4a90e2;
      background:rgba(255,255,255,.45);
