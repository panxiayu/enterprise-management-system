    function minimizeDrawer() {
      hideStaffSuggestions('drawer');
      const drawerEl = document.getElementById('drawer');
      const card = drawerEl?.querySelector('.workflow-card');
      const offset = getDrawerAnimationOffset();
      drawerMinimized = true;
      syncIssueDrawerTriggerState();
      if (!drawerEl || !card || !offset) {
        drawerEl?.classList.remove('show');
        drawerEl?.classList.add('is-minimized');
        return;
      }
      applyDrawerAnimationOffset(card, offset);
      card.classList.remove('is-restoring', 'is-minimizing');
      drawerEl.classList.add('is-minimizing');
      card.classList.add('is-minimizing');
      requestAnimationFrame(() => {
        card.style.willChange = 'transform,opacity';
        card.style.transform = `translate3d(${Math.round(offset.deltaX * .16)}px, ${Math.round(offset.deltaY * .16)}px, 0) scale(.97)`;
        card.style.opacity = '0';
      });
      window.setTimeout(() => {
        drawerEl.classList.remove('show', 'is-minimizing');
        drawerEl.classList.add('is-minimized');
        clearDrawerMotionState(card, true);
      }, 180);
    }

    function restoreDrawer() {
      drawerMinimized = false;
      const drawerEl = document.getElementById('drawer');
      const card = drawerEl?.querySelector('.workflow-card');
      const offset = getDrawerAnimationOffset();
      drawerEl.classList.remove('is-minimized');
