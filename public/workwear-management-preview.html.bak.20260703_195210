      selectedDepartments = [];
      selectedPositions = [];
      selectedTypes = [];
      document.getElementById('startDateFilter').value = '';
      document.getElementById('endDateFilter').value = '';
      syncDepartmentPositionOptions();
      syncSelectLabel('departmentFilter');
      syncSelectLabel('positionFilter');
      syncSelectLabel('typeFilter');
      recordItems = [];
      recordsPage = 1;
      recordsHasMore = true;
      recordsVisiblePage = 1;
      selectedRecordId = null;
      currentPage = 1;
