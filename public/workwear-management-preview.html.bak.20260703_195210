          const val = Number.isFinite(Number(target.value)) ? parseInt(target.value, 10) : 0;
          const delta = btn.dataset.step === 'plus' ? 1 : -1;
          if (target.id === 'drawerQty') {
            target.dataset.pristine = '0';
            const isSpecial = !!document.getElementById('drawerSpecialIssue')?.checked;
            if (isSpecial) {
              target.value = String(Math.max(-999, val + delta));
            } else {
              target.value = String(Math.max(0, val + delta));
            }
            syncDrawerQtyState();
            syncDrawerSelfPurchaseState();
            return;
          }
          target.value = String(val + delta);
        });
      });
      
      // 工作台高度同步
      window.addEventListener('load', syncWorkbenchHeights);
      window.addEventListener('resize', syncWorkbenchHeights);

      // 库存预警“更多”按钮
      const alertMoreBtn = document.getElementById('alertMoreBtn');
      if (alertMoreBtn) {
        alertMoreBtn.addEventListener('click', () => {
          alertsExpanded = !alertsExpanded;
          renderAlerts(allAlerts);
        });
      }
    }

