    function applyStaffSuggestion(target, staff) {
      if (target === 'list-search') {
        if (!staff) return;
        if (staff.suggest_type === 'staff') {
          const currentKeyword = document.getElementById('searchInput').value.trim();
          const useEmployeeIdOnly = /^\d+$/.test(currentKeyword);
          clearMatchedStaff('quick');
          selectedSearchStaff = {
            id: staff.id || null,
            employee_id: staff.employee_id || '',
            name: staff.name || ''
          };
          document.getElementById('searchInput').value = useEmployeeIdOnly
            ? (staff.employee_id || '')
            : (staff.name || '');
        } else {
          selectedSearchStaff = null;
          document.getElementById('searchInput').value = staff.keyword || staff.display_name || '';
        }
        hideStaffSuggestions(target);
        applyFilters();
        return;
      }
      const prefix = target === 'quick' ? 'form' : 'drawer';
      if (!staff) return;
      document.getElementById(`${prefix}EmployeeId`).value = staff.employee_id || '';
      document.getElementById(`${prefix}StaffNameInput`).value = staff.name || '';
      hideStaffSuggestions(target);
      verifyStaffIdentity(target);
