      height:34px;border:1px solid rgba(214,233,255,.95);border-radius:10px;background:#fff;
      display:grid;grid-template-columns:28px minmax(0,1fr) 28px;align-items:center;overflow:hidden;
      min-width:0
    }
    .purchase-qty-btn,
    .purchase-adjust-btn{
      border:0;background:transparent;color:#5b72a9;font-size:12px;font-weight:900;cursor:pointer;
      display:flex;align-items:center;justify-content:center;height:100%;line-height:1
    }
    .purchase-qty-input,
    .purchase-adjust-input{
      width:100%;min-width:0;border:0;outline:0;background:transparent;text-align:center;
      color:#14245a;font-weight:900;font-size:13px;padding:0;line-height:34px;
      -webkit-text-fill-color:#14245a;opacity:1
    }
    .purchase-row:hover{background:#f3f8ff;border-color:#b8d7ff}
    .purchase-row.is-filled{
      background:linear-gradient(135deg,rgba(74,144,226,.14),rgba(101,179,255,.06));
      border-color:#78b1ef;
      box-shadow:0 10px 22px rgba(74,144,226,.12)
    }
    .purchase-row.is-locked{
      background:linear-gradient(135deg,rgba(74,144,226,.1),rgba(255,255,255,.98));
      border-style:dashed
    }
    .purchase-row.is-filled .purchase-item-name{
      color:#0f2f74
    }
    .purchase-row.is-locked .purchase-item-name::after{
      content:" 已入库";
      color:#5b72a9;
      font-size:12px;
      font-weight:800
    }
    .purchase-item-name{font-size:13px;font-weight:950;color:#10245d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .purchase-item-meta{font-size:10px;font-weight:800;color:#7b90bd;margin-top:2px}
    .purchase-row input{
      height:34px;border:1px solid rgba(196,223,252,.95);border-radius:12px;background:#fff;
      text-align:center;font-weight:900;color:#10245d;outline:none
    }
    .purchase-row input[readonly]{
      background:#f5f9ff;
      color:#5b72a9;
      cursor:not-allowed
    }
    .purchase-row button:disabled{
      opacity:.45;
      cursor:not-allowed
    }
    .purchase-qty-stepper input,
    .purchase-adjust-stepper input{
      height:100%;
      border:0;
      border-radius:0
    }
    .purchase-unit{font-size:12px;font-weight:900;color:#506aa2;text-align:left}
    .purchase-owner{
      height:34px;border-radius:12px;display:grid;place-items:center;
      border:1px solid rgba(214,233,255,.95);background:#f8fbff;
      color:#1d4ed8;font-size:12px;font-weight:900;text-align:center;padding:0 8px
    }
    .purchase-summary{
      display:flex;align-items:center;gap:8px;flex-wrap:wrap;
      color:#506aa2;font-size:12px;font-weight:850
    }
    .purchase-summary-detail{
      display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 12px;width:100%;margin-top:2px
    }
    .purchase-summary-line{
      display:flex;align-items:center;justify-content:space-between;gap:10px;
      border:1px solid rgba(214,233,255,.72);border-radius:12px;background:rgba(248,251,255,.92);padding:6px 10px
    }
    .purchase-summary-line strong{font-size:12px;font-weight:900;color:#10245d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .purchase-summary-line span{font-size:11px;font-weight:900;color:#2563eb;white-space:nowrap}
    .purchase-chip{
      border:1px solid rgba(214,233,255,.95);border-radius:999px;background:#f8fbff;
      padding:5px 10px;color:#1d4ed8;font-size:12px;font-weight:900
    }
    .purchase-row.adjust{
      grid-template-columns:minmax(82px,1fr) 58px 74px 108px 30px
    }
    .purchase-original,.purchase-diff{
      height:34px;border-radius:12px;display:grid;place-items:center;
      border:1px solid rgba(214,233,255,.95);background:#f8fbff;
      color:#10245d;font-size:12px;font-weight:900
    }
    .purchase-adjust-value{
      height:34px;border:1px solid rgba(196,223,252,.95);border-radius:12px;background:#fff;
      text-align:center;font-weight:900;color:#10245d;outline:none
    }
    .purchase-adjust-stepper .purchase-diff{
      height:100%;
      border:0;
      border-radius:0;
      background:transparent
    }
    .purchase-diff.is-plus{color:#16a34a}
    .purchase-diff.is-minus{color:#dc2626}
    .special-card{
      display:flex;align-items:center;justify-content:space-between;gap:14px;
      border:1px dashed rgba(74,144,226,.38);border-radius:18px;background:rgba(240,247,255,.7);padding:12px 14px
    }
    .special-card strong{display:block;color:#10245d;font-size:14px;font-weight:950}
    .special-card span{display:block;color:#6a7fb2;font-size:11px;font-weight:800;margin-top:3px}
    .special-card.is-disabled{opacity:.55}
    .workflow-switch{display:inline-flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
    .workflow-switch input{display:none}
    .switch-track{
      width:46px;height:26px;border-radius:999px;background:#dfe8f4;position:relative;
      box-shadow:inset 0 1px 3px rgba(15,23,42,.08);transition:background .18s ease
    }
    .switch-track::after{
      content:'';position:absolute;width:20px;height:20px;left:3px;top:3px;border-radius:50%;
      background:#fff;box-shadow:0 2px 8px rgba(15,23,42,.16);transition:transform .18s ease
    }
    .workflow-switch input:checked + .switch-track{background:#4a90e2}
    .workflow-switch input:checked + .switch-track::after{transform:translateX(20px)}
    .workflow-switch input:disabled + .switch-track{opacity:.55}
    .export-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .export-card{
      border:1px solid rgba(214,233,255,.95);border-radius:18px;background:#fbfdff;padding:14px;
      display:flex;align-items:flex-start;gap:10px;cursor:pointer;transition:all .16s ease
    }
    .export-card:hover,.export-card.active{border-color:#4a90e2;background:#eef6ff;box-shadow:0 12px 28px rgba(74,144,226,.12)}
    .export-card input{margin-top:3px}
    .export-card strong{display:block;font-size:14px;font-weight:950;color:#10245d}
    .export-card span{display:block;margin-top:4px;font-size:11px;font-weight:800;color:#6a7fb2;line-height:1.45}
    .calendar-day.has-purchase::after{
      content:'';position:absolute;left:50%;bottom:3px;transform:translateX(-50%);
      width:5px;height:5px;border-radius:50%;background:#22c55e
    }
    .calendar-day{position:relative}
    .loading{display:flex;align-items:center;justify-content:center;padding:40px;color:var(--text-soft)}
    .empty-state{text-align:center;padding:40px;color:var(--text-soft)}
    @media(max-width:1200px){
      body{overflow:auto}
      .container{height:auto}
      .content-layout{grid-template-columns:1fr}
      .detail-panel{position:static;height:auto!important}
      .detail-body{height:auto!important;max-height:none!important}
      .metrics{grid-template-columns:repeat(2,1fr)}
      .list-tools{grid-template-columns:repeat(2,minmax(120px,1fr))}
    }
    @media(max-width:760px){
      .container{padding:14px}
      .topbar{align-items:flex-start;flex-wrap:wrap}
      .actions{width:100%;justify-content:flex-start}
      .metrics{grid-template-columns:repeat(2,1fr)}
      .list-tools{grid-template-columns:1fr}
      .detail-grid{grid-template-columns:1fr}
      .drawer-issue-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .drawer-issue-grid .field-span-2,
      .drawer-issue-grid .field-span-4{grid-column:1 / -1}
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="topbar">
      <div class="title-wrap">
        <div>
          <div class="page-title">工服管理工作台</div>
          <div class="page-subtitle">领用录入、库存预警、扣款追踪与工服盘存</div>
        </div>
      </div>
      <div class="actions">
        <button class="btn ghost" type="button" id="backBtn">返回</button>
        <button class="btn ghost" type="button" id="itemBaseBtn">基础物品</button>
        <button class="btn ghost" type="button" id="exportBtn">导出</button>
        <button class="btn ghost" type="button" data-open-drawer="purchase">采购入库</button>
        <button class="btn ghost" type="button" data-open-drawer="issue" id="issueDrawerTrigger">
          <span class="issue-trigger-label">新增领用</span>
        </button>
      </div>
    </div>

    <div class="content-layout">
      <div class="left-column">
        <div class="metrics">
          <div class="metric blue is-clickable" id="monthlyIssueMetricCard"><div class="metric-label">本月领用</div><div class="metric-value" id="metricStaff">-</div></div>
          <div class="metric orange is-clickable" id="inventoryMetricCard"><div class="metric-label">库存数量</div><div class="metric-value" id="metricAlert">-</div></div>
          <div class="metric green"><div class="metric-label">本月领用件数</div><div class="metric-value" id="metricItems">-</div></div>
          <div class="metric red"><div class="metric-label">待扣款金额</div><div class="metric-value" id="metricDeduction">-</div></div>
        </div>

        <div class="panel list-panel" id="recordsPanel">
          <div class="list-tools">
            <div class="field">
              <label>搜索</label>
              <input class="input" id="searchInput" placeholder="工号 / 姓名 / 全局搜索">
            </div>
            <div class="field select-field">
              <label>部门</label>
              <button type="button" class="input select-trigger" id="departmentFilterTrigger">
                <span id="departmentFilterLabel">全部部门</span>
              </button>
              <select class="native-select" id="departmentFilter">
                <option value="">全部部门</option>
              </select>
            </div>
            <div class="field select-field">
              <label>岗位</label>
              <button type="button" class="input select-trigger" id="positionFilterTrigger">
                <span id="positionFilterLabel">全部岗位</span>
              </button>
              <select class="native-select" id="positionFilter">
                <option value="">全部岗位</option>
              </select>
            </div>
            <div class="field date-field">
              <label>开始日期</label>
              <input class="input date-trigger" id="startDateFilter" placeholder="年 / 月 / 日" readonly>
            </div>
            <div class="field date-field">
              <label>结束日期</label>
              <input class="input date-trigger" id="endDateFilter" placeholder="年 / 月 / 日" readonly>
            </div>
            <div class="field select-field">
              <label>类型</label>
              <button type="button" class="input select-trigger" id="typeFilterTrigger">
                <span id="typeFilterLabel">全部类型</span>
              </button>
              <select class="native-select" id="typeFilter">
                <option value="">全部类型</option>
                <option value="夏工服">夏工服</option>
                <option value="冬工服">冬工服</option>
                <option value="劳保鞋">劳保鞋</option>
              </select>
            </div>
            <div class="actions">
              <button class="btn ghost" type="button" id="leaveSettlementBtn">离职扣款</button>
            </div>
          </div>
          <div class="records-table-wrap">
            <table class="records-table is-settlement-collapsed" id="recordsTable">
              <thead>
                <tr>
                  <th>领用人</th>
                  <th>部门</th>
                  <th>岗位</th>
                  <th>入职时间</th>
                  <th>领用日期</th>
                  <th>类别</th>
                  <th>型号</th>
                  <th>数量</th>
                  <th>单价(元)</th>
                  <th>自购(元)</th>
                  <th>离职日期</th>
                  <th>扣款比例</th>
                  <th>离职扣款</th>
                  <th>备注</th>
                </tr>
              </thead>
              <tbody id="recordsBody">
                <tr><td colspan="14" class="loading">加载中...</td></tr>
              </tbody>
            </table>
          </div>
          <div class="pagination">
            <div class="muted" id="paginationInfo">-</div>
            <div class="pages" id="paginationPages"></div>
          </div>
        </div>
      </div>

      <div class="detail-panel" id="detailPanel">
        <div class="detail-body" id="detailBody">
          <div class="detail-card quick-entry-card" id="quickEntryCard">
            <div class="detail-title">
              <span>快速录入</span>
              <button class="more-btn quick-entry-toggle" type="button" id="quickEntryToggle">展开快速录入</button>
            </div>
            <form class="form-grid quick-entry-body" id="quickForm">
              <div class="quick-intake">
                <div class="quick-search-bar">
                  <div class="quick-search-label">工号</div>
                  <input class="input" type="text" id="formEmployeeId" placeholder="请输入工号" autocomplete="off" inputmode="numeric">
                  <div class="quick-search-label">姓名</div>
                  <input class="input" type="text" id="formStaffNameInput" placeholder="请输入姓名" autocomplete="off">
                  <button class="quick-query-btn" type="button" id="quickLookupBtn">历史查询</button>
                </div>
                <input type="hidden" id="formStaffId">
                <input type="hidden" id="formEmployeeIdHidden">
                <input type="hidden" id="formStaffName">
                <div class="quick-profile">
                  <div class="quick-profile-item">
                    <div class="quick-profile-label">部门</div>
                    <div class="quick-profile-value" id="formDepartment">-</div>
                  </div>
                  <div class="quick-profile-item">
                    <div class="quick-profile-label">岗位</div>
                    <div class="quick-profile-value" id="formPosition">-</div>
                  </div>
                  <div class="quick-profile-item">
                    <div class="quick-profile-label">入职日期</div>
                    <div class="quick-profile-value" id="formHireDate">-</div>
                  </div>
                  <div class="quick-profile-item">
                    <div class="quick-profile-label">性别</div>
                    <div class="quick-profile-value" id="formGender">-</div>
                  </div>
                </div>
                <div class="quick-issue-shell">
                  <div class="quick-matrix">
                    <div class="quick-matrix-head">
                      <div>类型</div>
                      <div>可领用</div>
                      <div>选择</div>
                      <div>类别</div>
                      <div>型号</div>
                      <div>数量</div>
                      <div>自购</div>
                    </div>
                    <div class="quick-matrix-list" id="quickMatrixList"></div>
                  </div>
                  <div class="quick-submit-row">
                    <button class="submit-btn" type="submit">确认领用</button>
                  </div>
                </div>
                <div class="settlement-panel" id="settlementPanel">
                  <div class="settlement-head">
                    <div class="settlement-title">离职办理</div>
                    <div class="settlement-hint" id="settlementHint">请先在快速录入确认人员，再选择离职日期</div>
                  </div>
                  <div class="settlement-grid">
                    <div class="settlement-field date-field">
                      <label>离职日期</label>
                      <input class="input date-trigger" id="settlementLeaveDate" placeholder="年 / 月 / 日" readonly>
                    </div>
                    <div class="settlement-field">
                      <label>扣款比例</label>
                      <div class="settlement-total" id="settlementRatio">-</div>
                    </div>
                    <div class="settlement-field">
                      <label>扣款金额</label>
                      <div class="settlement-total" id="settlementAmount">-</div>
                    </div>
                    <div class="settlement-field">
                      <label>操作</label>
                      <button class="btn ghost" type="button" id="settlementPreviewBtn">扣款核算</button>
                    </div>
                  </div>
                  <div class="settlement-actions">
                    <button class="btn primary" type="button" id="settlementConfirmBtn">确认扣款</button>
                  </div>
                </div>
              </div>
            </form>
          </div>

          <div class="detail-card approval-panel" id="inventoryApprovalPanel">
            <div class="detail-title">待我审核的差异项</div>
            <div class="approval-list" id="inventoryApprovalList"></div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <div class="calendar-pop" id="calendarPop">
    <div class="calendar-head">
      <button class="calendar-nav prev" type="button" id="calPrev"><span class="chev"></span></button>
      <div class="calendar-title" id="calTitle"></div>
      <button class="calendar-nav next" type="button" id="calNext"><span class="chev"></span></button>
    </div>
    <div class="calendar-week"><span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span></div>
    <div class="calendar-grid" id="calGrid"></div>
    <div class="calendar-footer"><button class="calendar-prev-year is-hidden" type="button" id="calPrevYear">上一年</button><button class="calendar-today" type="button" id="calToday">今日</button><button class="calendar-clear" type="button" id="calClear">清空</button></div>
  </div>

  <div class="select-pop" id="selectPop">
    <div class="select-options" id="selectOptions"></div>
  </div>

  <div class="staff-suggest-pop" id="staffSuggestPop">
    <div class="staff-suggest-list" id="staffSuggestList"></div>
  </div>

  <div class="drawer" id="drawer" aria-hidden="true">
    <div class="drawer-card workflow-card" role="dialog" aria-modal="true" aria-labelledby="drawerTitle">
      <div class="drawer-head">
        <div class="workflow-head-copy">
          <div class="drawer-title" id="drawerTitle">新增领用</div>
          <div class="workflow-subtitle">按工号与姓名确认人员</div>
        </div>
        <div class="drawer-head-actions">
          <button class="drawer-head-btn" type="button" id="drawerMinimizeBtn">悬浮页面</button>
          <button class="drawer-close" type="button" id="drawerClose">×</button>
        </div>
      </div>
      <div class="drawer-body workflow-body">
        <form id="drawerForm" class="workflow-body">
          <section class="workflow-panel">
            <div class="workflow-panel-title">人员信息</div>
            <div class="workflow-person">
              <div class="workflow-field">
                <label><span class="required">*</span>工号</label>
                <input class="input" type="text" id="drawerEmployeeId" placeholder="请输入工号" autocomplete="off" inputmode="numeric">
              </div>
              <div class="workflow-field">
                <label><span class="required">*</span>姓名</label>
                <input class="input" type="text" id="drawerStaffNameInput" placeholder="请输入姓名" autocomplete="off">
              </div>
              <button class="btn ghost" type="button" id="drawerLookupBtn">历史查询</button>
            </div>
            <input type="hidden" id="drawerStaffId">
            <input type="hidden" id="drawerEmployeeIdHidden">
            <input type="hidden" id="drawerStaffName">
            <div class="workflow-snapshot" style="margin-top:12px">
              <div class="snapshot-card"><span>部门</span><strong id="drawerDepartment">-</strong></div>
              <div class="snapshot-card"><span>岗位</span><strong id="drawerPosition">-</strong></div>
              <div class="snapshot-card"><span>入职日期</span><strong id="drawerHireDate">-</strong></div>
              <div class="snapshot-card"><span>性别</span><strong id="drawerGender">-</strong></div>
            </div>
          </section>

          <section class="workflow-panel">
            <div class="workflow-panel-title">领用信息</div>
            <div class="drawer-issue-grid">
              <div class="workflow-field">
                <label><span class="required">*</span>类别</label>
                <div class="drawer-quick-wrapper">
                  <button type="button" class="input select-trigger quick-picker drawer-picker" id="drawerItemNameTrigger">
                    <span id="drawerItemNameLabel">请选择</span>
                  </button>
                  <select class="native-select" id="drawerItemName" required></select>
                </div>
              </div>
              <div class="workflow-field">
                <label><span class="required">*</span>型号</label>
                <div class="drawer-quick-wrapper">
                  <button type="button" class="input select-trigger quick-picker drawer-picker" id="drawerModelTrigger">
                    <span id="drawerModelLabel">请选择</span>
                  </button>
                  <select class="native-select" id="drawerModel" required></select>
                </div>
              </div>
              <div class="workflow-field">
                <label><span class="required">*</span>数量</label>
                <div class="stepper">
                  <button type="button" data-step="minus" data-target="drawerQty">−</button>
                  <input id="drawerQty" type="text" value="0">
                  <button type="button" data-step="plus" data-target="drawerQty">+</button>
                </div>
              </div>
              <div class="workflow-field">
                <label><span class="required">*</span>领用时间</label>
                <input class="input date-trigger" id="drawerIssueDate" placeholder="年 / 月 / 日" readonly>
              </div>
              <div class="workflow-field">
                <label>是否自购</label>
                <div class="drawer-quick-wrapper">
                  <button type="button" class="input select-trigger quick-picker drawer-picker" id="drawerSelfPurchaseEnabledTrigger">
                    <span id="drawerSelfPurchaseEnabledLabel">否</span>
                  </button>
                  <select class="native-select" id="drawerSelfPurchaseEnabled">
                    <option value="0" selected>否</option>
                    <option value="1">是</option>
                  </select>
                </div>
              </div>
              <div class="workflow-field">
                <label>自购金额</label>
                <input class="input" id="drawerSelfPurchase" type="text" value="0" readonly>
              </div>
              <div class="workflow-field field-span-4">
                <label id="drawerRemarkLabel">备注</label>
                <input class="input" id="drawerRemark" type="text" placeholder="可选">
              </div>
            </div>
          </section>

          <section class="special-card" id="drawerSpecialCard">
            <div>
              <strong>特殊领用</strong>
              <span>用于报废、质量不佳退货等特殊场景；开启后数量可填负数，必须填写备注。</span>
            </div>
            <label class="workflow-switch">
              <input type="checkbox" id="drawerSpecialIssue">
              <span class="switch-track"></span>
            </label>
          </section>

          <button class="submit-btn" type="submit">确认领用</button>
        </form>
      </div>
    </div>
  </div>
  <div class="drawer" id="purchaseDrawer" aria-hidden="true">
    <div class="drawer-card workflow-card" role="dialog" aria-modal="true" aria-labelledby="purchaseTitle">
      <div class="drawer-head">
        <div class="workflow-head-copy">
          <div class="drawer-title" id="purchaseTitle">采购入库</div>
          <div class="workflow-subtitle" id="purchaseSubtitle">选择入库日期，填写在用基础物品的采购数量</div>
        </div>
        <div class="workflow-actions">
