    function getLeaveDateDisplay(record) {
      return record?.leave_date || '-';
    }

    const ALERT_DEFAULT_SHOW = 5;
    let allAlerts = [];
    let alertsExpanded = false;

    function renderAlerts(alerts) {
      const list = document.getElementById('alertList');
      const moreBtn = document.getElementById('alertMoreBtn');
      if (!list) return;
      allAlerts = alerts || [];
      
      if (allAlerts.length === 0) {
        list.innerHTML = '<div class="empty-state" style="padding:16px">暂无预警</div>';
        moreBtn.style.display = 'none';
        return;
      }
      
      const showAll = alertsExpanded || allAlerts.length <= ALERT_DEFAULT_SHOW;
      const visible = showAll ? allAlerts : allAlerts.slice(0, ALERT_DEFAULT_SHOW);
      
      if (allAlerts.length > ALERT_DEFAULT_SHOW) {
        moreBtn.style.display = '';
        moreBtn.textContent = showAll ? '收起' : `更多(${allAlerts.length - ALERT_DEFAULT_SHOW})`;
      } else {
        moreBtn.style.display = 'none';
      }
      
      list.innerHTML = visible.map(a => `
        <div class="alert-item">
          <span class="alert-dot"></span>
          <div class="alert-main"><strong>${a.item_name} ${a.model}</strong></div>
          <div class="alert-value">库存 ${a.stock}</div>
        </div>
      `).join('');
    }

    function renderPagination(total, currentPage) {
      const info = document.getElementById('paginationInfo');
      const pages = document.getElementById('paginationPages');
      
      const loaded = Math.min(Number(total || 0), recordItems.length);
      info.textContent = total > 0 ? `已加载 ${loaded} / ${total} 条` : '共 0 条';

      const totalPages = Math.max(1, Math.ceil(total / recordsPageSize));
      const loadedPages = Math.max(1, Math.ceil(recordItems.length / recordsPageSize));

      if (total <= recordsPageSize) {
        pages.innerHTML = '';
        return;
      }

      const startPage = Math.max(1, currentPage - 2);
      const endPage = Math.min(totalPages, startPage + 4);
      let html = `<button class="page-btn" ${currentPage <= 1 ? 'disabled' : ''} data-nav-page="${currentPage - 1}">‹</button>`;
      for (let page = startPage; page <= endPage; page += 1) {
        const isLoaded = page <= loadedPages;
        html += `<button class="page-btn ${page === currentPage ? 'active' : ''}" data-nav-page="${page}" ${!isLoaded && page !== loadedPages + 1 ? 'disabled' : ''}>${page}</button>`;
      }
      html += `<button class="page-btn" ${currentPage >= totalPages ? 'disabled' : ''} data-nav-page="${currentPage + 1}">›</button>`;
      pages.innerHTML = html;
      pages.querySelectorAll('[data-nav-page]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const targetPage = Number(btn.dataset.navPage || 0);
          if (!targetPage || targetPage === recordsVisiblePage) return;
          await jumpToRecordsPage(targetPage, totalPages);
        });
      });
    }

    function handleRecordsScroll(event) {
      const wrap = event.currentTarget;
      if (!wrap) return;
      updateVisibleRecordsPage(wrap);
      if (!recordsLoading && recordsHasMore && wrap.scrollTop + wrap.clientHeight >= wrap.scrollHeight - 120) {
        loadRecords(recordsPage + 1);
      }
    }

    function hasSettlementPreview() {
      return settlementPreviewMap.size > 0 || !!settlementPreviewSummary;
    }

    function isCurrentStaffHistoryFilter(staff) {
      if (!staff) return false;
      const filterStaffId = String(currentFilters?.staff_id || '').trim();
      const filterStaffName = String(currentFilters?.staff_name || '').trim();
      const targetStaffId = String(staff.id || staff.staff_id || '').trim();
      const targetStaffName = String(staff.name || staff.staff_name || '').trim();
      if (targetStaffId) {
        return filterStaffId === targetStaffId;
      }
      return !!targetStaffName && filterStaffName === targetStaffName;
    }


    function toggleSettlementColumns() {
      settlementColumnsExpanded = !settlementColumnsExpanded;
      const table = document.getElementById('recordsTable');
      const btn = document.getElementById('leaveSettlementBtn');
      const panel = document.getElementById('settlementPanel');
      if (!table || !btn || !panel) return;
      table.classList.toggle('is-settlement-collapsed', !settlementColumnsExpanded);
      btn.classList.toggle('primary', settlementColumnsExpanded);
      btn.classList.toggle('ghost', !settlementColumnsExpanded);
      panel.classList.toggle('show', settlementColumnsExpanded);
      if (!settlementColumnsExpanded) {
        const shouldRefreshRecords = hasSettlementPreview();
        settlementPreviewMap = new Map();
        settlementPreviewSummary = null;
        if (shouldRefreshRecords) {
          renderRecords(recordItems);
        }
      } else {
        const quickStaff = getSelectedStaffPayload('quick');
        if ((quickStaff.staff_id || quickStaff.staff_name) && !isCurrentStaffHistoryFilter({ id: quickStaff.staff_id, name: quickStaff.staff_name })) {
          applyQuickHistoryFilter({ id: quickStaff.staff_id, name: quickStaff.staff_name });
        }
      }
      updateSettlementPanel();
    }

    function updateSettlementPanel() {
      const panel = document.getElementById('settlementPanel');
      if (!panel) return;
      panel.classList.toggle('show', settlementColumnsExpanded);
      const settlementStaff = getSettlementStaffPayload();
      const hasStaff = !!(settlementStaff.staff_id || settlementStaff.staff_name);
      const ratioEl = document.getElementById('settlementRatio');
      const amountEl = document.getElementById('settlementAmount');
      const hintEl = document.getElementById('settlementHint');
      const previewBtn = document.getElementById('settlementPreviewBtn');
      const confirmBtn = document.getElementById('settlementConfirmBtn');

      if (!settlementColumnsExpanded) return;

      ratioEl.textContent = settlementPreviewSummary ? formatPercent(settlementPreviewSummary.deduction_ratio) : '-';
      amountEl.textContent = settlementPreviewSummary ? formatNumber(settlementPreviewSummary.total_deduction) : '-';
      hintEl.textContent = quickStaffLeaveLocked
        ? `当前人员：${settlementStaff.staff_name || '-'} 已离职，仅保留基本信息展示`
        : (hasStaff
          ? `当前人员：${settlementStaff.staff_name || '-'}，选择离职日期后可核算全部领用记录`
          : '请先在全局搜索或快速录入确认人员，再选择离职日期');
      previewBtn.disabled = quickStaffLeaveLocked || !hasStaff;
      confirmBtn.disabled = quickStaffLeaveLocked || !hasStaff || !settlementPreviewSummary;
    }

