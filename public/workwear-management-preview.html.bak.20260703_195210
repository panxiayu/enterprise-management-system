    function getItemCategoryLabel(item) {
      const name = String(item?.name || '').trim();
      const model = String(item?.model ?? '').trim();
      if (!name) return '-';
      if (!model || model === '-') return name;
      if (name.endsWith(model)) {
        const category = name.slice(0, name.length - model.length).trim();
        return category || name;
      }
      return name;
    }

    function getNormalizedBaseItems() {
      return ITEM_BASE_DATA.map((item) => ({
        ...item,
        category: getItemCategoryLabel(item),
        name: String(item.name || '').trim(),
        unit: String(item.unit || '').trim(),
        model: String(item.model ?? '').trim(),
        price: item.price === '' || item.price == null ? 0 : Number(item.price),
        is_active: item.is_active !== false
      }));
    }

    function getActiveNormalizedBaseItems() {
      return getNormalizedBaseItems().filter((item) => item.is_active !== false);
    }

    async function loadItemBaseData() {
      try {
        const res = await fetch(`${API_BASE}/items`);
        const data = await res.json();
        if (!res.ok || data.code !== 0) {
          throw new Error(data.msg || '加载基础物品失败');
        }
        ITEM_BASE_DATA = Array.isArray(data.data) ? data.data.map((item) => ({
          no: item.no ?? item.id,
          id: item.id,
          name: item.name || buildItemName(item.category, item.model),
          unit: item.unit || '',
          model: item.model || '',
          price: item.price ?? item.unit_price ?? 0,
          remark: item.remark || '',
          category: item.category || '',
          is_active: item.is_active !== false
        })) : [];
        refreshItemDerivedOptions();
      } catch (err) {
        console.error('加载基础物品失败:', err);
        ITEM_BASE_DATA = [];
        QUICK_ISSUE_DEFS = QUICK_GROUP_CONFIG.map((group) => ({ ...group, variants: [] }));
        initDrawerItemOptions();
        initQuickIssueBoard();
        resetQuickIssuePanel();
      }
    }

    function getBaseItemGroupKey(item) {
      const category = String(item.category || '').trim();
      const unit = String(item.unit || '').trim();
      if (unit === '双' || category.includes('鞋')) return 'shoes';
      if (category.includes('冬') || category.includes('春秋')) return 'winter';
      if (category.includes('夏')) return 'summer';
      return '';
    }

    function buildQuickIssueDefs() {
      const baseItems = getActiveNormalizedBaseItems();
      return QUICK_GROUP_CONFIG.map((group) => {
        const grouped = new Map();
        baseItems
          .filter((item) => getBaseItemGroupKey(item) === group.key)
          .forEach((item) => {
            if (!grouped.has(item.category)) {
              grouped.set(item.category, {
                label: item.category,
                unit_price: item.price || 0,
                models: []
              });
            }
            const variant = grouped.get(item.category);
            const normalizedModel = item.model && item.model !== '' ? item.model : '-';
            if (!variant.models.includes(normalizedModel)) {
              variant.models.push(normalizedModel);
            }
          });

        const variants = Array.from(grouped.values()).filter((variant) => variant.models.length);
        return {
          ...group,
          variants
        };
      });
    }

    function normalizeForItemKey(value) {
      return String(value == null ? '' : value).replace(/\s+/g, '').trim();
    }

    function findBaseItemByNameModel(name, model) {
      const itemName = normalizeForItemKey(name);
      const itemModel = normalizeForItemKey(model);
      if (!itemName && !itemModel) return null;
      return getActiveNormalizedBaseItems().find((item) => (
        normalizeForItemKey(item.name) === itemName &&
        normalizeForItemKey(item.model) === itemModel
      )) || null;
    }

    function findBaseCategoryByRecord(record) {
      const itemName = String(record?.item_name || '').trim();
      const itemModel = String(record?.model || '').trim();
      const matchedBaseItem = findBaseItemByNameModel(itemName, itemModel);
      if (matchedBaseItem?.category) return matchedBaseItem.category;

      const groupKey = getBaseItemGroupKey({
        category: getItemCategoryLabel({ name: itemName, model: itemModel }),
        name: itemName,
        unit: itemName.includes('鞋') ? '双' : '件'
      });

      if (groupKey === 'shoes') {
        const shoesMatch = getActiveNormalizedBaseItems().find((item) => (
          getBaseItemGroupKey(item) === 'shoes' &&
          normalizeForItemKey(item.model) === normalizeForItemKey(itemModel)
        ));
        if (shoesMatch?.category) return shoesMatch.category;
      }

      if (groupKey === 'summer' || groupKey === 'winter') {
        // 优先按 category 前缀匹配（兼容 item_name 形如「女夏39」直接拼接到 category 的旧数据），
        // 避免仅按 model 模糊匹配时拿到错误款式（如 model='39' 同时存在于「男夏」与「女夏」）。
        const clothesItems = getActiveNormalizedBaseItems().filter((item) => (
          getBaseItemGroupKey(item) === groupKey &&
          normalizeForItemKey(item.model) === normalizeForItemKey(itemModel)
        ));
        const recordCategory = getItemCategoryLabel({ name: itemName, model: itemModel });
        const prefixMatch = recordCategory
          ? clothesItems.find((item) => normalizeForItemKey(item.category) === normalizeForItemKey(recordCategory))
          : null;
        if (prefixMatch?.category) return prefixMatch.category;
        if (clothesItems[0]?.category) return clothesItems[0].category;
      }

      return '';
    }

    function findBaseItemForQuickSelection(groupKey, category, model) {
      const itemModel = String(model || '').trim();
      return getActiveNormalizedBaseItems().find((item) => (
        getBaseItemGroupKey(item) === groupKey &&
        String(item.category || '').trim() === String(category || '').trim() &&
        String(item.model || '').trim() === itemModel
      )) || null;
    }

    function initDrawerItemOptions() {
      const itemSelect = document.getElementById('drawerItemName');
      const modelSelect = document.getElementById('drawerModel');
