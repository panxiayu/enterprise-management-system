    async function previewLeaveSettlement() {
      if (quickStaffLeaveLocked) return;
      const panelEl = document.getElementById('settlementPanel');
      if (panelEl?.classList.contains('is-disabled')) return;
      const staff = getSettlementStaffPayload();
      const leaveDate = document.getElementById('settlementLeaveDate').value;
      if (!staff.staff_id || !staff.staff_name) {
        alert('请先确认离职人员');
        return;
      }
      if (!leaveDate) {
        alert('请先选择离职日期');
        return;
      }
      try {
        await focusSettlementStaffRecords({ id: staff.staff_id, name: staff.staff_name });
        const res = await fetch(`${API_BASE}/leave-deduction/preview`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            staff_id: staff.staff_id,
            staff_name: staff.staff_name,
            leave_date: leaveDate
          })
