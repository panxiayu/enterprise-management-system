    function getDownloadFilenameFromDisposition(headerValue, fallbackName) {
      const text = String(headerValue || '');
      const utf8Match = text.match(/filename\*=UTF-8''([^;]+)/i);
      if (utf8Match?.[1]) return decodeURIComponent(utf8Match[1]);
      const plainMatch = text.match(/filename="?([^";]+)"?/i);
      return plainMatch?.[1] || fallbackName;
    }

    async function printReport() {
      const reportType = document.querySelector('input[name="exportReportType"]:checked')?.value || 'issue';
      const params = newSearchParams();
      params.set('format', 'pdf');
      const fallbackName = `${reportType || 'workwear-report'}.pdf`;
      closeExportDrawer();
      openExportProgress();
      try {
        const response = await fetch(`${API_BASE}/export?${params.toString()}`);
        if (!response.ok) {
          let message = 'PDF 生成失败';
          try {
            const errorData = await response.json();
            message = errorData?.msg || errorData?.error || message;
          } catch (_) {}
          throw new Error(message);
        }
        setExportProgress(96, '正在打开 PDF…', 'PDF 已生成，正在准备预览。');
        const blob = await response.blob();
        const filename = getDownloadFilenameFromDisposition(response.headers.get('content-disposition'), fallbackName);
        const blobUrl = URL.createObjectURL(blob);
        const popup = window.open(blobUrl, '_blank');
        if (!popup) {
          const link = document.createElement('a');
          link.href = blobUrl;
          link.download = filename;
          document.body.appendChild(link);
          link.click();
          link.remove();
        }
        setExportProgress(100, 'PDF 已生成', '已按 Excel 模板转换完成。');
        setTimeout(() => {
          closeExportProgress();
          setTimeout(() => URL.revokeObjectURL(blobUrl), 60000);
        }, 420);
      } catch (err) {
        closeExportProgress();
        alert(err.message || 'PDF 生成失败');
      }
    }

    function getDrawerSelectedBaseItem() {
      const category = document.getElementById('drawerItemName').value;
      const model = document.getElementById('drawerModel').value;
      const normalizedModel = model === '-' ? '' : model;
      return getActiveNormalizedBaseItems().find((item) => (
        item.category === category &&
        String(item.model || '') === String(normalizedModel || '')
      )) || null;
    }

    function getItemPrice(itemName, model = '') {
      const matched = getNormalizedBaseItems().find((item) => item.name === itemName && String(item.model || '') === String(model || ''));
      return Number(matched?.price || 0);
    }

    function getItemType(itemName) {
      const matched = getNormalizedBaseItems().find((item) => item.name === itemName);
      if (!matched) return itemName.includes('鞋') ? '工鞋' : '工服';
      return matched.unit === '双' || itemName.includes('鞋') ? '工鞋' : '工服';
    }

    function getLocalDateValue() {
      const now = new Date();
      return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    }

    function getModelBadgeClass(record) {
      const itemName = String(record?.item_name || '').trim();
      if (itemName.includes('鞋')) return 'orange';
      if (itemName.includes('春秋') || itemName.includes('冬')) return 'green';
      return 'blue';
    }

    function formatNumber(num) {
      return (num || 0).toFixed(2);
    }

    function formatAmountOrDash(num, record) {
      if (!record?.leave_date) return '<span class="amount-dash">-</span>';
      const numeric = Number(num);
      if (!Number.isFinite(numeric)) return '<span class="amount-dash">-</span>';
      return numeric.toFixed(2);
    }

    function formatSelfPurchase(num) {
      const numeric = Number(num);
      if (!Number.isFinite(numeric) || numeric === 0) return '<span class="amount-dash">-</span>';
      return numeric.toFixed(2);
    }


    function formatPercent(num) {
      const numeric = Number(num);
      if (!Number.isFinite(numeric)) return '-';
      return `${Number.isInteger(numeric) ? numeric : numeric.toFixed(2)}%`;
    }

    function formatPercentOrDash(num, record) {
      if (!record?.leave_date) return '<span class="amount-dash">-</span>';
      const numeric = Number(num);
      if (!Number.isFinite(numeric)) return '<span class="amount-dash">-</span>';
      return `${Number.isInteger(numeric) ? numeric : numeric.toFixed(2)}%`;
    }

    function getAuthHeaders() {
      const token = localStorage.getItem('employee_token') || localStorage.getItem('token') || localStorage.getItem('adminToken');
      return token ? { Authorization: `Bearer ${token}` } : {};
    }

    function desktopWorkbenchEnabled() {
      return window.innerWidth > 1200;
    }

    function syncWorkbenchHeights() {
      const recordsPanel = document.getElementById('recordsPanel');
      const detailPanel = document.getElementById('detailPanel');
      const detailBody = document.getElementById('detailBody');
      
      if (!recordsPanel || !detailPanel || !detailBody) return;
      if (!desktopWorkbenchEnabled()) {
        recordsPanel.style.height = '';
        detailPanel.style.height = '';
        return;
      }
      
      const viewportGap = 20;
      const recordsRect = recordsPanel.getBoundingClientRect();
      const detailRect = detailPanel.getBoundingClientRect();
      const recordsPanelHeight = Math.max(420, Math.floor(window.innerHeight - recordsRect.top - viewportGap));
      const targetDetailHeight = Math.max(680, Math.floor((recordsRect.top - detailRect.top) + recordsPanelHeight));
      recordsPanel.style.height = `${recordsPanelHeight}px`;
      detailPanel.style.height = `${targetDetailHeight}px`;
    }

    window.handleInventoryApprovalReview = handleInventoryApprovalReview;
  </script>
