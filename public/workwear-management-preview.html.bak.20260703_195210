    async function handleInventoryApprovalReview(itemId, action) {
      try {
        const comment = document.getElementById(`inventoryApprovalComment-${itemId}`)?.value?.trim() || '';
        const res = await fetch(`${API_BASE}/inventory-count/items/${itemId}/review`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
          body: JSON.stringify({ action, comment })
        });
        const data = await res.json();
        if (!res.ok || data.code !== 0) throw new Error(data.msg || '审核失败');
        await Promise.all([loadInventoryApprovalTasks(), loadRecords(), loadStats()]);
        invalidateInventorySheet();
        alert(action === 'approved' ? '审核已通过' : '已驳回该差异项');
      } catch (err) {
        alert(err.message || '审核失败');
      }
    }

