    function renderCalendar() {
      if (!calendarField) return;
      const isMonthPicker = isCompactMonthCalendarField(calendarField);
      calendarPop.classList.toggle('is-month-picker', isMonthPicker);
      document.getElementById('calPrevYear').classList.toggle('is-hidden', !isInventoryCalendarField(calendarField));
      if (isMonthPicker) {
        const now = new Date();
        const currentYear = now.getFullYear();
        const currentMonthValue = now.getMonth() + 1;
        const selectedMonth = calendarField === 'monthlyIssueMonth'
          ? monthlyIssueMonth
          : inventoryCompactMonth;
        document.getElementById('calTitle').textContent = `${calendarYear}年`;
        document.getElementById('calGrid').innerHTML = Array.from({ length: 12 }, (_, index) => {
          const month = index + 1;
          const isFutureMonth = calendarYear >= currentYear && month > currentMonthValue;
          return `<button type="button" class="calendar-month${month === selectedMonth ? ' selected' : ''}${isFutureMonth ? ' is-disabled' : ''}" data-month="${month}" ${isFutureMonth ? 'disabled' : ''}>${month}月</button>`;
        }).join('');
        document.querySelectorAll('#calGrid .calendar-month').forEach((button) => {
          if (button.disabled) return;
          button.addEventListener('click', () => pickCalendarMonth(button.dataset.month));
        });
        return;
      }
      document.getElementById('calPrevYear').classList.toggle('is-hidden', !isInventoryCalendarField(calendarField));
      document.getElementById('calTitle').textContent = `${calendarYear}年 ${calendarMonth + 1}月`;
      const firstDay = new Date(calendarYear, calendarMonth, 1);
      const startWeek = firstDay.getDay();
      const daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
      const selectedValue = document.getElementById(calendarField).value;
      const todayValue = formatDateValue(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());
      const cells = [];
      for (let i = 0; i < 42; i++) {
        const dayNum = i - startWeek + 1;
        if (dayNum < 1 || dayNum > daysInMonth) {
          cells.push('<span></span>');
          continue;
        }
        const value = formatDateValue(calendarYear, calendarMonth, dayNum);
        const hasPurchase = calendarField === 'purchaseDate' && purchaseState.dateMarks.has(value);
        cells.push(`<button type="button" class="calendar-day${value === selectedValue ? ' selected' : ''}${value === todayValue ? ' today' : ''}${hasPurchase ? ' has-purchase' : ''}" data-date="${value}">${dayNum}</button>`);
      }
      document.getElementById('calGrid').innerHTML = cells.join('');
      document.querySelectorAll('#calGrid .calendar-day').forEach((button) => {
        button.addEventListener('click', () => pickCalendarDate(button.dataset.date));
      });
    }

