    async function loadInventoryApprovalTasks() {
      try {
        const res = await fetch(`${API_BASE}/inventory-count/review-tasks`, { headers: getAuthHeaders() });
        const data = await res.json();
        if (!res.ok || data.code !== 0) throw new Error(data.msg || '加载待审核差异项失败');
        renderInventoryApprovalTasks(Array.isArray(data.data) ? data.data : []);
