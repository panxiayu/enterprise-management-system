    function hideStaffSuggestions(target) {
      if (target && staffSuggestTarget && staffSuggestTarget !== target) return;
      staffSuggestPop.classList.remove('show');
      staffSuggestList.innerHTML = '';
      staffSuggestMatches = [];
      staffSuggestActiveIndex = 0;
      if (!target || staffSuggestTarget === target) {
        staffSuggestTarget = null;
      }
    }

    function updateStaffSuggestionActiveState() {
      [...staffSuggestList.querySelectorAll('.staff-suggest-item')].forEach((button, index) => {
        button.classList.toggle('active', index === staffSuggestActiveIndex);
      });
    }

    function moveStaffSuggestionActive(delta) {
      if (!staffSuggestMatches.length) return;
      staffSuggestActiveIndex = (staffSuggestActiveIndex + delta + staffSuggestMatches.length) % staffSuggestMatches.length;
      updateStaffSuggestionActiveState();
      const activeEl = staffSuggestList.querySelector(`.staff-suggest-item[data-index="${staffSuggestActiveIndex}"]`);
      if (activeEl) activeEl.scrollIntoView({ block: 'nearest' });
    }

    function showStaffSuggestions(target, matches) {
      const nameInput = getStaffNameInputElement(target);
      if (!nameInput || !Array.isArray(matches) || !matches.length) {
        hideStaffSuggestions(target);
        return;
      }
      const rect = nameInput.getBoundingClientRect();
      staffSuggestTarget = target;
      staffSuggestMatches = matches.slice();
      staffSuggestActiveIndex = 0;
      const popupWidth = target === 'list-search'
        ? Math.max(rect.width, 320)
        : Math.max(rect.width, 260);
      staffSuggestPop.style.width = `${popupWidth}px`;
      staffSuggestPop.style.left = `${Math.max(12, Math.min(rect.left, window.innerWidth - popupWidth - 12))}px`;
      staffSuggestPop.style.top = `${rect.bottom + 8}px`;
      staffSuggestList.innerHTML = matches.map((item, index) => {
        if (target === 'list-search') {
          const kindLabel = item.suggest_type === 'staff'
            ? '人员'
            : item.suggest_type === 'category'
              ? '类别'
              : item.suggest_type === 'leave'
                ? '字段'
              : item.suggest_type === 'self_purchase'
                ? '自购'
                : '型号';
          const title = item.display_name || item.name || item.employee_id || '';
          const sub = item.suggest_type === 'staff'
            ? [item.department || '-', item.position || '无'].join(' / ')
            : '';
          return `
            <button type="button" class="staff-suggest-item${index === 0 ? ' active' : ''}" data-index="${index}">
              <div class="staff-suggest-name-row">
                <span class="staff-suggest-kind">${escapeHtml(kindLabel)}</span>
                <span class="staff-suggest-name">${escapeHtml(title)}</span>
              </div>
              ${sub ? `<div class="staff-suggest-meta">${escapeHtml(sub)}</div>` : ''}
            </button>
          `;
        }
        return `
          <button type="button" class="staff-suggest-item${index === 0 ? ' active' : ''}" data-index="${index}">
            <div class="staff-suggest-name-row">
              <span class="staff-suggest-name">${escapeHtml(item.name || '')}</span>
              <span class="staff-suggest-emp">${escapeHtml(item.employee_id || '')}</span>
            </div>
            <div class="staff-suggest-meta">${escapeHtml([item.department || '-', item.position || '无'].join(' / '))}</div>
          </button>
        `;
      }).join('');
      [...staffSuggestList.querySelectorAll('.staff-suggest-item')].forEach((button) => {
        button.addEventListener('mousedown', (event) => {
          event.preventDefault();
          const match = matches[Number(button.dataset.index)];
          if (!match) return;
          applyStaffSuggestion(target, match);
        });
      });
      updateStaffSuggestionActiveState();
      staffSuggestPop.classList.add('show');
