    function parseLocalDateOnly(value) {
      const match = String(value || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (!match) return null;
      return new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
    }

    function isHistoricalPurchaseDate(value) {
      const targetDate = parseLocalDateOnly(value);
      const today = parseLocalDateOnly(getLocalDateValue());
      if (!targetDate || !today) return false;
      const diffDays = Math.floor((today.getTime() - targetDate.getTime()) / 86400000);
      return diffDays > 5;
    }

    function syncPurchaseMode() {
      const isAdjust = purchaseState.mode === 'adjust';
      const purchaserInput = document.getElementById('purchasePurchaser');
      const purchaserLabel = document.getElementById('purchasePurchaserLabel');
      const purchaserField = purchaserInput?.closest('.workflow-field');
      const submitBtn = document.getElementById('purchaseSubmitBtn');
      const currentDate = document.getElementById('purchaseDate')?.value || getLocalDateValue();
      const isHistoryCreate = !isAdjust && isHistoricalPurchaseDate(currentDate);
      purchaseState.isHistory = isHistoryCreate;
      document.getElementById('purchaseTitle').textContent = isAdjust ? '更改入库' : '采购入库';
      document.getElementById('purchaseSubtitle').textContent = isAdjust
        ? '选择已入库日期，填写更改后数量并提交审批'
        : (isHistoryCreate ? '历史采购入库记录，仅保留已入库条目和采购人快照' : '选择入库日期，填写在用基础物品的采购数量');
      document.getElementById('purchaseModeToggle').textContent = isAdjust ? '返回入库' : '更改入库';
      document.getElementById('purchaseItemsTitle').textContent = isAdjust ? '更改数量' : '入库数量';
      document.getElementById('purchaseItemsHint').textContent = isAdjust ? '' : (isHistoryCreate ? '仅显示已入库条目' : '仅显示在用基础物品');
      submitBtn.textContent = isAdjust ? '确认更改' : '确认入库';
      purchaserInput.disabled = isAdjust;
      if (purchaserLabel) purchaserLabel.style.display = isHistoryCreate ? 'none' : '';
      if (purchaserField) purchaserField.style.display = isHistoryCreate ? 'none' : '';
      if (submitBtn) submitBtn.style.display = isHistoryCreate ? 'none' : '';
    }

    async function loadPurchaseDateMarks(month) {
      try {
        const targetMonth = month || document.getElementById('purchaseDate').value.slice(0, 7) || getLocalDateValue().slice(0, 7);
        const res = await fetch(`${API_BASE}/purchase-dates?month=${encodeURIComponent(targetMonth)}`);
        const data = await res.json();
        purchaseState.dateMarks = new Set((data.data || []).map(row => row.purchase_date));
        if (calendarField === 'purchaseDate') renderCalendar();
      } catch (err) {
        purchaseState.dateMarks = new Set();
      }
    }

    async function loadPurchaseDayData() {
      const date = document.getElementById('purchaseDate').value || getLocalDateValue();
      const grid = document.getElementById('purchaseItemGrid');
      grid.innerHTML = '<div class="loading">加载中...</div>';
      purchaseState.isHistory = purchaseState.mode === 'create' && isHistoricalPurchaseDate(date);
      syncPurchaseMode();
      try {
        const res = await fetch(`${API_BASE}/purchase-day?date=${encodeURIComponent(date)}`);
        const data = await res.json();
        if (!res.ok || data.code !== 0) throw new Error(data.msg || '加载采购数据失败');
        purchaseState.items = (data.data.items || []).map((item, index) => ({
          ...item,
          _base_order: index
        }));
        purchaseState.drafts = {};
        purchaseState.reorderTick = 0;
        purchaseState.items = [
          ...purchaseState.items.filter((item) => Math.trunc(Number(item.quantity) || 0) > 0),
          ...purchaseState.items.filter((item) => Math.trunc(Number(item.quantity) || 0) <= 0)
        ];
        const purchaserInput = document.getElementById('purchasePurchaser');
        purchaserInput.value = data.data.default_purchaser || data.data.purchasers || '';
        renderPurchaseItems();
      } catch (err) {
        grid.innerHTML = `<div class="empty-state">${escapeHtml(err.message || '加载失败')}</div>`;
      }
    }

    function getPurchaseDraft(item) {
      const existing = purchaseState.drafts[item.item_id];
      if (existing) return existing;
      const quantity = Math.trunc(Number(item.quantity) || 0);
      const itemPurchaser = String(item.purchaser || '').trim();
      const purchaser = itemPurchaser || '';
      const draft = {
        quantity,
        purchaser,
        filledOrder: quantity > 0 ? ++purchaseState.reorderTick : 0,
        locked: Boolean(itemPurchaser)
      };
      purchaseState.drafts[item.item_id] = draft;
      return draft;
    }

    function hasPurchaseSnapshot(draft) {
      const purchaser = String(draft?.purchaser || '').trim();
      return (Number(draft?.quantity || 0) > 0) || (!!purchaser && purchaser !== '-');
    }

    function capturePurchaseRowRects() {
      const rects = new Map();
      document.querySelectorAll('.purchase-row[data-purchase-item]').forEach((row) => {
        const itemId = Number(row.dataset.purchaseItem || 0);
        if (itemId) rects.set(itemId, row.getBoundingClientRect());
      });
      return rects;
    }

    function animatePurchaseReorder(previousRects) {
      if (!previousRects || !previousRects.size) return;
      const moves = [];
      document.querySelectorAll('.purchase-row[data-purchase-item]').forEach((row) => {
        const itemId = Number(row.dataset.purchaseItem || 0);
        const prevRect = previousRects.get(itemId);
        if (!itemId || !prevRect) return;
        const nextRect = row.getBoundingClientRect();
        const deltaX = prevRect.left - nextRect.left;
        const deltaY = prevRect.top - nextRect.top;
        if (Math.abs(deltaX) < 1 && Math.abs(deltaY) < 1) return;
        moves.push({ row, deltaX, deltaY });
      });
      if (!moves.length) return;
      moves.forEach(({ row, deltaX, deltaY }) => {
        row.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
      });
      requestAnimationFrame(() => {
        moves.forEach(({ row }) => {
          row.classList.add('is-reordering');
          row.style.transform = 'translate(0, 0)';
        });
        window.setTimeout(() => {
          moves.forEach(({ row }) => {
            row.classList.remove('is-reordering');
            row.style.transform = '';
          });
        }, 320);
      });
    }

    function commitPurchaseDraft(itemId) {
      const currentItems = purchaseState.items || [];
      const item = currentItems.find((entry) => Number(entry.item_id) === Number(itemId));
      if (!item) return;
      const previousRects = capturePurchaseRowRects();
      const qtyInput = document.getElementById(`purchaseQty-${itemId}`);
      const ownerInput = document.getElementById(`purchaseOwner-${itemId}`);
      const draft = getPurchaseDraft(item);
      const quantity = Math.trunc(Number(qtyInput?.value || 0));
      const defaultPurchaser = String(document.getElementById('purchasePurchaser')?.value || '').trim() || '-';
      const currentOwner = String(ownerInput?.value || '').trim();

      draft.quantity = quantity;
      if (quantity > 0) {
        draft.purchaser = currentOwner && currentOwner !== '-' ? currentOwner : defaultPurchaser;
        purchaseState.reorderTick += 1;
        draft.filledOrder = purchaseState.reorderTick;
      } else {
        draft.purchaser = '';
        draft.locked = false;
        draft.filledOrder = 0;
      }
      const remainingItems = currentItems.filter((entry) => Number(entry.item_id) !== Number(itemId));
      if (quantity > 0) {
        const filledItems = remainingItems.filter((entry) => getPurchaseDraft(entry).quantity > 0);
        const unfilledItems = remainingItems.filter((entry) => getPurchaseDraft(entry).quantity <= 0);
        purchaseState.items = [...filledItems, item, ...unfilledItems];
      } else {
        const filledItems = remainingItems.filter((entry) => getPurchaseDraft(entry).quantity > 0);
        const unfilledItems = [...remainingItems.filter((entry) => getPurchaseDraft(entry).quantity <= 0), item]
          .sort((a, b) => Number(a._base_order || 0) - Number(b._base_order || 0));
        purchaseState.items = [...filledItems, ...unfilledItems];
      }
      renderPurchaseItems();
      animatePurchaseReorder(previousRects);
    }

    function sortPurchaseItemsByDraft() {
      purchaseState.items = [...(purchaseState.items || [])].sort((a, b) => {
        const draftA = getPurchaseDraft(a);
        const draftB = getPurchaseDraft(b);
        const filledA = draftA.quantity > 0 ? 1 : 0;
        const filledB = draftB.quantity > 0 ? 1 : 0;
        if (filledA !== filledB) return filledB - filledA;
        if (draftA.filledOrder !== draftB.filledOrder) return draftB.filledOrder - draftA.filledOrder;
        return Number(a._base_order || 0) - Number(b._base_order || 0);
      });
    }

    function renderPurchaseItems() {
      const grid = document.getElementById('purchaseItemGrid');
      const summary = document.getElementById('purchaseDaySummary');
      const allItems = purchaseState.items || [];
      const items = purchaseState.isHistory && purchaseState.mode === 'create'
        ? allItems.filter((item) => Math.trunc(Number(item.quantity) || 0) > 0)
        : allItems;
      summary.innerHTML = '';

      if (!items.length) {
        grid.innerHTML = `<div class="empty-state">${purchaseState.isHistory && purchaseState.mode === 'create' ? '暂无历史采购入库记录' : '暂无在用基础物品，请先在基础物品信息中维护'}</div>`;
        return;
      }

      if (purchaseState.mode === 'adjust') {
        grid.innerHTML = items.map((item, index) => {
          const original = Number(item.quantity) || 0;
          return `
            <div class="purchase-row adjust" data-purchase-item="${item.item_id}">
              <div>
                <div class="purchase-item-name">${index + 1}. ${escapeHtml(item.item_name)}</div>
              </div>
              <div class="purchase-original">${original}</div>
              <input class="purchase-adjust-value" type="text" inputmode="numeric" id="purchaseAdjust-${item.item_id}" placeholder="更改后" data-original="${original}">
              <div class="purchase-adjust-stepper">
                <button class="purchase-adjust-btn" type="button" onclick="purchaseStep('purchaseAdjust-${item.item_id}', -1)">-</button>
                <div class="purchase-diff" id="purchaseDiff-${item.item_id}">0</div>
                <button class="purchase-adjust-btn" type="button" onclick="purchaseStep('purchaseAdjust-${item.item_id}', 1)">+</button>
              </div>
              <div class="purchase-unit">${escapeHtml(item.unit || '')}</div>
            </div>
          `;
        }).join('');
        items.forEach((item) => {
          const input = document.getElementById(`purchaseAdjust-${item.item_id}`);
          input.addEventListener('input', () => updatePurchaseDiff(item.item_id));
          updatePurchaseDiff(item.item_id);
        });
        return;
      }

      grid.innerHTML = items.map((item, index) => {
        const draft = getPurchaseDraft(item);
        const isLocked = Math.trunc(Number(item.quantity) || 0) > 0;
        return `
        <div class="purchase-row ${hasPurchaseSnapshot(draft) ? 'is-filled' : ''} ${isLocked ? 'is-locked' : ''}" data-purchase-item="${item.item_id}" data-order-index="${index}">
          <div>
            <div class="purchase-item-name" data-item-label="${escapeHtml(item.item_name)}">${Number(item._base_order || 0) + 1}. ${escapeHtml(item.item_name)}</div>
          </div>
          <div class="purchase-qty-stepper">
            <button class="purchase-qty-btn" type="button" onclick="purchaseStep('purchaseQty-${item.item_id}', -1)" ${isLocked ? 'disabled' : ''}>-</button>
            <input class="purchase-qty-input" type="text" inputmode="numeric" id="purchaseQty-${item.item_id}" placeholder="" value="${draft.quantity > 0 ? draft.quantity : ''}" ${isLocked ? 'readonly' : ''}>
            <button class="purchase-qty-btn" type="button" onclick="purchaseStep('purchaseQty-${item.item_id}', 1)" ${isLocked ? 'disabled' : ''}>+</button>
          </div>
          <div class="purchase-unit">${escapeHtml(item.unit || '')}</div>
          <input class="input" id="purchaseOwner-${item.item_id}" placeholder="${isLocked ? '请通过更改入库修改' : '采购人（默认取上方）'}" value="-" ${isLocked ? 'readonly' : ''}>
        </div>
      `;
      }).join('');
      items.forEach((item) => {
        const row = document.querySelector(`.purchase-row[data-purchase-item="${item.item_id}"]`);
        const qtyInput = document.getElementById(`purchaseQty-${item.item_id}`);
        const ownerInput = document.getElementById(`purchaseOwner-${item.item_id}`);
        const draft = getPurchaseDraft(item);
        const isLocked = Math.trunc(Number(item.quantity) || 0) > 0;
        if (isLocked) {
          if (ownerInput) ownerInput.value = draft.purchaser || '-';
          return;
        }
        if (row) {
          row.addEventListener('focusout', (event) => {
            const nextTarget = event.relatedTarget;
            if (nextTarget && row.contains(nextTarget)) return;
            setTimeout(() => commitPurchaseDraft(item.item_id), 0);
          });
        }
        if (qtyInput) {
          const clearPurchaseZero = () => {
            if ((qtyInput.value || '').trim() === '0') qtyInput.value = '';
          };
          qtyInput.addEventListener('focus', clearPurchaseZero);
          qtyInput.addEventListener('click', clearPurchaseZero);
          qtyInput.addEventListener('blur', () => {
            if (!qtyInput.value.trim()) qtyInput.value = '';
          });
          qtyInput.addEventListener('input', () => syncPurchaseOwnerForItem(item.item_id));
          syncPurchaseOwnerForItem(item.item_id);
        }
        if (ownerInput) {
          ownerInput.value = draft.purchaser || '-';
          ownerInput.addEventListener('focus', () => {
            if (ownerInput.value.trim() === '-') ownerInput.value = '';
          });
          ownerInput.addEventListener('blur', () => {
            const quantity = Math.trunc(Number(qtyInput?.value || 0));
            const value = ownerInput.value.trim();
            if (value) {
              draft.purchaser = value;
              draft.locked = true;
              ownerInput.value = value;
            } else if (draft.locked && draft.purchaser && draft.purchaser !== '-') {
              ownerInput.value = draft.purchaser;
            } else if (quantity > 0) {
              const fallback = String(document.getElementById('purchasePurchaser')?.value || '').trim() || '-';
              ownerInput.value = fallback;
              draft.purchaser = fallback === '-' ? '' : fallback;
            } else {
              ownerInput.value = '-';
              if (!draft.locked) draft.purchaser = '';
            }
          });
        }
      });
    }

    function purchaseStep(inputId, delta) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const val = Math.trunc(Number(input.value)) || 0;
      input.value = Math.max(0, val + delta);
      input.dispatchEvent(new Event('input'));
    }

    function reorderPurchaseRows() {
      if (purchaseState.mode !== 'create') return;
      const grid = document.getElementById('purchaseItemGrid');
      if (!grid) return;
      const rows = Array.from(grid.querySelectorAll('.purchase-row[data-purchase-item]'));
      const sortedRows = rows
        .sort((a, b) => {
          const qtyA = Math.trunc(Number(a.querySelector('.purchase-qty-input')?.value || 0));
          const qtyB = Math.trunc(Number(b.querySelector('.purchase-qty-input')?.value || 0));
          const filledA = qtyA > 0 ? 1 : 0;
          const filledB = qtyB > 0 ? 1 : 0;
          if (filledA !== filledB) return filledB - filledA;
          const filledOrderA = Number(a.dataset.filledOrder || 0);
          const filledOrderB = Number(b.dataset.filledOrder || 0);
          if (filledOrderA !== filledOrderB) return filledOrderB - filledOrderA;
          return Number(a.dataset.orderIndex || 0) - Number(b.dataset.orderIndex || 0);
        });
      sortedRows.forEach((row, index) => {
        row.style.order = String(index);
        const label = row.querySelector('.purchase-item-name');
        if (label) {
          label.textContent = `${index + 1}. ${label.dataset.itemLabel || label.textContent.replace(/^\d+\.\s*/, '')}`;
        }
      });
    }

    function formatPurchaseMoney(value) {
      const amount = Number(value) || 0;
      return `¥${amount.toFixed(2)}`;
    }

    function syncPurchaseOwnerCards() {
      if (purchaseState.mode !== 'create') return;
      const purchaser = String(document.getElementById('purchasePurchaser')?.value || '').trim();
      document.querySelectorAll('input[id^="purchaseOwner-"]').forEach((el) => {
        const itemId = Number(String(el.id || '').replace('purchaseOwner-', ''));
        if (itemId) {
          const draft = purchaseState.drafts[itemId];
          if (draft && draft.quantity > 0 && !draft.locked && (!draft.purchaser || draft.purchaser === '-')) {
            draft.purchaser = purchaser || '';
          }
          syncPurchaseOwnerForItem(itemId);
        }
      });
    }

    function syncPurchaseOwnerForItem(itemId, shouldReorder = false) {
      if (purchaseState.mode !== 'create') return;
      const qtyInput = document.getElementById(`purchaseQty-${itemId}`);
      const ownerInput = document.getElementById(`purchaseOwner-${itemId}`);
      const row = document.querySelector(`.purchase-row[data-purchase-item="${itemId}"]`);
      if (!qtyInput || !ownerInput) return;
      const draft = purchaseState.drafts[itemId] || (purchaseState.drafts[itemId] = { quantity: 0, purchaser: '-', filledOrder: 0 });
      const quantity = Math.trunc(Number(qtyInput.value || 0));
      const defaultPurchaser = String(document.getElementById('purchasePurchaser')?.value || '').trim();
      const currentValue = ownerInput.value.trim();
      draft.quantity = quantity;
      if (quantity <= 0) {
        ownerInput.value = '-';
        draft.purchaser = '';
        draft.locked = false;
        draft.filledOrder = 0;
        row?.classList.toggle('is-filled', hasPurchaseSnapshot(draft));
        if (shouldReorder) commitPurchaseDraft(itemId);
        return;
      }
      if (currentValue && currentValue !== '-') {
        draft.purchaser = currentValue;
        draft.locked = true;
      } else if (draft.purchaser && draft.purchaser !== '-') {
        ownerInput.value = draft.purchaser;
      } else if (!draft.locked) {
        ownerInput.value = defaultPurchaser || '-';
        draft.purchaser = defaultPurchaser || '';
      }
      row?.classList.toggle('is-filled', hasPurchaseSnapshot(draft));
      if (shouldReorder) {
        commitPurchaseDraft(itemId);
      }
    }

    function updatePurchaseDiff(itemId) {
      const input = document.getElementById(`purchaseAdjust-${itemId}`);
      const diffEl = document.getElementById(`purchaseDiff-${itemId}`);
      const row = document.querySelector(`.purchase-row.adjust[data-purchase-item="${itemId}"]`);
      if (!input || !diffEl) return;
      const original = Number(input.dataset.original || 0);
      const raw = input.value.trim();
      const next = raw === '' ? original : Number(raw);
      const diff = Number.isFinite(next) ? Math.trunc(next) - original : 0;
      diffEl.textContent = diff > 0 ? `+${diff}` : String(diff);
      diffEl.classList.toggle('is-plus', diff > 0);
      diffEl.classList.toggle('is-minus', diff < 0);
      row?.classList.toggle('is-filled', raw !== '');
    }

    function collectPurchaseEntries() {
      if (purchaseState.mode === 'adjust') {
        return (purchaseState.items || [])
          .map((item) => {
            const input = document.getElementById(`purchaseAdjust-${item.item_id}`);
            if (!input || input.value.trim() === '') return null;
            return { item_id: item.item_id, quantity: Math.trunc(Number(input.value) || 0) };
          })
          .filter(Boolean);
      }
      (purchaseState.items || []).forEach((item) => {
        if (Math.trunc(Number(item.quantity) || 0) > 0) return;
        const qtyInput = document.getElementById(`purchaseQty-${item.item_id}`);
        const ownerInput = document.getElementById(`purchaseOwner-${item.item_id}`);
        const draft = getPurchaseDraft(item);
        const quantity = Math.trunc(Number(qtyInput?.value || draft.quantity || 0));
        const defaultPurchaser = String(document.getElementById('purchasePurchaser')?.value || '').trim();
        const purchaser = String(ownerInput?.value || draft.purchaser || '').trim();
        draft.quantity = quantity;
        if (purchaser && purchaser !== '-') {
          draft.purchaser = purchaser;
          draft.locked = true;
        } else if (quantity > 0) {
          draft.purchaser = draft.purchaser || defaultPurchaser || '';
        }
      });
      return (purchaseState.items || [])
        .map((item) => {
          if (Math.trunc(Number(item.quantity) || 0) > 0) return null;
          const draft = getPurchaseDraft(item);
          const quantity = Math.trunc(Number(draft.quantity || 0));
          const defaultPurchaser = String(document.getElementById('purchasePurchaser')?.value || '').trim();
          const purchaser = String(draft.purchaser || defaultPurchaser || '').trim();
          return quantity > 0 ? { item_id: item.item_id, quantity, purchaser } : null;
        })
        .filter(Boolean);
    }

    async function submitPurchaseForm() {
      const purchaseDate = document.getElementById('purchaseDate').value;
      const purchaser = document.getElementById('purchasePurchaser').value.trim();
      const items = collectPurchaseEntries();
      if (!purchaseDate) {
        alert('请选择入库日期');
        return;
      }
      if (!items.length) {
        alert(purchaseState.mode === 'adjust' ? '请至少填写一项更改后数量' : '请至少填写一项采购数量');
        return;
      }
      const isAdjust = purchaseState.mode === 'adjust';
      const payload = {
        purchase_date: purchaseDate,
        items
      };
      if (isAdjust) {
        showRemarkModal((remark) => {
          if (!remark) return;
          payload.remark = remark;
          doPurchaseSubmit(payload, isAdjust);
        });
        return;
      } else {
        if (!purchaser && items.some((item) => {
          const value = String(item.purchaser || '').trim();
          return !value || value === '-';
        })) {
          alert('请填写上方默认采购人，或在下方逐项填写采购人');
          return;
        }
        if (items.some((item) => String(item.purchaser || '').trim() === '-')) {
          alert('有件数的物品采购人不能为 -');
          return;
        }
        payload.purchaser = purchaser;
      }

      doPurchaseSubmit(payload, isAdjust);
    }

    function showRemarkModal(callback) {
      const modal = document.getElementById('remarkModal');
      const input = document.getElementById('remarkInput');
      const counter = document.getElementById('remarkCounter');
      const confirmBtn = document.getElementById('remarkConfirm');
      const cancelBtn = document.getElementById('remarkCancel');
      const closeBtn = document.getElementById('remarkClose');
      const maxLength = 120;
      const updateCounter = () => {
        const value = input.value.slice(0, maxLength);
        if (value !== input.value) input.value = value;
        if (value.trim()) input.classList.remove('is-invalid');
        if (counter) counter.textContent = `${value.trim().length} / ${maxLength}`;
      };
      input.value = '';
      input.classList.remove('is-invalid');
      updateCounter();
      modal.classList.add('show');
      setTimeout(() => input.focus(), 100);
      const cleanup = () => {
        modal.classList.remove('show');
        confirmBtn.removeEventListener('click', onConfirm);
        cancelBtn.removeEventListener('click', onCancel);
        closeBtn.removeEventListener('click', onCancel);
        modal.removeEventListener('click', onMaskClick);
        input.removeEventListener('input', updateCounter);
        input.removeEventListener('keydown', onKeydown);
        document.removeEventListener('keydown', onEscape);
      };
      const onConfirm = () => {
        const val = input.value.trim();
        if (!val) {
          input.classList.add('is-invalid');
          input.focus();
          return;
        }
        cleanup();
        callback(val);
      };
      const onCancel = () => { cleanup(); callback(null); };
      const onMaskClick = (e) => {
        if (e.target === modal) onCancel();
      };
      const onKeydown = (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') onConfirm();
      };
      const onEscape = (e) => {
        if (e.key === 'Escape' && modal.classList.contains('show')) onCancel();
      };
      input.addEventListener('input', updateCounter);
      input.addEventListener('keydown', onKeydown);
      confirmBtn.addEventListener('click', onConfirm);
      cancelBtn.addEventListener('click', onCancel);
      closeBtn.addEventListener('click', onCancel);
      modal.addEventListener('click', onMaskClick);
      document.addEventListener('keydown', onEscape);
    }

    async function doPurchaseSubmit(payload, isAdjust) {
      const purchaseDate = document.getElementById('purchaseDate').value;
      const purchaser = document.getElementById('purchasePurchaser').value.trim();

      try {
        const res = await fetch(`${API_BASE}/${isAdjust ? 'purchase-adjustments' : 'purchase-batch'}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok || data.code !== 0) throw new Error(data.msg || '提交失败');
        if (isAdjust) {
          alert(data.data?.approver_name ? `已提交部门负责人审批：${data.data.approver_name}` : '已提交部门负责人审批');
        } else {
          alert('采购入库完成');
        }
        await loadPurchaseDateMarks(purchaseDate.slice(0, 7));
        await loadPurchaseDayData();
        loadStats();
        invalidateInventorySheet();
      } catch (err) {
        alert(err.message || '提交失败');
      }
    }

