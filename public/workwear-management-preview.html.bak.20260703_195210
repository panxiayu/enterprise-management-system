    function getDrawerAnimationOffset() {
      const drawerEl = document.getElementById('drawer');
      const trigger = getIssueDrawerTrigger();
      const card = drawerEl?.querySelector('.workflow-card');
      if (!drawerEl || !trigger || !card) return null;
      const btnRect = trigger.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      return {
        deltaX: (btnRect.left + btnRect.width / 2) - (cardRect.left + cardRect.width / 2),
        deltaY: (btnRect.top + btnRect.height / 2) - (cardRect.top + cardRect.height / 2)
      };
    }

    function applyDrawerAnimationOffset(card, offset) {
      if (!card || !offset) return;
      card.style.setProperty('--drawer-restore-dx', `${Math.round(offset.deltaX)}px`);
      card.style.setProperty('--drawer-restore-dy', `${Math.round(offset.deltaY)}px`);
    }

    function clearDrawerMotionState(card, hidden) {
      if (!card) return;
      card.classList.remove('is-restoring', 'is-minimizing');
      card.style.transform = 'translateZ(0)';
      card.style.opacity = hidden ? '0' : '1';
      card.style.visibility = hidden ? 'hidden' : 'visible';
      card.style.willChange = 'auto';
      card.style.removeProperty('--drawer-restore-dx');
      card.style.removeProperty('--drawer-restore-dy');
    }

    function primeDrawerMotion(card, offset) {
      if (!card || !offset) return;
      applyDrawerAnimationOffset(card, offset);
      card.style.willChange = 'transform,opacity';
      card.style.visibility = 'visible';
      card.style.transform = `translate3d(${Math.round(offset.deltaX * .16)}px, ${Math.round(offset.deltaY * .16)}px, 0) scale(.97)`;
      card.style.opacity = '0';
    }

    function openDrawer(type) {
