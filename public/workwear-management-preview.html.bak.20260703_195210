    function getSelectedValues(id) {
      if (id && id.startsWith('inventory:')) {
        return inventoryHeaderFilters[id] || [];
      }
      if (id === 'departmentFilter') return selectedDepartments;
      if (id === 'positionFilter') return selectedPositions;
      if (id === 'typeFilter') return selectedTypes;
