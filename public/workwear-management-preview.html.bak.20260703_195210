      const card = drawerEl?.querySelector('.workflow-card');
      const offset = getDrawerAnimationOffset();
      // 彻底清理之前动画的所有状态
      drawerEl.classList.remove('is-minimized', 'is-minimizing');
      card?.classList.remove('is-restoring', 'is-minimizing');
      // 先把卡片置于起始动画状态（按钮位置 + 缩小 + 透明），避免 show 后满状态闪现
      if (card && offset) {
        primeDrawerMotion(card, offset);
      }
      drawerEl.classList.add('show');
      syncIssueDrawerTriggerState();
      if (card) {
        card.classList.add('is-restoring');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            card.style.transform = 'translate3d(0,0,0) scale(1)';
            card.style.opacity = '1';
          });
        });
        window.setTimeout(() => clearDrawerMotionState(card, false), 220);
      }
    }

    function closeDrawer() {
      hideStaffSuggestions();
      drawerMinimized = false;
      const drawerEl = document.getElementById('drawer');
      drawerEl.classList.remove('show', 'is-minimized');
      const card = drawerEl?.querySelector('.workflow-card');
      card?.classList.remove('is-restoring', 'is-minimizing');
      card?.style.removeProperty('--drawer-restore-dx');
      card?.style.removeProperty('--drawer-restore-dy');
