          clearMatchedStaff('quick');
          nameInput.value = record.staff_name || '';
          hiddenName.value = record.staff_name || '';
          setQuickStaffLeaveLocked(!!String(record.leave_date || '').trim());
          alert('登录状态已失效，请重新登录后再试');
        } else {
          clearMatchedStaff('quick');
          nameInput.value = record.staff_name || '';
          hiddenName.value = record.staff_name || '';
          setQuickStaffLeaveLocked(!!String(record.leave_date || '').trim());
          alert(data.msg || '读取人员管理实时数据失败，请稍后重试');
        }
      } catch (err) {
        clearMatchedStaff('quick');
        nameInput.value = record.staff_name || '';
        hiddenName.value = record.staff_name || '';
        setQuickStaffLeaveLocked(!!String(record.leave_date || '').trim());
        alert('读取人员管理实时数据失败，请稍后重试');
      }
    }

