    function formatDateValue(year, month, day) {
      return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    }

    function parseDateValue(value) {
      if (!value) return null;
      const parts = value.split('-').map(Number);
      if (parts.length !== 3) return null;
      return new Date(parts[0], parts[1] - 1, parts[2]);
    }

    function openCalendar(fieldId) {
      if (calendarField === fieldId && calendarPop.classList.contains('show')) {
        closeCalendar();
        return;
      }
      closeSelect();
      calendarField = fieldId;
      if (isCompactMonthCalendarField(fieldId)) {
        const now = new Date();
        calendarYear = now.getFullYear();
        const selectedMonth = fieldId === 'monthlyIssueMonth'
          ? monthlyIssueMonth
          : inventoryCompactMonth;
        calendarMonth = Math.max(0, Math.min(11, Number(selectedMonth || (now.getMonth() + 1)) - 1));
      } else {
        const current = parseDateValue(document.getElementById(fieldId).value) || new Date();
        calendarYear = current.getFullYear();
        calendarMonth = current.getMonth();
      }
      const anchor = getCalendarAnchorElement(fieldId);
      if (!anchor) return;
      const rect = anchor.getBoundingClientRect();
      const popWidth = isCompactMonthCalendarField(fieldId) ? 210 : 250;
      const preferredLeft = fieldId === 'settlementLeaveDate'
        ? ((rect.left - popWidth - 10) >= 8 ? (rect.left - popWidth - 10) : Math.max(8, rect.left - 10))
        : (rect.left + (rect.width / 2) - (popWidth / 2));
      const popHeight = isCompactMonthCalendarField(fieldId) ? 232 : 300;
      const maxLeft = window.innerWidth - popWidth - 16;
      const maxTop = window.innerHeight - popHeight - 12;
      calendarPop.style.left = `${Math.max(8, Math.min(preferredLeft, maxLeft))}px`;
      const preferredTop = fieldId === 'settlementLeaveDate'
        ? (rect.top + (rect.height / 2) - (popHeight / 2))
        : (rect.bottom + 8);
      calendarPop.style.top = `${Math.max(12, Math.min(preferredTop, maxTop))}px`;
      calendarPop.classList.add('show');
      renderCalendar();
    }

    function isInventoryCalendarField(fieldId) {
      return fieldId === 'inventoryStartDate' || fieldId === 'inventoryEndDate';
    }

    function isCompactMonthCalendarField(fieldId) {
      return fieldId === 'inventoryCompactMonth' || fieldId === 'monthlyIssueMonth';
    }

    function isInventoryCompactMonthField(fieldId) {
      return fieldId === 'inventoryCompactMonth';
    }

    function getCalendarAnchorElement(fieldId) {
      if (isCompactMonthCalendarField(fieldId)) {
        if (fieldId === 'monthlyIssueMonth') {
          return document.getElementById('monthlyIssueMonthTrigger');
        }
        return document.getElementById('inventoryCompactMonthTrigger');
      }
      return document.getElementById(fieldId);
    }

    function closeCalendar() {
      calendarPop.classList.remove('is-month-picker');
      calendarPop.classList.remove('show');
      calendarField = null;
    }

    function moveCalendar(delta) {
      if (isInventoryCompactMonthField(calendarField)) return;
      calendarMonth += delta;
      if (calendarMonth < 0) {
        calendarMonth = 11;
        calendarYear -= 1;
      } else if (calendarMonth > 11) {
        calendarMonth = 0;
        calendarYear += 1;
      }
      if (calendarField === 'purchaseDate') {
        loadPurchaseDateMarks(`${calendarYear}-${String(calendarMonth + 1).padStart(2, '0')}`);
      }
      renderCalendar();
