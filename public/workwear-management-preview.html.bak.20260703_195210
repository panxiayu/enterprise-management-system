    function syncQuickEntryCollapse(forceCollapsed = null) {
      const card = document.getElementById('quickEntryCard');
      const toggle = document.getElementById('quickEntryToggle');
      if (!card || !toggle) return;
      const hasTasks = Array.isArray(inventoryApprovalTasks) && inventoryApprovalTasks.length > 0;
      if (typeof forceCollapsed === 'boolean') {
        quickEntryCollapsed = forceCollapsed;
      } else if (!hasTasks) {
        quickEntryCollapsed = false;
      }
      card.classList.toggle('is-collapsed', hasTasks && quickEntryCollapsed);
      toggle.classList.toggle('show', hasTasks);
      toggle.textContent = hasTasks && quickEntryCollapsed ? '展开快速录入' : '收起快速录入';
    }

    function formatSubmittedAt(value) {
      if (!value || value === '-') return '-';
      const date = new Date(value.replace(' ', 'T'));
      if (isNaN(date.getTime())) return value;
      const now = new Date();
      const sameYear = date.getFullYear() === now.getFullYear();
      const pad = (n) => String(n).padStart(2, '0');
      if (sameYear) {
        return `${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
      }
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
    }

