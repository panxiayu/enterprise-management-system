<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>个人待办 - 兴利汽车模具</title>
    <style>
        :root{
            --bg:#edf5fd;
            --bg-strong:#f7fbff;
            --panel:rgba(248,251,255,.74);
            --panel-strong:rgba(255,255,255,.92);
            --panel-soft:rgba(255,255,255,.58);
            --line:rgba(132,168,206,.22);
            --line-strong:rgba(99,144,195,.38);
            --text:#1d3d67;
            --text-soft:#6884a3;
            --text-faint:#8ea4bc;
            --primary:#267ed9;
            --primary-deep:#1f5ea7;
            --primary-soft:rgba(38,126,217,.12);
            --green:#28a36a;
            --orange:#dd8a2e;
            --red:#d85d69;
            --shadow:0 26px 60px rgba(62,101,142,.12);
            --shadow-soft:0 14px 30px rgba(62,101,142,.08);
            --radius:28px;
            --shell-offset:28px;
            --workspace-height:clamp(420px,calc(100dvh - 250px),760px);
            --board-empty-height:clamp(300px,calc(var(--workspace-height) - 80px),680px);
            --board-empty-compact-height:clamp(180px,calc(var(--workspace-height) - 360px),260px);
        }
        *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
        html,body{min-height:100%}
        body{
            min-height:100vh;
            font-family:"Segoe UI",-apple-system,BlinkMacSystemFont,sans-serif;
            color:var(--text);
            background:
                radial-gradient(circle at 10% 8%, rgba(191,228,255,.9), transparent 24%),
                radial-gradient(circle at 82% 12%, rgba(255,224,231,.5), transparent 20%),
                linear-gradient(135deg,#e3f0fb 0%,#f3f8fd 48%,#f7eff7 100%);
            -webkit-font-smoothing:antialiased;
        }
        button,input,select,textarea{font:inherit}
        button{cursor:pointer}
        .page{
            width:min(1760px,calc(100% - 30px));
            margin:14px auto;
            padding:18px;
            min-height:calc(100dvh - var(--shell-offset));
            border:1px solid rgba(255,255,255,.7);
            border-radius:34px;
            background:linear-gradient(180deg,rgba(249,252,255,.7),rgba(244,249,255,.54));
            backdrop-filter:blur(26px) saturate(130%);
            box-shadow:var(--shadow);
            position:relative;
            overflow:hidden;
            display:flex;
            flex-direction:column;
        }
        .page::before{
            content:"";
            position:absolute;
            inset:0;
            background:
                linear-gradient(90deg, rgba(255,255,255,.22), transparent 25%),
                linear-gradient(180deg, rgba(255,255,255,.28), transparent 20%);
            pointer-events:none;
        }
        .topbar,.summary,.workspace,.compose-wrap,.compose-banner{position:relative;z-index:1}
        .topbar{
            display:grid;
            grid-template-columns:minmax(220px,300px) minmax(620px,1fr) auto;
            gap:14px;
            align-items:center;
            margin-bottom:14px;
            padding:6px 4px 2px;
        }
        .brand{
            min-width:0;
            padding:4px 0 4px 6px;
        }
        .brand-page{
            min-width:0;
        }
        .brand-page strong{
            display:block;
            font-size:32px;
            font-weight:900;
            line-height:1;
            letter-spacing:.01em;
            color:#1f4675;
        }
        .search{
            display:flex;
            align-items:center;
            gap:10px;
            height:54px;
            padding:0 18px;
            border:1px solid rgba(255,255,255,.9);
            border-radius:20px;
            background:rgba(255,255,255,.76);
            box-shadow:inset 0 1px 0 rgba(255,255,255,.62),var(--shadow-soft);
        }
        .search span{color:#7e98b4}
        .search input{
            width:100%;
            border:0;
            outline:0;
            background:transparent;
            color:var(--text);
            font-size:15px;
        }
        .search input::placeholder{color:#90a8c1}
        .actions{
            display:flex;
            align-items:center;
            align-self:start;
            gap:10px;
            flex-wrap:wrap;
            justify-content:flex-end;
        }
        .btn,.btn-primary,.btn-ghost,.btn-mini{
            display:inline-flex;
            align-items:center;
            justify-content:center;
            gap:6px;
            text-decoration:none;
            border-radius:16px;
            transition:.18s ease;
            white-space:nowrap;
        }
        .btn,.btn-primary,.btn-ghost{
            height:40px;
            padding:0 16px;
            font-size:13px;
            font-weight:900;
            border:1px solid transparent;
        }
        .btn{
            background:rgba(255,255,255,.88);
            border-color:rgba(152,184,216,.24);
            color:var(--text);
        }
        .btn-primary{
            background:linear-gradient(135deg,var(--primary),#48a7ee);
            border-color:rgba(56,145,224,.34);
            color:#fff;
            box-shadow:0 12px 26px rgba(45,132,214,.24);
        }
        .btn-ghost{
            background:rgba(255,255,255,.56);
            border-color:rgba(169,196,221,.24);
            color:#597694;
        }
        .btn:hover,.btn-primary:hover,.btn-ghost:hover,.btn-mini:hover{transform:translateY(-1px)}
        .btn-mini{
            height:30px;
            padding:0 10px;
            border:1px solid rgba(151,182,212,.34);
            background:#fff;
            color:#6081a1;
            font-size:11px;
            font-weight:900;
        }
        .summary{
            display:grid;
            grid-template-columns:repeat(4,minmax(0,1fr));
            gap:10px;
            margin-bottom:14px;
        }
        .topbar .summary{
            margin-bottom:0;
            margin-left:-6px;
            margin-top:-4px;
            align-self:start;
        }
        .summary-card,.panel{
            border:1px solid rgba(255,255,255,.86);
            border-radius:24px;
            background:linear-gradient(180deg,rgba(255,255,255,.78),rgba(246,250,255,.66));
            box-shadow:var(--shadow-soft);
        }
        .summary-card{
            --accent:var(--primary);
            --accent-soft:var(--primary-soft);
            min-height:86px;
            padding:12px 14px;
            position:relative;
            overflow:hidden;
            display:flex;
            align-items:center;
            gap:12px;
            width:100%;
            cursor:pointer;
            appearance:none;
            border-radius:18px;
            border-color:rgba(255,255,255,.86);
            background:linear-gradient(180deg,rgba(255,255,255,.88),rgba(244,249,255,.72));
            transition:.22s ease;
            text-align:left;
            color:inherit;
        }
        .summary-card::before{
            content:"";
            position:absolute;
            inset:0;
            background:radial-gradient(120% 80% at 100% 0%,var(--accent-soft),transparent 60%);
            opacity:.9;
            pointer-events:none;
        }
        .summary-card .summary-icon{
            width:44px;
            height:44px;
            border-radius:14px;
            display:flex;
            align-items:center;
            justify-content:center;
            background:var(--accent-soft);
            color:var(--accent);
            flex-shrink:0;
            position:relative;
            z-index:1;
            transition:.22s ease;
        }
        .summary-card .summary-icon svg{
            width:22px;
            height:22px;
            display:block;
        }
        .summary-copy{
            display:flex;
            flex-direction:column;
            align-items:flex-start;
            line-height:1.15;
            gap:3px;
            position:relative;
            z-index:1;
            min-width:0;
        }
        .summary-copy strong{
            font-size:24px;
            font-weight:900;
            color:var(--accent);
            line-height:1;
            letter-spacing:-.01em;
        }
        .summary-copy span{
            color:var(--text-soft);
            font-size:12px;
            font-weight:700;
            letter-spacing:.02em;
        }
        .summary-card.pending{--accent:#267ed9;--accent-soft:rgba(38,126,217,.14)}
        .summary-card.warn{--accent:#dd8a2e;--accent-soft:rgba(221,138,46,.16)}
        .summary-card.danger{--accent:#d85d69;--accent-soft:rgba(216,93,105,.16)}
        .summary-card.good{--accent:#28a36a;--accent-soft:rgba(40,163,106,.16)}
        .summary-card:hover{
            transform:translateY(-2px);
            border-color:var(--accent);
            box-shadow:0 18px 36px rgba(62,101,142,.16);
        }
        .summary-card.active{
            background:linear-gradient(180deg,rgba(255,255,255,.96),var(--accent-soft));
            border-color:var(--accent);
            box-shadow:0 16px 32px var(--accent-soft);
        }
        .summary-card.active .summary-icon{
            background:var(--accent);
            color:#fff;
            box-shadow:0 10px 22px var(--accent-soft);
        }
        .summary-card.active .summary-copy strong{
            color:var(--accent-deep,var(--accent));
        }
        .summary-card.pending{--accent-deep:#1f5ea7}
        .summary-card.warn{--accent-deep:#b06820}
        .summary-card.danger{--accent-deep:#a93d49}
        .summary-card.good{--accent-deep:#1c7a4f}
        .workspace{
            display:grid;
            grid-template-columns:minmax(0,1fr) 356px;
            gap:14px;
            align-items:stretch;
            flex:1;
            min-height:0;
        }
        .main-panel{
            display:flex;
            flex-direction:column;
            min-height:0;
        }
        .panel{
            padding:16px;
            position:relative;
            overflow:hidden;
        }
        .panel::before{
            content:"";
            position:absolute;
            inset:0;
            background:linear-gradient(180deg, rgba(255,255,255,.18), transparent 28%);
            pointer-events:none;
        }
        .panel > *{position:relative;z-index:1}
        .detail-panel{
            padding:0;
            background:transparent;
            border:0;
            box-shadow:none;
            display:flex;
            min-height:0;
        }
        .detail-panel::before{display:none}
        .detail-panel .panel-head{display:none}
        .panel-head{
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap:12px;
            margin-bottom:12px;
        }
        .panel-head strong{
            display:block;
            font-size:16px;
            font-weight:900;
            line-height:1.2;
        }
        .panel-head span{
            display:block;
            margin-top:3px;
            color:var(--text-soft);
            font-size:11px;
            line-height:1.6;
        }
        .view-tabs{
            display:grid;
            gap:8px;
            margin-bottom:12px;
        }
        .view-tab{
            display:grid;
            grid-template-columns:auto 1fr auto;
            gap:9px;
            width:100%;
            padding:12px 13px;
            border:1px solid rgba(154,186,215,.16);
            border-radius:16px;
            background:rgba(255,255,255,.86);
            color:#5e7b97;
            font-size:12px;
            font-weight:900;
            text-align:left;
            box-shadow:0 8px 16px rgba(61,104,145,.04);
        }
        .view-tab-mark{
            width:22px;
            height:22px;
            border-radius:8px;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            background:rgba(236,244,255,.92);
            color:#6a89ab;
            font-size:10px;
            font-weight:900;
        }
        .view-tab.active{
            border-color:rgba(38,126,217,.46);
            background:linear-gradient(135deg,rgba(38,126,217,.14),rgba(255,255,255,.88));
            color:var(--primary-deep);
            box-shadow:inset 3px 0 0 var(--primary),0 12px 22px rgba(38,126,217,.10);
        }
        .view-tab.active .view-tab-mark{
            background:rgba(38,126,217,.14);
            color:var(--primary);
        }
        .view-tab b{
            min-width:22px;
            height:22px;
            padding:0 9px;
            border-radius:999px;
            background:rgba(241,247,255,.92);
            display:inline-flex;
            align-items:center;
            justify-content:center;
            font-size:9px;
            color:#597999;
        }
        .filter-grid{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:7px;
            margin-bottom:12px;
        }
        .filter-grid .search-small{grid-column:1 / -1}
        .input,.select,.textarea{
            width:100%;
            border:1px solid rgba(141,175,207,.22);
            border-radius:16px;
            background:#fff;
            color:var(--text);
            outline:0;
        }
        .input,.select{height:44px;padding:0 13px}
        .select-field{position:relative}
        .select-field .input{padding-right:40px;cursor:pointer;background:#fff}
        .select-field::before{
            content:"";
            position:absolute;
            right:16px;
            bottom:19px;
            width:7px;
            height:7px;
            border-right:2px solid #6886a6;
            border-bottom:2px solid #6886a6;
            transform:rotate(45deg);
            pointer-events:none;
            z-index:1;
        }
        .native-select{display:none}
        .select-trigger{
            display:flex;
            align-items:center;
            justify-content:flex-start;
            width:100%;
            text-align:left;
        }
        .select-trigger.open{
            border-color:#4a90e2;
            box-shadow:0 0 0 4px rgba(74,144,226,.12);
        }
        .textarea{
            min-height:110px;
            padding:12px;
            resize:vertical;
        }
        .search-small{position:relative}
        .search-small input{padding-left:38px}
        .search-small::before{
            content:"⌕";
            position:absolute;
            left:14px;
            top:11px;
            color:#88a3bf;
            font-size:14px;
        }
        .sidebar-section{
            margin-top:12px;
            padding-top:12px;
            border-top:1px solid rgba(154,186,215,.12);
        }
        .sidebar-section:first-of-type{
            margin-top:0;
            padding-top:0;
            border-top:0;
        }
        .section-head{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            margin-bottom:10px;
        }
        .section-head strong{
            font-size:11px;
            font-weight:900;
            color:#5a7694;
            letter-spacing:.04em;
        }
        .section-head span{
            color:#8ca5bd;
            font-size:10px;
            font-weight:700;
        }
        .chip-grid{
            display:grid;
            gap:8px;
        }
        .chip-grid.cols-4{
            grid-template-columns:repeat(4,minmax(0,1fr));
        }
        .chip-grid.cols-3{
            grid-template-columns:repeat(3,minmax(0,1fr));
        }
        .chip-card{
            min-height:54px;
            padding:8px 8px;
            border:1px solid rgba(157,188,217,.16);
            border-radius:16px;
            background:rgba(255,255,255,.76);
            color:#6a84a0;
            display:flex;
            align-items:center;
            justify-content:center;
            flex-direction:column;
            gap:4px;
            text-align:center;
            font-size:11px;
            font-weight:900;
            transition:.18s ease;
            box-shadow:0 6px 14px rgba(61,104,145,.03);
        }
        .chip-card i{
            font-style:normal;
            font-size:16px;
            line-height:1;
            color:#7e98b4;
        }
        .chip-card strong{
            font-size:9px;
            line-height:1.2;
        }
        .chip-card.active{
            border-color:rgba(38,126,217,.42);
            background:linear-gradient(135deg,rgba(38,126,217,.12),rgba(255,255,255,.84));
            color:var(--primary-deep);
            box-shadow:0 10px 20px rgba(38,126,217,.08);
            transform:translateY(-1px);
        }
        .chip-card.active i{color:var(--primary)}
        .stats-grid{
            display:grid;
            grid-template-columns:repeat(3,minmax(0,1fr));
            gap:7px;
        }
        .stats-card{
            padding:10px 10px 9px;
            border:1px solid rgba(157,188,217,.16);
            border-radius:16px;
            background:rgba(255,255,255,.82);
        }
        .stats-card label{
            display:block;
            color:#8ca5bd;
            font-size:10px;
            font-weight:800;
            letter-spacing:.06em;
        }
        .stats-card strong{
            display:block;
            margin-top:6px;
            font-size:18px;
            line-height:1;
        }
        .rail-empty-hint{
            margin-top:12px;
            color:#8ca5bd;
            text-align:center;
            font-size:12px;
            line-height:1.7;
        }
        .quick-strip{
            display:grid;
            grid-template-columns:repeat(3,minmax(0,1fr));
            gap:7px;
            margin-bottom:12px;
        }
        .quick-pill{
            padding:10px 11px 9px;
            border-radius:18px;
            background:rgba(255,255,255,.78);
            border:1px solid rgba(157,188,217,.16);
        }
        .quick-pill label{
            display:block;
            color:#8ca5bd;
            font-size:10px;
            font-weight:800;
            letter-spacing:.08em;
            text-transform:uppercase;
        }
        .quick-pill strong{
            display:block;
            margin-top:4px;
            font-size:20px;
        }
        .task-rail{
            display:grid;
            gap:12px;
            max-height:clamp(300px,calc(100dvh - 360px),520px);
            overflow:auto;
            padding-right:4px;
        }
        .task-group{
            display:grid;
            gap:0;
            border:1px solid rgba(154,186,215,.16);
            border-radius:22px;
            background:rgba(255,255,255,.84);
            box-shadow:0 12px 26px rgba(61,104,145,.05);
            overflow:hidden;
            position:relative;
        }
        .task-group::before{
            content:"";
            position:absolute;
            inset:0;
            background:linear-gradient(180deg,rgba(255,255,255,.18),transparent 24%);
            pointer-events:none;
        }
        .task-group-head{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            padding:11px 13px;
            background:linear-gradient(180deg,rgba(239,247,255,.84),rgba(246,250,255,.72));
            border-bottom:1px solid rgba(154,186,215,.16);
        }
        .task-group-head strong{
            color:#5a7694;
            font-size:11px;
            font-weight:900;
            letter-spacing:.08em;
            text-transform:uppercase;
        }
        .task-group-head span{
            color:#8ea5bb;
            font-size:10px;
        }
        .task-group[data-group="overdue"] .task-group-head{
            background:linear-gradient(180deg,rgba(255,240,240,.95),rgba(255,248,248,.8));
        }
        .task-group[data-group="today"] .task-group-head{
            background:linear-gradient(180deg,rgba(255,245,230,.95),rgba(255,250,241,.82));
        }
        .task-group[data-group="progress"] .task-group-head{
            background:linear-gradient(180deg,rgba(236,245,255,.96),rgba(246,250,255,.82));
        }
        .task-group[data-group="done"] .task-group-head{
            background:linear-gradient(180deg,rgba(233,249,241,.96),rgba(245,251,247,.84));
        }
        .task-group[data-group="overdue"] .task-group-head strong{color:#c64756}
        .task-group[data-group="today"] .task-group-head strong{color:#d38627}
        .task-group[data-group="progress"] .task-group-head strong{color:#2f78c8}
        .task-group[data-group="done"] .task-group-head strong{color:#2f9a66}
        .task-card{
            display:grid;
            gap:7px;
            margin:9px 9px 0;
            padding:11px 11px 10px;
            border:1px solid rgba(156,187,216,.14);
            border-radius:16px;
            background:rgba(255,255,255,.94);
            box-shadow:0 8px 16px rgba(61,104,145,.05);
            cursor:pointer;
            transition:.18s ease;
        }
        .task-card:last-of-type{margin-bottom:10px}
        .task-card:hover{background:#fff}
        .task-card.active{
            background:linear-gradient(90deg,rgba(38,126,217,.11),rgba(255,255,255,.72));
            box-shadow:inset 3px 0 0 var(--primary),0 10px 20px rgba(38,126,217,.08);
        }
        .task-card-top{
            display:flex;
            align-items:flex-start;
            gap:10px;
        }
        .pick{
            width:18px;
            height:18px;
            flex:0 0 auto;
            margin-top:2px;
            border:1px solid rgba(120,158,193,.32);
            border-radius:7px;
            background:#fff;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            color:transparent;
        }
        .pick.active{
            border-color:var(--primary);
            background:var(--primary);
            color:#fff;
        }
        .task-card strong{
            display:block;
            font-size:13px;
            line-height:1.45;
        }
        .task-card small{
            display:block;
            color:#6f8ba7;
            font-size:10px;
            line-height:1.5;
        }
        .task-meta{
            display:flex;
            flex-wrap:wrap;
            gap:6px;
        }
        .pill,.status{
            display:inline-flex;
            align-items:center;
            justify-content:center;
            min-height:24px;
            padding:0 9px;
            border-radius:999px;
            font-size:10px;
            font-weight:800;
        }
        .pill{background:#edf5ff;color:#64809b}
        .status.pending{background:#eef6ff;color:#4d82b6}
        .status.in_progress{background:#fff1da;color:#cf8428}
        .status.completed{background:#e6f8ee;color:#319b6b}
        .progress{
            display:flex;
            align-items:center;
            gap:8px;
        }
        .progress-bar{
            flex:1;
            height:7px;
            border-radius:999px;
            background:rgba(111,154,189,.14);
            overflow:hidden;
        }
        .progress-fill{
            height:100%;
            background:linear-gradient(90deg,#57aaf0,#71d2bb);
        }
        .progress span{
            color:#87a0b8;
            font-size:10px;
            font-weight:800;
        }
        .canvas-head{
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap:12px;
            margin-bottom:12px;
        }
        .canvas-head strong{
            font-size:18px;
            font-weight:900;
        }
        .canvas-head span{
            display:block;
            margin-top:4px;
            font-size:12px;
            line-height:1.55;
            color:var(--text-soft);
            max-width:540px;
        }
        .canvas-head-tools{
            display:flex;
            align-items:center;
            gap:8px;
            flex-wrap:wrap;
            justify-content:flex-end;
        }
