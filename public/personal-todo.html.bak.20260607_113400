                priority: document.getElementById('detailPriority').value,
                due_at: document.getElementById('detailDueAt').value || null
            };
            const detailAssignee = document.getElementById('detailAssignee');
            if(detailAssignee) body.assigned_staff_id = detailAssignee.value ? Number(detailAssignee.value) : null;
            try{
                await api(`/task/${detailTask.id}`, {
                    method:'PUT',
                    body: JSON.stringify(body)
                });
                await loadTasks();
                await openTask(detailTask.id);
                alert('任务已更新');
            }catch(error){
                alert(error.message);
            }
        }
        async function deleteCurrentTask(){
            if(!detailTask) return;
            if(!confirm(`确认删除“${detailTask.title || '这条任务'}”？`)) return;
            try{
                await api(`/task/${detailTask.id}`, { method:'DELETE' });
                selectedTaskId = null;
                detailTask = null;
                renderDetail(null);
                await loadTasks();
            }catch(error){
                alert(error.message);
            }
        }
        function renderSubtasks(){
            if(!subtaskDrafts.length){
                subtasksWrap.innerHTML = '<div class="hint">还没有执行项。点击“添加执行项”开始拆分。</div>';
                return;
            }
            subtasksWrap.innerHTML = subtaskDrafts.map((item, index) => `
                <article class="subtask-item">
                    <div class="subtask-item-head">
                        <strong>执行项 ${index + 1}</strong>
                        <button class="btn-mini" type="button" onclick="removeSubtask(${index})">删除</button>
                    </div>
                    <div class="subtask-grid">
                        <div class="field">
                            <label>事项标题</label>
                            <input class="input" value="${esc(item.title)}" oninput="updateSubtask(${index},'title',this.value)" placeholder="例如：整理前厅物料区">
                        </div>
                        <div class="field">
                            <label>负责人</label>
                            <div class="select-field">
                                <button type="button" class="input select-trigger" id="subtaskAssignee${index}Trigger" onclick="toggleSelect('subtaskAssignee${index}')"><span id="subtaskAssignee${index}Label"></span></button>
                                <select class="native-select" id="subtaskAssignee${index}" onchange="updateSubtask(${index},'assigned_staff_id',this.value)">
                                    <option value="">请选择负责人</option>
                                    ${assignees.map(option => `<option value="${Number(option.id)}" ${String(item.assigned_staff_id || '') === String(option.id) ? 'selected' : ''}>${esc(option.department || '未分组')} · ${esc(option.name)}</option>`).join('')}
                                </select>
                            </div>
                        </div>
                        <div class="field">
                            <label>截止时间</label>
                            <input class="input" type="datetime-local" value="${esc(item.due_at || '')}" oninput="updateSubtask(${index},'due_at',this.value)">
                        </div>
                    </div>
                    <div class="field">
                        <label>说明</label>
                        <textarea class="textarea" oninput="updateSubtask(${index},'description',this.value)" placeholder="补充执行要求">${esc(item.description || '')}</textarea>
                    </div>
                </article>
            `).join('');
            syncCustomSelects(subtasksWrap);
        }
        function addSubtask(){
            subtaskDrafts.push({
                title:'',
                description:'',
                assigned_staff_id:'',
                due_at:'',
                priority:'medium'
            });
            renderSubtasks();
        }
        function removeSubtask(index){
            subtaskDrafts.splice(index, 1);
            renderSubtasks();
        }
        function updateSubtask(index, key, value){
            if(!subtaskDrafts[index]) return;
            subtaskDrafts[index][key] = value;
        }
        function syncSplitMode(){
            const split = composeMode?.value === 'split';
            singleAssignSection.classList.toggle('hidden', split);
            splitAssignSection.classList.toggle('hidden', !split);
            if(split && !subtaskDrafts.length) addSubtask();
        }
        async function submitCompose(event){
            event.preventDefault();
            const body = {
                title: composeTitle.value.trim(),
                description: composeDescription.value.trim(),
                category: composeCategory.value,
                priority: composePriority.value,
                due_at: composeDueAt.value || null
            };
            if(!body.title){
                alert('请输入任务标题');
                return;
            }
            if(composeMode?.value === 'split'){
                const subtasks = subtaskDrafts.map(item => ({
                    title: String(item.title || '').trim(),
                    description: String(item.description || '').trim(),
                    assigned_staff_id: item.assigned_staff_id ? Number(item.assigned_staff_id) : null,
                    due_at: item.due_at || null,
                    priority: composePriority.value
                }));
                if(subtasks.some(item => !item.title || !item.assigned_staff_id)){
                    alert('每条执行项都需要填写标题和负责人');
                    return;
                }
                body.subtasks = subtasks;
            }else{
                body.assigned_staff_id = composeAssignee.value ? Number(composeAssignee.value) : null;
            }
            try{
                const created = await api('/task', {
                    method:'POST',
                    body: JSON.stringify(body)
                });
                hideCompose();
                currentView = 'created';
                selectedTaskId = null;
                detailTask = null;
                await loadTasks();
                if(created?.id) openTask(Number(created.id));
            }catch(error){
                alert(error.message);
            }
        }
        let draggingTaskId = null;
        function handleDragStart(event, id){
            draggingTaskId = Number(id);
            event.currentTarget.classList.add('dragging');
        }
        function handleDragEnd(event){
            draggingTaskId = null;
            event.currentTarget.classList.remove('dragging');
            document.querySelectorAll('.board-column').forEach(col => col.classList.remove('drag-over'));
        }
        function handleDragOver(event){
            event.preventDefault();
            event.currentTarget.classList.add('drag-over');
        }
        function handleDragLeave(event){
            event.currentTarget.classList.remove('drag-over');
        }
        async function handleDrop(event, status){
            event.preventDefault();
            event.currentTarget.classList.remove('drag-over');
            if(!draggingTaskId) return;
            try{
                await setTaskStatus(draggingTaskId, status === 'waiting' ? 'in_progress' : status);
            }catch(error){
                alert(error.message);
            }
        }
        async function init(){
            if(!rawToken){
                location.href = 'index.html';
                return;
            }
            await loadAssignees();
            await loadTasks();
            if(params.get('compose') === '1'){
                showCompose();
            }
            const focusId = Number(params.get('focus') || 0);
            if(focusId) openTask(focusId);
        }

        window.openTask = openTask;
        window.toggleSelection = toggleSelection;
        window.toggleSelect = toggleSelect;
        window.pickSelectValue = pickSelectValue;
        window.removeSubtask = removeSubtask;
        window.updateSubtask = updateSubtask;
        window.handleDragStart = handleDragStart;
        window.handleDragEnd = handleDragEnd;
        window.handleDragOver = handleDragOver;
        window.handleDragLeave = handleDragLeave;
        window.handleDrop = handleDrop;

        document.querySelectorAll('[data-display]').forEach(button => {
            button.addEventListener('click', () => {
                currentDisplay = button.dataset.display;
                document.querySelectorAll('[data-display]').forEach(item => item.classList.toggle('active', item === button));
                renderCanvas(currentRows);
            });
        });
        sortFilter?.addEventListener('change', renderMain);
        summaryCards?.addEventListener('click', event => {
            const card = event.target.closest('[data-summary]');
            if(!card) return;
            const key = card.dataset.summary;
            currentQuickFilter = 'all';
            selectedTaskIds.clear();
            selectedTaskId = null;
            detailTask = null;
            renderDetail(null);
            if(key === 'created'){
                currentView = 'created';
                currentDueFilter = 'all';
                loadTasks();
                return;
            }
            currentView = 'inbox';
            currentDueFilter = key === 'today' ? 'today' : key === 'overdue' ? 'overdue' : 'all';
            loadTasks();
        });
        selectVisibleBtn.addEventListener('click', selectVisible);
        clearSelectionBtn.addEventListener('click', clearSelection);
        clearFocusBtn.addEventListener('click', () => {
            selectedTaskId = null;
            detailTask = null;
            renderDetail(null);
            renderMain();
        });
        bulkBar.addEventListener('click', event => {
            const button = event.target.closest('[data-bulk-status]');
            if(!button) return;
            updateSelectedStatus(button.dataset.bulkStatus);
        });
        document.addEventListener('click', event => {
            if(activeSelectField && !event.target.closest('.select-field') && !event.target.closest('.select-pop')){
                closeSelect();
            }
            if(!event.target.closest('.ctx-menu') && !event.target.closest('.board-card')){
                hideCtxMenu();
            }
        });
        let ctxTaskId = null;
        function showCtxMenu(event, taskId){
            event.preventDefault();
            ctxTaskId = taskId;
            const menu = document.getElementById('ctxMenu');
            const x = Math.min(event.clientX, window.innerWidth - 180);
            const y = Math.min(event.clientY, window.innerHeight - 220);
            menu.style.left = x + 'px';
            menu.style.top = y + 'px';
            menu.classList.add('show');
        }
        function hideCtxMenu(){
            const menu = document.getElementById('ctxMenu');
            menu.classList.remove('show');
            ctxTaskId = null;
        }
        document.addEventListener('click', async event => {
            const item = event.target.closest('.ctx-item');
            if(!item || !ctxTaskId) return;
            const action = item.dataset.action;
            hideCtxMenu();
            if(action === 'view'){
                openTask(ctxTaskId);
            }else if(action === 'split'){
                const task = allRows.find(t => Number(t.id) === ctxTaskId);
                if(!task) return alert('任务未找到');
                pageRoot.classList.add('show-compose');
                document.body.classList.add('show-compose');
                document.body.style.overflow = 'hidden';
                composeForm.reset();
                composeTitle.value = task.title || '';
                composeDescription.value = task.description || '';
                composeCategory.value = task.category || 'other';
                composePriority.value = task.priority || 'medium';
                composeDueAt.value = toDatetimeLocal(task.due_at) || '';
                composeMode.value = 'split';
                subtaskDrafts = [];
                syncSplitMode();
                syncCustomSelects();
                renderSubtasks();
            }else if(action === 'edit'){
                openTask(ctxTaskId);
                setTimeout(() => {
                    document.getElementById('detailEditorWrap')?.classList.add('show');
                }, 300);
            }else if(action === 'delete'){
                const task = allRows.find(t => Number(t.id) === ctxTaskId);
                if(!task) return;
                if(!confirm(`确认删除\"${task.title || '这条任务'}\"？`)) return;
                try{
                    await api(`/task/${ctxTaskId}`, { method:'DELETE' });
                    if(selectedTaskId === ctxTaskId){
                        selectedTaskId = null;
                        detailTask = null;
                        renderDetail(null);
                    }
                    await loadTasks();
                }catch(error){
                    alert(error.message);
                }
            }
        });
        window.addEventListener('resize', closeSelect);
        window.addEventListener('scroll', closeSelect, true);
        composeMode?.addEventListener('change', syncSplitMode);
        addSubtaskBtn?.addEventListener('click', addSubtask);
        composeForm?.addEventListener('submit', submitCompose);

        function updateComposeSteps(){
            const steps = document.querySelectorAll('#composeSteps .compose-step-chip');
            if(!steps.length) return;
            const titleDone = !!(composeTitle?.value || '').trim();
            const mode = composeMode?.value;
            const modeDone = !!mode;
            const split = mode === 'split';
            const assigneeDone = split
                ? subtaskDrafts.length > 0 && subtaskDrafts.every(item => (item.title || '').trim() && item.assigned_staff_id)
                : !!composeAssignee?.value;
            steps.forEach(chip => {
                const key = Number(chip.dataset.step);
                chip.classList.remove('is-active', 'is-done');
                if(key === 1){
                    if(titleDone) chip.classList.add('is-done');
                    else chip.classList.add('is-active');
                }else if(key === 2){
                    if(modeDone && titleDone) chip.classList.add('is-done');
                    else if(titleDone) chip.classList.add('is-active');
                }else if(key === 3){
                    if(assigneeDone && modeDone && titleDone) chip.classList.add('is-done');
                    else if(modeDone && titleDone) chip.classList.add('is-active');
                }
            });
        }
        composeTitle?.addEventListener('input', updateComposeSteps);
        composeMode?.addEventListener('change', updateComposeSteps);
        composeAssignee?.addEventListener('change', updateComposeSteps);
        if(typeof subtaskDrafts !== 'undefined'){
            const origAdd = addSubtask;
            window.addSubtask = function(){ origAdd(); updateComposeSteps(); };
            window.removeSubtask = function(idx){ const r = removeSubtask; r(idx); updateComposeSteps(); };
            const origUpdate = updateSubtask;
            window.updateSubtask = function(i,k,v){ origUpdate(i,k,v); updateComposeSteps(); };
        }
        updateComposeSteps();

        init();
    </script>
    <div class="ctx-menu" id="ctxMenu">
        <button class="ctx-item" data-action="view">📋 查看详情</button>
        <button class="ctx-item" data-action="split">🔀 拆分任务</button>
        <button class="ctx-item" data-action="edit">✏️ 编辑任务</button>
        <div class="ctx-divider"></div>
        <button class="ctx-item ctx-danger" data-action="delete">🗑 删除任务</button>
    </div>
</body>
</html>
