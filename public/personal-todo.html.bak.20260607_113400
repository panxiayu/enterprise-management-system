    <script src="/js/admin-session.js"></script>
    <script>
        const API = `${window.location.origin}/api`;
        const employeeToken = localStorage.getItem('employee_token') || '';
        const adminToken = window.AdminSession && window.AdminSession.getToken
            ? window.AdminSession.getToken()
            : (localStorage.getItem('token') || localStorage.getItem('adminToken') || '');
        const rawToken = adminToken || employeeToken;
        const params = new URLSearchParams(location.search);
        const categoryNames = { daily:'日常', production:'生产', quality:'质量', training:'培训', meal:'报餐', s6:'6S', other:'其他' };
        const statusNames = { pending:'待处理', in_progress:'进行中', completed:'已完成' };

        const pageRoot = document.getElementById('pageRoot');
        const composeLink = document.getElementById('composeLink');
        const mainCanvas = document.getElementById('mainCanvas');
        const detailShell = document.getElementById('detailShell');
        const summaryCards = document.getElementById('summaryCards');
        const sortFilter = document.getElementById('sortFilter');
        const bulkBar = document.getElementById('bulkBar');
        const bulkLabel = document.getElementById('bulkLabel');
        const selectVisibleBtn = document.getElementById('selectVisibleBtn');
        const clearSelectionBtn = document.getElementById('clearSelectionBtn');
        const clearFocusBtn = document.getElementById('clearFocusBtn');
        const summaryPending = document.getElementById('summaryPending');
        const summaryToday = document.getElementById('summaryToday');
        const summaryOverdue = document.getElementById('summaryOverdue');
        const summaryCreated = document.getElementById('summaryCreated');

        const composeForm = document.getElementById('composeForm');
        const composeTitle = document.getElementById('composeTitle');
        const composeDescription = document.getElementById('composeDescription');
        const composeCategory = document.getElementById('composeCategory');
        const composePriority = document.getElementById('composePriority');
        const composeDueAt = document.getElementById('composeDueAt');
        const composeAssignee = document.getElementById('composeAssignee');
        const composeMode = document.getElementById('composeMode');
        const singleAssignSection = document.getElementById('singleAssignSection');
        const splitAssignSection = document.getElementById('splitAssignSection');
        const subtasksWrap = document.getElementById('subtasksWrap');
        const addSubtaskBtn = document.getElementById('addSubtaskBtn');
        const selectPop = document.getElementById('selectPop');
        const selectOptions = document.getElementById('selectOptions');

        const requestedView = params.get('view');
        let currentView = (requestedView === 'created' || requestedView === 'completed') ? requestedView : 'inbox';
        let currentDisplay = 'board';
        let allRows = [];
        let currentRows = [];
        let createdRowsCache = [];
        let assignees = [];
        let currentDueFilter = 'all';
        let currentQuickFilter = 'all';
        let selectedTaskId = null;
        let selectedTaskIds = new Set();
        let detailTask = null;
        let subtaskDrafts = [];
        let activeSelectField = null;

        function decodeToken(token){
            try{
                const body = token.split('.')[1];
                if(!body) return {};
                return JSON.parse(decodeURIComponent(atob(body.replace(/-/g,'+').replace(/_/g,'/')).split('').map(c=>`%${c.charCodeAt(0).toString(16).padStart(2,'0')}`).join('')));
            }catch{
                return {};
            }
        }
        const currentUser = decodeToken(rawToken);
        const isAdminUser = currentUser.type !== 'employee';


        if(!isAdminUser){
            composeLink.classList.add('hidden');
        }

        function esc(value){
            return String(value ?? '').replace(/[&<>"']/g, char => ({
                '&':'&amp;',
                '<':'&lt;',
                '>':'&gt;',
                '"':'&quot;',
                "'":'&#39;'
            }[char]));
        }
        function cleanDemoText(value){
            return String(value ?? '')
                .replace(/【界面预览-DEMO】\s*/g, '')
                .trim();
        }
        function showCompose(){
            if(!isAdminUser) return;
            pageRoot.classList.add('show-compose');
            document.body.classList.add('show-compose');
            document.body.style.overflow = 'hidden';
            composeForm.reset();
            subtaskDrafts = [];
            composeMode.value = params.get('composeMode') === 'split' ? 'split' : 'single';
            syncSplitMode();
            renderSubtasks();
            syncCustomSelects();
        }
        function hideCompose(){
            pageRoot.classList.remove('show-compose');
            document.body.classList.remove('show-compose');
            document.body.style.overflow = '';
        }
        function compactDetailText(value, limit = 6){
            const text = cleanDemoText(value);
            if(text.length <= limit) return text;
            return `${text.slice(0, limit)}…`;
        }
        function buildDetailPreview(task, children){
            const title = cleanDemoText(task.title || '');
            if(title !== '6S周会整改推进总任务'){
                return null;
            }
            return {
                title:'6月车间整改推进',
                category:'6S管理',
                assignee:'刘芳',
                description:'汇总现场整改情况，跟踪责任人完成进度，确保问题按期闭环。',
                checklist: children.length ? [
                    { title:'整理模具备件区', assignee:'郭荣武', time:'2026-06-06 08:37', progress:'50%', status:'进行中' },
                    { title:'清理物料通道', assignee:'刘芳', time:'2026-06-06 08:37', progress:'0%', status:'待处理' },
                    { title:'张贴责任牌', assignee:'金巧红', time:'2026-06-06 08:37', progress:'100%', status:'已完成' }
                ] : null,
                timeline: [
                    { title:'任务创建', meta:'管理员 · 2026-06-06 08:37', tone:'outline' },
                    { title:'子任务完成 1/3', meta:'当前进度 33%', tone:'soft' },
                    { title:'状态更新为 进行中', meta:'2026-06-06 08:37', tone:'solid' }
                ]
            };
        }
        function authHeaders(extra = {}){
            return { Authorization:`Bearer ${rawToken}`, ...extra };
        }
        async function api(path, options = {}){
            const response = await fetch(`${API}${path}`, {
                ...options,
                headers: {
                    ...authHeaders(options.body ? { 'Content-Type':'application/json' } : {}),
                    ...(options.headers || {})
                }
            });
            const payload = await response.json().catch(() => ({ code:-1, msg:'服务器响应异常', data:null }));
            if(!response.ok || payload.code !== 0){
                throw new Error(payload.msg || '操作失败');
            }
            return payload.data;
        }
        function todayKey(){
            const now = new Date();
            const offset = now.getTimezoneOffset();
            const local = new Date(now.getTime() - offset * 60000);
            return local.toISOString().slice(0,10);
        }
        function dueText(task){
            const value = task.due_at || task.due_date;
            if(!value) return '未设置截止时间';
            return String(value).replace('T',' ').slice(0,16);
        }
        function dueState(task){
            const value = task.due_at || task.due_date;
            if(!value || (task.derived_status || task.status) === 'completed') return '';
            const key = String(value).slice(0,10);
            if(key < todayKey()) return 'overdue';
            if(key === todayKey()) return 'today';
            return '';
        }
        function dueStateText(task){
            const state = dueState(task);
            if(state === 'overdue') return '已逾期';
            if(state === 'today') return '今日到期';
            return '排期正常';
        }
        function dueBucket(task){
            const value = task.due_at || task.due_date;
            if(!value) return 'none';
            const state = dueState(task);
            if(state === 'overdue') return 'overdue';
            if(state === 'today') return 'today';
            const due = new Date(String(value).replace(' ', 'T'));
            if(Number.isNaN(due.getTime())) return 'none';
            const diffDays = Math.ceil((due.getTime() - Date.now()) / 86400000);
            if(diffDays <= 7) return 'week';
            return 'later';
        }
        function quickMatches(task, key){
            if(key === 'all') return true;
            if(key === 'high') return (task.priority || 'medium') === 'high';
            if(key === 'mine') return Number(task.assigned_staff_id || 0) === Number(currentUser.id || 0);
            if(key === 'created') return Number(task.created_by_id || 0) === Number(currentUser.id || 0);
            return true;
        }
        function dueUrgencyText(task){
            const state = dueState(task);
            if(state === 'overdue'){
                const due = new Date(String(task.due_at || task.due_date).replace(' ', 'T'));
                const diffHours = Math.max(1, Math.round((Date.now() - due.getTime()) / 3600000));
                return `逾期 ${diffHours} 小时`;
            }
            if(state === 'today'){
                const due = new Date(String(task.due_at || task.due_date).replace(' ', 'T'));
                return `${String(due.getHours()).padStart(2,'0')}:${String(due.getMinutes()).padStart(2,'0')}`;
            }
            return dueText(task).slice(5, 16);
        }
        function taskStatus(task){
            return task.derived_status || task.status || 'pending';
        }
        function taskStatusText(task){
            return statusNames[taskStatus(task)] || taskStatus(task);
        }
        function priorityText(priority){
            return priority === 'high' ? '高优先级' : priority === 'low' ? '低优先级' : '普通优先级';
        }
        function progressPercent(task){
            return Number(task.progress_percent || 0);
        }
        function shortDatetime(value){
            if(!value) return '-';
            return String(value).replace('T',' ').slice(0,16);
        }
        function isLeaf(task){
            return Number(task.subtask_count || 0) === 0;
        }
        function canSelect(task){
            return isLeaf(task) && taskStatus(task) !== 'completed';
        }
        function visibleSearchValue(){
            return '';
        }
        function syncSelectLabel(id){
            const select = document.getElementById(id);
            const label = document.getElementById(`${id}Label`);
            if(!select || !label) return;
            const option = select.options[select.selectedIndex] || select.options[0];
            label.textContent = option ? option.textContent : '';
        }
        function renderSelectOptions(id){
            const select = document.getElementById(id);
            if(!select) return;
            const current = select.value;
            selectOptions.innerHTML = [...select.options].map(option => `
                <button type="button" class="select-option ${option.value === current ? 'active' : ''}" onclick="pickSelectValue('${id}','${encodeURIComponent(option.value)}')">${esc(option.textContent)}</button>
            `).join('');
        }
        function positionSelectPop(trigger){
            const rect = trigger.getBoundingClientRect();
            const popRect = selectPop.getBoundingClientRect();
            let left = Math.min(rect.left, window.innerWidth - popRect.width - 12);
            let top = rect.bottom + 8;
            if(top + popRect.height > window.innerHeight - 12){
                top = Math.max(12, rect.top - popRect.height - 8);
            }
            selectPop.style.left = `${Math.max(12, left)}px`;
            selectPop.style.top = `${Math.max(12, top)}px`;
        }
        function closeSelect(){
            if(activeSelectField){
                document.getElementById(`${activeSelectField}Trigger`)?.classList.remove('open');
            }
            selectPop.classList.remove('show');
            activeSelectField = null;
        }
        function toggleSelect(id){
            const trigger = document.getElementById(`${id}Trigger`);
            if(!trigger) return;
            if(activeSelectField === id && selectPop.classList.contains('show')){
                closeSelect();
                return;
            }
            closeSelect();
            activeSelectField = id;
            renderSelectOptions(id);
            selectPop.classList.add('show');
            trigger.classList.add('open');
            selectPop.style.width = `${trigger.getBoundingClientRect().width}px`;
            requestAnimationFrame(() => positionSelectPop(trigger));
        }
        function pickSelectValue(id, value){
            const select = document.getElementById(id);
            if(!select) return;
            select.value = decodeURIComponent(value);
            syncSelectLabel(id);
            select.dispatchEvent(new Event('change', { bubbles:true }));
            closeSelect();
        }
        function syncCustomSelects(root = document){
            root.querySelectorAll('.native-select[id]').forEach(select => syncSelectLabel(select.id));
        }
        function renderViewTabs(){
            return;
        }
        function sortRows(rows){
            const sorted = [...rows];
            switch(sortFilter.value){
                case 'due_asc':
                    sorted.sort((a,b) => String(a.due_at || a.due_date || '9999').localeCompare(String(b.due_at || b.due_date || '9999')));
                    break;
                case 'due_desc':
                    sorted.sort((a,b) => String(b.due_at || b.due_date || '').localeCompare(String(a.due_at || a.due_date || '')));
                    break;
                case 'priority':
                    sorted.sort((a,b) => ({ high:0, medium:1, low:2 }[a.priority || 'medium'] - { high:0, medium:1, low:2 }[b.priority || 'medium']));
                    break;
                case 'title':
                    sorted.sort((a,b) => String(a.title || '').localeCompare(String(b.title || ''), 'zh-CN'));
                    break;
                default:
                    break;
            }
            return sorted;
        }
        function filteredRows(){
            const search = visibleSearchValue();
            const rows = sortRows(allRows).filter(task => {
                if(currentDueFilter !== 'all' && dueBucket(task) !== currentDueFilter) return false;
                if(!quickMatches(task, currentQuickFilter)) return false;
                if(search){
                    const haystack = [
                        task.title,
                        task.description,
                        task.assigned_staff_name,
                        task.parent_task_title,
                        task.created_by_name
                    ].join(' ').toLowerCase();
                    if(!haystack.includes(search)) return false;
                }
                return true;
            });
            return rows;
        }
        function setCounters(rows){
            return rows;
        }
        function renderSummaryCards(){
            const sourceRows = currentView === 'created' ? createdRowsCache : allRows;
            const pending = countTasks(sourceRows, task => taskStatus(task) !== 'completed');
            const today = countTasks(sourceRows, task => dueBucket(task) === 'today');
            const overdue = countTasks(sourceRows, task => dueBucket(task) === 'overdue');
            if(summaryPending) summaryPending.textContent = pending;
            if(summaryToday) summaryToday.textContent = today;
            if(summaryOverdue) summaryOverdue.textContent = overdue;
            if(summaryCreated) summaryCreated.textContent = createdRowsCache.length;
            summaryCards?.querySelectorAll('[data-summary]').forEach(card => {
                const key = card.dataset.summary;
                const active =
                    (key === 'created' && currentView === 'created') ||
                    (key === 'today' && currentDueFilter === 'today') ||
                    (key === 'overdue' && currentDueFilter === 'overdue') ||
                    (key === 'pending' && currentView !== 'created' && currentDueFilter === 'all');
                card.classList.toggle('active', active);
            });
        }
        function countTasks(rows, predicate){
            return rows.filter(predicate).length;
        }
        function renderChipButton(){
            return '';
        }
        function renderSidebarMeta(){
            return;
        }
        function renderTaskCard(task){
            const selected = selectedTaskIds.has(String(task.id));
            const status = taskStatus(task);
            const dueBadge = dueState(task) ? `<span class="pill">${esc(dueStateText(task))}</span>` : '';
            const parentBadge = task.parent_task_title ? `<span class="pill">总任务 ${esc(cleanDemoText(task.parent_task_title))}</span>` : '';
            const splitBadge = Number(task.subtask_count || 0) ? `<span class="pill">${Number(task.subtask_count || 0)} 项执行</span>` : '';
            const progress = Number(task.subtask_count || 0)
                ? `<div class="progress"><div class="progress-bar"><div class="progress-fill" style="width:${progressPercent(task)}%"></div></div><span>${Number(task.completed_subtask_count || 0)}/${Number(task.subtask_count || 0)} · ${progressPercent(task)}%</span></div>`
                : '';
            return `
                <article class="task-card ${selectedTaskId === task.id ? 'active' : ''}" onclick="openTask(${Number(task.id)})">
                    <div class="task-card-top">
                        ${canSelect(task) ? `<button type="button" class="pick ${selected ? 'active' : ''}" onclick="event.stopPropagation();toggleSelection(${Number(task.id)})">${selected ? '✓' : ''}</button>` : `<span class="pick" style="visibility:hidden"></span>`}
                        <div style="min-width:0;flex:1">
                            <strong>${esc(cleanDemoText(task.title || '待办任务'))}</strong>
                            <small>${esc(dueText(task))}${task.assigned_staff_name ? ` · ${esc(task.assigned_staff_name)}` : ''}</small>
                        </div>
                    </div>
                    <div class="task-meta">
                        <span class="status ${status}">${esc(taskStatusText(task))}</span>
                        ${dueBadge}
                        <span class="pill">${esc(categoryNames[task.category] || '其他')}</span>
                        <span class="pill">${esc(priorityText(task.priority))}</span>
                        ${parentBadge}
                        ${splitBadge}
                    </div>
                    ${progress}
                </article>
            `;
        }
        function renderRail(){
            return;
        }
        function renderBoardCard(task, featured = false){
            const selected = selectedTaskIds.has(String(task.id));
            const dueBadge = dueState(task) ? `<span class="pill">${esc(dueStateText(task))}</span>` : '';
            return `
                <article class="board-card ${featured ? 'board-card-feature' : ''} ${selectedTaskId === task.id ? 'active' : ''}" draggable="${canSelect(task)}" ondragstart="handleDragStart(event,${Number(task.id)})" ondragend="handleDragEnd(event)" onclick="openTask(${Number(task.id)})" oncontextmenu="showCtxMenu(event,${Number(task.id)});return false">
                    <div class="board-card-top">
                        ${canSelect(task) ? `<button type="button" class="pick ${selected ? 'active' : ''}" onclick="event.stopPropagation();toggleSelection(${Number(task.id)})">${selected ? '✓' : ''}</button>` : `<span class="pick" style="visibility:hidden"></span>`}
