            display:none;
        }
        .detail-editor-wrap.show{
            display:block;
        }
        .status-actions{
            display:grid;
            grid-template-columns:repeat(3,minmax(0,1fr));
            gap:8px;
        }
        .status-actions button{
            height:40px;
            border:1px solid rgba(154,186,215,.22);
            border-radius:15px;
            background:#fff;
            color:#5f7d98;
            font-size:12px;
            font-weight:900;
        }
        .status-actions button:hover{
            border-color:var(--primary);
            color:var(--primary);
        }
        .detail-children{display:grid;gap:8px}
        .child-row{
            padding:12px;
            border-radius:18px;
            background:#fff;
            border:1px solid rgba(154,186,215,.14);
        }
        .child-row strong{
            display:block;
            font-size:13px;
            line-height:1.5;
        }
        .child-row small{
            display:block;
            margin-top:5px;
            color:var(--text-soft);
            font-size:11px;
            line-height:1.6;
        }
        .child-row .task-meta{margin-top:8px}
        .field{display:grid;gap:6px}
        .field label{
            color:#7894ac;
            font-size:11px;
            font-weight:800;
        }
        .detail-form,.subtasks{
            display:grid;
            gap:14px;
        }
        .composer-form{
            display:grid;
            grid-template-columns:minmax(0,1.55fr) minmax(300px,.9fr);
            align-items:start;
            gap:12px;
        }
        .detail-grid,.composer-grid{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:12px;
        }
        .wide{grid-column:1 / -1}
        .form-actions{
            display:flex;
            justify-content:flex-end;
            gap:8px;
            flex-wrap:wrap;
            position:sticky;
            bottom:0;
            padding:16px 0 0;
            margin-top:4px;
            background:linear-gradient(180deg,rgba(245,249,255,0),rgba(245,249,255,.96) 26%,rgba(245,249,255,.98));
        }
        .composer-form .form-actions{
            grid-column:1 / -1;
            position:static;
            padding:6px 0 0;
            margin:0;
            background:transparent;
        }
        .split-toggle{
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap:12px;
            padding:16px;
            border:1px solid rgba(154,186,215,.2);
            border-radius:20px;
            background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(244,249,255,.9));
        }
        .composer-form .split-toggle{
            align-items:center;
            padding:12px;
            border-radius:16px;
        }
        .split-toggle strong{
            display:block;
            font-size:15px;
        }
        .split-toggle span{
            display:block;
            margin-top:4px;
            color:var(--text-soft);
            font-size:11px;
            line-height:1.6;
        }
        .split-toggle input{
            width:22px;
            height:22px;
            accent-color:var(--primary);
            margin-top:3px;
        }
        .subtask-item{
            padding:14px;
            border:1px solid rgba(154,186,215,.18);
            border-radius:20px;
            background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(246,250,255,.9));
            display:grid;
            gap:10px;
        }
        .composer-form .subtask-item{
            padding:10px;
            border-radius:16px;
            gap:8px;
        }
        .subtask-item-head{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
        }
        .subtask-item-head strong{font-size:13px}
        .subtask-grid{
            display:grid;
            grid-template-columns:1.2fr 1fr 1fr;
            gap:10px;
        }
        .composer-form .subtasks{
            max-height:238px;
            overflow:auto;
            padding-right:2px;
        }
        .composer-form .subtask-grid{
            grid-template-columns:1fr;
            gap:8px;
        }
        /* Modal overlay */
        .compose-overlay{
            display:none;
            position:fixed;
            z-index:999;
            inset:0;
            background:rgba(15,23,50,.45);
            backdrop-filter:blur(6px);
            -webkit-backdrop-filter:blur(6px);
        }
        .show-compose .compose-overlay{
            display:block;
            animation:composeOverlayIn .28s ease both;
        }
        @keyframes composeOverlayIn{ from{opacity:0} to{opacity:1} }
        /* Modal wrapper: centered flex scroll */
        .compose-wrap{
            display:none;
            position:fixed;
            z-index:1000;
            inset:0;
            overflow-y:auto;
            overscroll-behavior:contain;
            padding:24px 18px;
        }
        .show-compose .compose-wrap{
            display:flex;
            flex-direction:column;
            align-items:center;
            justify-content:center;
        }
        /* Modal header bar */
        .compose-banner{
            display:none;
            position:relative;
            max-width:1060px;
            width:100%;
            align-items:center;
            justify-content:space-between;
            gap:18px;
            padding:18px 18px;
            border-radius:24px 24px 0 0;
            background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(243,248,255,.88));
            backdrop-filter:blur(12px);
            -webkit-backdrop-filter:blur(12px);
            border:1px solid rgba(255,255,255,.92);
            border-bottom:1px solid rgba(154,186,215,.14);
            animation:composeModalIn .38s cubic-bezier(.34,1.56,.64,1) both;
            overflow:hidden;
        }
        .show-compose .compose-banner{display:flex}
        .compose-banner::after{
            content:"";
            position:absolute;
            right:-22px;
            top:-28px;
            width:180px;
            height:180px;
            border-radius:50%;
            background:radial-gradient(circle, rgba(38,126,217,.22), transparent 66%);
            pointer-events:none;
        }
        /* Close X button */
        .compose-close{
            flex-shrink:0;
            width:38px;
            height:38px;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            border-radius:50%;
            border:1px solid rgba(154,186,215,.28);
            background:rgba(255,255,255,.86);
            color:var(--text-soft);
            font-size:18px;
            cursor:pointer;
            transition:.18s ease;
            text-decoration:none;
            line-height:1;
            margin-top:0;
            position:relative;
            z-index:1;
        }
        .compose-close:hover{
            background:#eef4ff;
            color:var(--text);
            border-color:rgba(74,144,226,.4);
        }
        .compose-banner-copy{
            min-width:0;
            flex:1;
            display:flex;
            align-items:center;
            gap:14px;
            position:relative;
            z-index:1;
        }
        .compose-banner-icon{
            width:52px;
            height:52px;
            border-radius:16px;
            display:flex;
            align-items:center;
            justify-content:center;
            background:linear-gradient(135deg,var(--primary),#48a7ee);
            color:#fff;
            flex-shrink:0;
            box-shadow:0 14px 28px rgba(38,126,217,.32);
            position:relative;
        }
        .compose-banner-icon::after{
            content:"";
            position:absolute;
            inset:auto -6px -6px auto;
            width:14px;
            height:14px;
            border-radius:50%;
            background:var(--green);
            border:2px solid #fff;
        }
        .compose-banner-icon svg{
            width:26px;
            height:26px;
            display:block;
        }
        .compose-banner-text{
            min-width:0;
            display:flex;
            flex-direction:column;
            gap:3px;
        }
        .compose-kicker{
            display:inline-flex;
            align-items:center;
            gap:5px;
            padding:3px 10px;
            border-radius:999px;
            background:var(--primary-soft);
            color:#1f5ea7;
            font-size:10px;
            font-weight:900;
            letter-spacing:.08em;
            text-transform:uppercase;
            align-self:flex-start;
        }
        .compose-kicker::before{
            content:"";
            width:5px;
            height:5px;
            border-radius:50%;
            background:#267ed9;
        }
        .compose-banner strong{
            display:block;
            font-size:22px;
            font-weight:900;
            color:var(--text);
            line-height:1.1;
        }
        .compose-banner span{
            color:var(--text-soft);
            font-size:12px;
            line-height:1.5;
            max-width:520px;
        }
        .compose-badges{
            display:flex;
            align-items:center;
            gap:8px;
            margin:0;
            position:relative;
            z-index:1;
        }
        .compose-step-chip{
            --chip-accent:#267ed9;
            --chip-soft:rgba(38,126,217,.14);
            display:inline-flex;
            align-items:center;
            gap:8px;
            min-height:42px;
            padding:0 12px 0 8px;
            border-radius:14px;
            background:rgba(255,255,255,.82);
            border:1px solid rgba(154,186,215,.22);
            color:var(--text-soft);
            font-size:12px;
            font-weight:800;
            line-height:1;
            transition:.22s ease;
            position:relative;
        }
        .compose-step-chip .chip-num{
            width:26px;
            height:26px;
            border-radius:9px;
            display:inline-flex;
            align-items:center;
            justify-content:center;
            background:var(--chip-soft);
            color:var(--chip-accent);
            font-size:11px;
            font-weight:900;
            transition:.22s ease;
        }
        .compose-step-chip.is-active{
            background:linear-gradient(180deg,rgba(255,255,255,.96),var(--chip-soft));
            border-color:var(--chip-accent);
            color:var(--text);
            box-shadow:0 12px 24px var(--chip-soft);
        }
        .compose-step-chip.is-active .chip-num{
            background:var(--chip-accent);
            color:#fff;
        }
        .compose-step-chip.is-done{
            --chip-accent:#28a36a;
            --chip-soft:rgba(40,163,106,.16);
            color:#1c7a4f;
        }
        .compose-step-chip.is-done .chip-num::before{
            content:"\2713";
        }
        .compose-step-chip.is-done .chip-num{
            font-size:0;
        }
        .compose-step-chip.is-done .chip-num::after{
            content:attr(data-num);
            font-size:11px;
        }
        .compose-step-arrow{
            color:rgba(154,186,215,.5);
            font-size:14px;
            line-height:1;
            user-select:none;
        }
        .compose-card{
            max-width:1060px;
            width:100%;
            padding:16px 18px 18px;
            border:1px solid rgba(255,255,255,.92);
            border-top:0;
            border-radius:0 0 24px 24px;
            background:linear-gradient(180deg,rgba(252,254,255,.96),rgba(245,249,255,.92));
            backdrop-filter:blur(12px);
            -webkit-backdrop-filter:blur(12px);
            box-shadow:0 24px 70px rgba(20,36,90,.16),0 4px 16px rgba(0,0,0,.05);
            animation:composeModalIn .38s cubic-bezier(.34,1.56,.64,1) .06s both;
            max-height:calc(100vh - 106px);
            overflow:auto;
        }
        @keyframes composeModalIn{
            from{opacity:0;transform:translateY(28px) scale(.94)}
            to{opacity:1;transform:translateY(0) scale(1)}
        }
        .compose-section{
            padding:14px;
            border:1px solid rgba(154,186,215,.2);
            border-radius:18px;
            background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(248,251,255,.82));
            box-shadow:0 10px 24px rgba(61,104,145,.05);
        }
        .composer-form > .compose-section:first-child{
            grid-row:span 2;
        }
        .compose-section + .compose-section{margin-top:0}
        .compose-section-head{
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap:14px;
            margin-bottom:10px;
        }
        .compose-step{
            display:inline-flex;
            align-items:center;
            min-height:22px;
            padding:0 8px;
            border-radius:999px;
            background:#eef5ff;
            color:#2f77c8;
            font-size:9px;
            font-weight:900;
            letter-spacing:.08em;
            text-transform:uppercase;
        }
        .compose-section h3{
            font-size:14px;
            font-weight:900;
            margin-top:6px;
            margin-bottom:0;
        }
        .compose-section p{
            color:var(--text-soft);
            font-size:11px;
            line-height:1.45;
            margin-top:4px;
            margin-bottom:0;
        }
        .composer-form .input{
            min-height:40px;
            border-radius:14px;
        }
        .composer-form .textarea{
            min-height:92px;
            border-radius:14px;
        }
        .composer-form .field{
            gap:5px;
        }
        .composer-form .field label{
            font-size:10px;
        }
        .hint{
            padding:10px 12px;
            border-radius:14px;
            background:#f3f9ff;
            color:#64829d;
            font-size:11px;
            line-height:1.5;
        }
        .hidden{display:none !important}
        .select-pop{
            position:fixed;
            z-index:1300;
            min-width:220px;
            max-width:320px;
            max-height:360px;
            overflow-y:auto;
            background:#fff;
            border:1px solid rgba(214,233,255,.95);
            border-radius:18px;
            box-shadow:0 20px 50px rgba(29,43,90,.18);
            padding:10px;
            display:none;
        }
        .select-pop.show{display:block}
        .select-options{
            display:flex;
            flex-direction:column;
            gap:6px;
        }
        .select-option{
            border:0;
            background:#fff;
            border-radius:12px;
            padding:10px 12px;
            text-align:left;
            color:#14245a;
            font-size:13px;
            font-weight:800;
            cursor:pointer;
            transition:.15s;
        }
        .select-option:hover{background:#eef6ff}
        .select-option.active{background:linear-gradient(135deg,#4a90e2,#65b3ff);color:#fff}
        @media (max-width:1380px){
            .workspace{grid-template-columns:1fr}
            .detail-panel{grid-column:1 / -1}
        }
        @media (max-width:980px){
            :root{
                --shell-offset:12px;
                --workspace-height:auto;
                --board-empty-height:auto;
                --board-empty-compact-height:auto;
            }
            .page{width:min(100% - 12px,980px);padding:12px;margin:6px auto;border-radius:24px}
            .topbar{grid-template-columns:1fr;gap:10px}
            .brand{min-width:0;width:100%;padding-left:2px;gap:12px;flex-wrap:wrap}
            .brand-copy{padding-right:0;border-right:0}
            .summary{grid-template-columns:repeat(2,minmax(0,1fr))}
            .workspace{grid-template-columns:1fr}
            .main-panel,.detail-panel,#mainCanvas{display:block}
            .board{grid-template-columns:1fr}
            .table-head,.table-row{grid-template-columns:1fr}
            .composer-form{grid-template-columns:1fr}
            .composer-form > .compose-section:first-child{grid-row:auto}
            .compose-wrap{padding:12px}
            .compose-banner,.compose-card{max-width:100%}
            .compose-card{max-height:calc(100vh - 92px)}
            .detail-grid,.composer-grid,.subtask-grid,.filter-grid,.quick-strip,.status-actions,.detail-summary-grid{grid-template-columns:1fr}
            .actions{justify-content:flex-start}
            .compose-banner{flex-wrap:wrap;padding:14px}
            .compose-badges{order:3;width:100%;justify-content:center;flex-wrap:wrap}
            .compose-step-chip{min-height:36px;font-size:11px}
        }
        .ctx-menu{
            display:none;
            position:fixed;
            z-index:10000;
            min-width:160px;
            padding:6px;
            border:1px solid rgba(161,191,219,.24);
            border-radius:14px;
            background:rgba(255,255,255,.96);
            backdrop-filter:blur(18px);
            box-shadow:0 12px 40px rgba(62,101,142,.18);
        }
        .ctx-menu.show{display:block}
        .ctx-item{
            display:flex;
            align-items:center;
            gap:8px;
            width:100%;
            padding:9px 14px;
            border:0;
            border-radius:10px;
            background:transparent;
            color:var(--text);
            font-size:13px;
            font-weight:700;
            text-align:left;
            cursor:pointer;
            transition:background .12s;
        }
        .ctx-item:hover{background:var(--primary-soft);color:var(--primary)}
        .ctx-danger{color:var(--red)}
        .ctx-danger:hover{background:rgba(216,93,105,.1);color:var(--red)}
        .ctx-divider{
            height:1px;
            margin:4px 8px;
            background:var(--line);
        }
    </style>
</head>
<body>
    <main class="page" id="pageRoot">
        <div class="topbar">
            <div class="brand">
                <div class="brand-page">
                    <strong>个人待办</strong>
                </div>
            </div>
            <section class="summary" id="summaryCards">
                <button class="summary-card pending active" type="button" data-summary="pending">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="16" rx="3"/>
                            <path d="M8 2v4M16 2v4M3 10h18"/>
                            <path d="M8 15h3M8 18h6" stroke-width="1.6"/>
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <strong id="summaryPending">0</strong>
                        <span>待处理</span>
                    </span>
                </button>
                <button class="summary-card warn" type="button" data-summary="today">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9"/>
                            <polyline points="12 7 12 12 15.5 14"/>
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <strong id="summaryToday">0</strong>
                        <span>今日到期</span>
                    </span>
                </button>
                <button class="summary-card danger" type="button" data-summary="overdue">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3l9 16H3z"/>
                            <line x1="12" y1="10" x2="12" y2="14"/>
                            <circle cx="12" cy="17.2" r="0.9" fill="currentColor" stroke="none"/>
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <strong id="summaryOverdue">0</strong>
                        <span>已逾期</span>
                    </span>
                </button>
                <button class="summary-card good" type="button" data-summary="created">
                    <span class="summary-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="3.6"/>
                            <path d="M5 20c1.2-3.4 4-5 7-5s5.8 1.6 7 5"/>
                            <path d="M16 4l2 2 3-3" stroke-width="1.8"/>
                        </svg>
                    </span>
                    <span class="summary-copy">
                        <strong id="summaryCreated">0</strong>
                        <span>我分派的</span>
                    </span>
                </button>
            </section>
            <div class="actions">
                <a class="btn-primary" id="composeLink" href="javascript:void(0)" onclick="showCompose()">＋ 新建任务</a>
                <a class="btn-ghost" href="message-center.html">◔ 消息中心</a>
                <a class="btn-ghost" href="dashboard.html">↩ 返回仪表盘</a>
            </div>
        </div>

        <section class="workspace">
            <section class="panel main-panel">
                <div class="canvas-head">
                    <div>
                        <strong>任务看板</strong>
                        <span>拖拽任务到不同阶段，直观看见推进节奏。</span>
                    </div>
                    <div class="canvas-head-tools">
                        <div class="toolbar">
                            <div class="select-field" style="width:140px">
                                <button type="button" class="input select-trigger" id="sortFilterTrigger" onclick="toggleSelect('sortFilter')"><span id="sortFilterLabel">默认排序</span></button>
                                <select class="native-select" id="sortFilter">
                                    <option value="default">默认排序</option>
                                    <option value="due_asc">截止时间升序</option>
                                    <option value="due_desc">截止时间降序</option>
                                    <option value="priority">优先级优先</option>
                                    <option value="title">标题排序</option>
                                </select>
                            </div>
                            <button type="button" class="board-tool" id="selectVisibleBtn">选择当前列表</button>
                            <button type="button" class="board-tool" id="clearFocusBtn">清空选中</button>
                        </div>
                        <div class="display-switch">
                            <button type="button" class="active" data-display="board"><span>▣ 看板</span></button>
                            <button type="button" data-display="table"><span>☰ 列表</span></button>
                        </div>
                    </div>
                </div>
                <div class="bulk-bar" id="bulkBar">
                    <span class="bulk-label" id="bulkLabel">已选 0 项</span>
                    <button type="button" class="btn-primary" data-bulk-status="completed">批量完成</button>
                    <button type="button" class="btn" data-bulk-status="in_progress">批量进行中</button>
                    <button type="button" class="btn" data-bulk-status="pending">批量待处理</button>
                    <button type="button" class="btn-ghost" id="clearSelectionBtn">取消选择</button>
                </div>
                <div id="mainCanvas">
                    <div class="empty">正在加载任务...</div>
                </div>
            </section>

            <aside class="panel detail-panel">
                <div class="panel-head">
                    <div>
                        <strong>响应面板</strong>
                        <span>右侧按“预警、判断、处理”来展开，适合盯紧今日到期、逾期和多人协同任务。</span>
                    </div>
                </div>
                <div class="detail-shell" id="detailShell">
                    <div class="detail-empty">
                        <strong>还没有选中任务</strong>
                        点左侧任务卡片或中间看板卡片，这里就会显示任务详情、状态操作和编辑区域。
                    </div>
                </div>
            </aside>
        </section>
    </main>
    <section class="compose-wrap">
        <div class="compose-banner">
            <div class="compose-banner-copy">
                <span class="compose-banner-icon" aria-hidden="true">
